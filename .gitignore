# 微信开发者工具本地配置
.project
.idea
*.local.json
*.log

# 云开发本地缓存
cloudfunctions/**/node_modules/
cloudfunctions/**/package-lock.json
cloudfunctions/**/.env

# 云函数公共模块副本（由 sync-common.sh 自动生成，唯一源码在 cloudfunctions/common/）
cloudfunctions/*/common/
!cloudfunctions/common/

# 依赖目录（如果本地有 npm 包）
node_modules/
miniprogram_npm/

# 环境变量文件
.env
.env.production
.env.development

# 服务端密钥（包含真实密钥，不提交）
cloudfunctions/common/secrets.js

# 系统文件
.DS_Store
Thumbs.db

# 测试和临时文件
*.tmp
*.swp
*.swo
*~

# 根目录调试/临时文件
__*.js
__*.txt
fix_*.py

# 日志文件
*.log
npm-debug.log*

# 打包/构建产物（如果有）
dist/
build/

# 敏感信息（微信 AppID 等不要提交）
project.config.json   # 可选，但建议保留通用配置，去掉敏感字段

# API 密钥文件（含真实 API 密钥，绝不提交）
.deploy-keys.txt

# 数据库初始化/查询脚本（含明文 admin_secret、token_secret，绝不提交）
tcb_query.json

# CloudBase CLI 部署配置（含 envId、商户私钥/APIv3密钥等，本地部署用，绝不提交）
cloudbaserc.json
cloudbaserc-pay-integration.json
cloudbaserc.json.bak

# Claude AI 工作目录（含本地工具配置）
.claude/

# 微信小程序特有的临时文件
.spec-workflow/
*.backup
guide-ios.wxss

# 测试存档临时文件
test_archive/temp_*
test_archive/*.zip

# 自动生成的备份文件
miniprogram/app_new.js
