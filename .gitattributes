# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly declare text files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
