/* 宠物档案页面样式 - 强制刷新版本 */

/* === 强制删除按钮样式 === */
.delete-force-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
  transition: all 0.2s ease;
  cursor: pointer;
  user-select: none;
}

.delete-force-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(255, 107, 107, 0.3);
}

/* 原有样式保持不变... */
.profile-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 120rpx;
}

.profile-header {
  padding: 40rpx 32rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  font-size: 48rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.stats-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stats-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.pets-container {
  padding: 0 32rpx;
}

.pet-card-modern {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.pet-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.pet-avatar-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE5E5 0%, #E5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pet-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pet-avatar-large {
  font-size: 40rpx;
}

.pet-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.cat-badge {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFD1E5 100%);
  color: #FF6B9D;
}

.dog-badge {
  background: linear-gradient(135deg, #E5F3FF 0%, #D1E9FF 100%);
  color: #5B9BD5;
}

.pet-main-info {
  flex: 1;
  margin-left: 16rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pet-name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.pet-gender-badge {
  padding: 2rpx 8rpx;
  background: #F0F2F5;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #666666;
}

.pet-basic-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.info-tag {
  font-size: 24rpx;
  color: #666666;
  background: #F0F2F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.info-separator {
  font-size: 24rpx;
  color: #CCCCCC;
  margin: 0 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666666;
}

.pet-card-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-circle-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F2F5;
  transition: all 0.2s ease;
}

.edit-circle {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.action-icon {
  font-size: 24rpx;
}

.pet-health-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.health-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #F8F9FA;
}

.health-valid {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.health-expired {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.health-icon {
  font-size: 24rpx;
}

.health-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.health-label {
  font-size: 20rpx;
  color: #666666;
}

.health-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

.pet-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.footer-left {
  flex: 1;
}

.update-time {
  font-size: 20rpx;
  color: #999999;
}

.footer-right {
  display: flex;
  gap: 12rpx;
}

.empty-state-modern {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-illustration {
  margin-bottom: 32rpx;
}

.empty-circle-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.empty-emoji-large {
  font-size: 80rpx;
}

.empty-content {
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.empty-description {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.empty-features {
  display: flex;
  gap: 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  font-size: 32rpx;
}

.feature-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.floating-add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.add-btn-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.add-icon-large {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.add-label {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.modal-show {
  opacity: 1;
  pointer-events: auto;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10rpx);
}

.modal-container-modern {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header-modern {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.modal-header-content {
  flex: 1;
}

.modal-title-modern {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.modal-subtitle-modern {
  display: block;
  font-size: 24rpx;
  color: #666666;
}

.modal-close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 24rpx;
  color: #666666;
}

.modal-scroll-content {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.form-section-modern {
  margin-bottom: 32rpx;
}

.section-title-modern {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 24rpx;
}

.section-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.form-group-modern {
  margin-bottom: 20rpx;
}

.form-label-modern {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 24rpx;
  color: #333333;
}

.label-required {
  color: #FF6B6B;
  margin-left: 4rpx;
}

.form-input-modern {
  width: 100%;
  padding: 16rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #FAFAFA;
  color: #333333;
}

.placeholder-text {
  color: #999999;
}

.type-selector-modern {
  display: flex;
  gap: 16rpx;
}

.type-card-modern {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.type-active {
  border-color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
}

.type-emoji {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  display: block;
  font-size: 24rpx;
  color: #333333;
}

.form-row-modern {
  display: flex;
  gap: 16rpx;
}

.form-half {
  flex: 1;
}

.gender-selector-modern {
  display: flex;
  gap: 12rpx;
}

.gender-option {
  flex: 1;
  padding: 12rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.gender-active {
  border-color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
}

.gender-icon {
  font-size: 24rpx;
}

.gender-text {
  font-size: 24rpx;
  color: #333333;
}

.picker-input-modern {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  background: #FAFAFA;
  color: #333333;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-selected {
  border-color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
}

.avatar-upload-container {
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.avatar-preview-section {
  margin-bottom: 20rpx;
}

.avatar-preview-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  overflow: hidden;
}

.avatar-preview-image {
  width: 100%;
  height: 100%;
}

.avatar-preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-overlay-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.placeholder-icon {
  font-size: 48rpx;
}

.avatar-placeholder-text {
  font-size: 24rpx;
  color: #999999;
}

.avatar-actions-section {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.avatar-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #F0F2F5;
  border: none;
}

.upload-btn {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
}

.delete-btn {
  background: #FFEBEE;
  color: #FF6B6B;
}

.avatar-action-btn::after {
  border: none;
}

.avatar-tips {
  margin-top: 12rpx;
  text-align: center;
}

.tips-text {
  font-size: 20rpx;
  color: #999999;
}

.modal-footer-modern {
  padding: 32rpx;
  border-top: 1rpx solid #F0F2F5;
}

.modal-btn-group {
  display: flex;
  gap: 16rpx;
}

.modal-btn-modern {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
}

.modal-cancel {
  background: #F0F2F5;
  color: #666666;
}

.modal-confirm {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
}

.modal-btn-text {
  font-size: 28rpx;
  font-weight: 500;
}