/* 宠物档案页面样式 - 强制刷新版本 */

@import "pet-modal.wxss";
@import "record-modal.wxss";

/* === 强制删除按钮样式 === */
.delete-force-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: var(--brand-emergency);
  border-radius: 8rpx;
  color: var(--bg-card);
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
  transition: all 0.2s ease;
  cursor: pointer;
  user-select: none;
}

.delete-force-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(255, 77, 79, 0.3);
}

/* 原有样式保持不变... */
.profile-page {
  min-height: 100vh;
  background: var(--brand-primary);
  padding-bottom: 120rpx;
}

.profile-header {
  padding: 40rpx 32rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  width: 32rpx;
  height: 32rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--bg-card);
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}

.stats-number {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--bg-card);
}

.stats-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.pets-container {
  padding: 0 32rpx;
}

.pet-card-modern {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.pet-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.pet-avatar-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pet-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pet-avatar-large {
  font-size: 40rpx;
}

.pet-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.cat-badge {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.dog-badge {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.pet-main-info {
  flex: 1;
  margin-left: 16rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pet-name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.pet-gender-badge {
  padding: 2rpx 8rpx;
  background: var(--bg-secondary);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
}

.pet-basic-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.info-tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-secondary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.info-separator {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin: 0 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.pet-card-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-circle-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  transition: all 0.2s ease;
}

.edit-circle {
  background: var(--brand-primary);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.action-icon {
  width: 24rpx;
  height: 24rpx;
}

.pet-health-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.health-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--bg-secondary);
}

.health-valid {
  background: var(--color-success);
  opacity: 0.15;
}

.health-expired {
  background: var(--color-warning);
  opacity: 0.15;
}

.health-icon {
  width: 24rpx;
  height: 24rpx;
}

.health-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.health-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.health-date {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.pet-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.footer-left {
  flex: 1;
}

.update-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.footer-right {
  display: flex;
  gap: 12rpx;
}

.empty-state-modern {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-illustration {
  margin-bottom: 32rpx;
}

.empty-circle-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--brand-primary-light);
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-emoji-large {
  font-size: 80rpx;
}

.empty-content {
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--bg-card);
  margin-bottom: 8rpx;
}

.empty-description {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.empty-features {
  display: flex;
  gap: 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  font-size: 32rpx;
}

.feature-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.floating-add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.add-btn-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.add-icon-large {
  font-size: 40rpx;
  color: var(--bg-card);
  font-weight: 300;
}

.add-label {
  font-size: 20rpx;
  color: var(--bg-card);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* === 自查记录 & 健康报告入口 === */
.pet-records-section {
  margin: 16rpx 0;
  border-top: 1rpx solid var(--border-color);
  padding-top: 8rpx;
}

.record-entry {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
  transition: background 0.2s;
}

.record-entry:active {
  background: var(--bg-secondary);
}

.record-entry-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
}

.record-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.record-count-badge {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--bg-secondary);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}

.record-entry-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* 快速自查入口高亮 */
.quick-check-entry {
  background: var(--color-success);
  opacity: 0.15;
  border: 2rpx solid var(--color-success);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.quick-check-entry:active {
  background: var(--color-success);
  opacity: 0.25;
}

.quick-check-text {
  color: var(--color-success);
  font-weight: 600;
}
