/* 宠物档案页面样式 - 强制刷新版本 */

@import "pet-modal.wxss";
@import "record-modal.wxss";

/* === 强制删除按钮样式 === */
.delete-force-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
  transition: all 0.2s ease;
  cursor: pointer;
  user-select: none;
}

.delete-force-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(255, 107, 107, 0.3);
}

/* 原有样式保持不变... */
.profile-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 120rpx;
}

.profile-header {
  padding: 40rpx 32rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  font-size: 48rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.stats-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stats-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.pets-container {
  padding: 0 32rpx;
}

.pet-card-modern {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.pet-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.pet-avatar-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE5E5 0%, #E5F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pet-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pet-avatar-large {
  font-size: 40rpx;
}

.pet-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.cat-badge {
  background: linear-gradient(135deg, #FFE5E5 0%, #FFD1E5 100%);
  color: #FF6B9D;
}

.dog-badge {
  background: linear-gradient(135deg, #E5F3FF 0%, #D1E9FF 100%);
  color: #5B9BD5;
}

.pet-main-info {
  flex: 1;
  margin-left: 16rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pet-name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.pet-gender-badge {
  padding: 2rpx 8rpx;
  background: #F0F2F5;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #666666;
}

.pet-basic-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.info-tag {
  font-size: 24rpx;
  color: #666666;
  background: #F0F2F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.info-separator {
  font-size: 24rpx;
  color: #CCCCCC;
  margin: 0 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666666;
}

.pet-card-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-circle-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F2F5;
  transition: all 0.2s ease;
}

.edit-circle {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.action-icon {
  font-size: 24rpx;
}

.pet-health-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.health-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #F8F9FA;
}

.health-valid {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.health-expired {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.health-icon {
  font-size: 24rpx;
}

.health-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.health-label {
  font-size: 20rpx;
  color: #666666;
}

.health-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

.pet-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.footer-left {
  flex: 1;
}

.update-time {
  font-size: 20rpx;
  color: #999999;
}

.footer-right {
  display: flex;
  gap: 12rpx;
}

.empty-state-modern {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-illustration {
  margin-bottom: 32rpx;
}

.empty-circle-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.empty-emoji-large {
  font-size: 80rpx;
}

.empty-content {
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.empty-description {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.empty-features {
  display: flex;
  gap: 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  font-size: 32rpx;
}

.feature-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.floating-add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.add-btn-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.add-icon-large {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.add-label {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

/* === 自查记录 & 健康报告入口 === */
.pet-records-section {
  margin: 16rpx 0;
  border-top: 1rpx solid #F0F2F5;
  padding-top: 8rpx;
}

.record-entry {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
  transition: background 0.2s;
}

.record-entry:active {
  background: #F5F6FA;
}

.record-entry-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.record-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.record-count-badge {
  font-size: 22rpx;
  color: #999999;
  background: #F0F2F5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}

.record-entry-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 快速自查入口高亮 */
.quick-check-entry {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  border: 2rpx solid #A5D6A7;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.quick-check-entry:active {
  background: linear-gradient(135deg, #C8E6C9 0%, #DCEDC8 100%);
}

.quick-check-text {
  color: #2E7D32;
  font-weight: 600;
}
