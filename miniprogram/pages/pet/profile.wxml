<!--现代化宠物档案页面 - 强制刷新版本-->
<view class="profile-page">

  <!-- 顶部标题区域 -->
  <view class="profile-header">
    <view class="header-content">
      <view class="header-left">
        <image class="header-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="宠物档案" />
        <view class="header-text">
          <text class="header-title">宠物档案</text>
          <text class="header-subtitle">管理爱宠信息，记录健康状态</text>
        </view>
      </view>
      <view class="header-stats">
        <text class="stats-number">{{petList.length}}</text>
        <text class="stats-label">只宠物</text>
      </view>
    </view>
  </view>

  <!-- 宠物卡片列表 -->
  <view class="pets-container" wx:if="{{petList.length > 0}}">
    <view class="pet-card-modern" wx:for="{{petList}}" wx:key="petId" aria-label="宠物卡片">
      <!-- 卡片头部 -->
      <view class="pet-card-header">
        <view class="pet-avatar-section">
          <view class="pet-avatar-circle">
            <!-- 真实头像或默认头像 -->
            <image wx:if="{{item.avatar}}" class="pet-avatar-image" src="{{item.avatar}}" mode="aspectFill"/>
            <view wx:else class="pet-avatar-large">
              <image class="pet-avatar-fallback-icon" src="/images/icons/paw.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="pet-type-badge {{item.type === 'cat' ? 'cat-badge' : 'dog-badge'}}">
            {{item.type === 'cat' ? '猫咪' : '狗狗'}}
          </view>
        </view>
        <view class="pet-main-info">
          <view class="pet-name-row">
            <text class="pet-name-text">{{item.name}}</text>
            <view class="pet-gender-badge">{{item.gender === 'male' ? '♂' : '♀'}}</view>
          </view>
          <view class="pet-basic-info">
            <text class="info-tag">{{item.breed || '未知品种'}}</text>
            <text class="info-separator">·</text>
            <text class="info-text">{{item.age}}个月</text>
            <text class="info-separator" wx:if="{{item.weight}}">·</text>
            <text class="info-text" wx:if="{{item.weight}}">{{item.weight}}kg</text>
          </view>
        </view>
        <view class="pet-card-actions">
          <view class="action-circle-btn edit-circle" data-pet-id="{{item._id || item.petId}}" bindtap="editPet">
            <image class="action-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="编辑" />
          </view>
        </view>
      </view>

      <!-- 健康状态区域 -->
      <view class="pet-health-section">
        <view class="health-item {{item.vaccineDate ? 'health-valid' : 'health-expired'}}">
          <image class="health-icon" src="{{item.vaccineDate ? '/images/icons/pill.svg' : '/images/icons/warning.svg'}}" mode="aspectFit" />
          <view class="health-info">
            <text class="health-label">疫苗状态</text>
            <text class="health-date">{{item.vaccineDate || '未接种'}}</text>
          </view>
        </view>
        <view class="health-item {{item.dewormDate ? 'health-valid' : 'health-expired'}}">
          <image class="health-icon" src="{{item.dewormDate ? '/images/icons/pill.svg' : '/images/icons/warning.svg'}}" mode="aspectFit" />
          <view class="health-info">
            <text class="health-label">驱虫状态</text>
            <text class="health-date">{{item.dewormDate || '未驱虫'}}</text>
          </view>
        </view>
      </view>

      <!-- 自查记录 & 健康报告入口 -->
      <view class="pet-records-section">
        <view class="record-entry quick-check-entry" bindtap="quickCheck" data-pet-id="{{item._id}}" data-pet-name="{{item.name}}">
          <image class="record-entry-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" />
          <text class="record-entry-text quick-check-text">快速自查</text>
          <text class="record-entry-arrow">›</text>
        </view>
        <view class="record-entry" bindtap="showPetRecords" data-pet-id="{{item._id}}" data-pet-name="{{item.name}}">
          <image class="record-entry-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          <text class="record-entry-text">自查记录</text>
          <text class="record-count-badge">{{item.recordCount || 0}}条</text>
          <text class="record-entry-arrow">›</text>
        </view>
        <view class="record-entry" bindtap="showPetReports" data-pet-id="{{item._id}}" data-pet-name="{{item.name}}">
          <image class="record-entry-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          <text class="record-entry-text">健康报告</text>
          <text class="record-count-badge">{{item.reportCount || 0}}条</text>
          <text class="record-entry-arrow">›</text>
        </view>
      </view>

      <!-- 底部操作栏 -->
      <view class="pet-card-footer">
        <view class="footer-left">
          <text class="update-time">编号: {{item.petCode || '编号生成中'}}</text>
        </view>
        <view class="footer-right">
          <view class="delete-force-btn" id="delete-btn-{{item._id || item.petId}}" data-pet-id="{{item._id || item.petId}}" catchtap="deletePet">
            删除
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态设计 -->
  <view class="empty-state-modern" wx:if="{{petList.length === 0}}">
    <view class="empty-illustration">
      <view class="empty-circle-bg">
        <image class="empty-emoji-large" src="/images/icons/paw.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="empty-content">
      <text class="empty-title">还没有宠物档案</text>
      <text class="empty-description">创建您的宠物档案，开始智能健康管理</text>
    </view>
    <view class="empty-features">
      <view class="feature-item">
        <image class="feature-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
        <text class="feature-text">健康记录</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">⏰</text>
        <text class="feature-text">疫苗提醒</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" />
        <text class="feature-text">症状自查</text>
      </view>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="floating-add-btn" bindtap="addPet" aria-label="添加宠物">
    <view class="add-btn-circle">
      <text class="add-icon-large">+</text>
    </view>
    <text class="add-label">添加宠物</text>
  </view>

</view>

<!-- 现代化添加/编辑弹窗 -->
<view class="modal-overlay {{showModal ? 'modal-show' : ''}}" wx:if="{{showModal}}">
  <view class="modal-backdrop" bindtap="hideModal"></view>
  <view class="modal-container-modern">
    <!-- 弹窗头部 -->
    <view class="modal-header-modern">
      <view class="modal-header-content">
        <text class="modal-title-modern">{{isEdit ? '编辑宠物档案' : '添加宠物档案'}}</text>
        <text class="modal-subtitle-modern">{{isEdit ? '更新宠物基本信息和健康记录' : '创建新的宠物健康档案'}}</text>
      </view>
      <view class="modal-close-btn" bindtap="hideModal">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- 弹窗内容 -->
    <scroll-view class="modal-scroll-content" scroll-y="{{true}}">
      <!-- 基本信息 -->
      <view class="form-section-modern">
        <view class="section-title-modern">
          <image class="section-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          <text class="section-text">基本信息</text>
        </view>

        <!-- 宠物头像上传 -->
        <view class="form-group-modern">
          <view class="form-label-modern">
            <text class="label-text">宠物头像</text>
          </view>
          <view class="avatar-upload-container">
            <!-- 头像预览区域 -->
            <view class="avatar-preview-section">
              <view class="avatar-preview-box" wx:if="{{avatarPreview}}" bindtap="previewAvatar">
                <image class="avatar-preview-image" src="{{avatarPreview}}" mode="aspectFill"/>
                <view class="avatar-preview-overlay">
                  <text class="preview-overlay-text">点击预览</text>
                </view>
              </view>
              <view class="avatar-placeholder" wx:else>
                <text class="placeholder-icon">上传</text>
                <text class="avatar-placeholder-text">暂无头像</text>
              </view>
            </view>

            <!-- 上传操作区域 -->
            <view class="avatar-actions-section">
              <view class="avatar-action-btn upload-btn" bindtap="chooseAvatar">
                <text class="action-text">{{uploadingImage ? '上传中...' : '选择头像'}}</text>
              </view>
              <view class="avatar-action-btn delete-btn" wx:if="{{avatarPreview}}" bindtap="removeAvatar">
                <text class="action-text">删除</text>
              </view>
            </view>
          </view>
          <view class="avatar-tips">
            <text class="tips-text">支持JPG/PNG/WEBP格式，最大5MB，建议尺寸500x500</text>
          </view>
        </view>

        <view class="form-group-modern">
          <view class="form-label-modern">
            <text class="label-text">宠物昵称</text>
            <text class="label-required">*</text>
          </view>
          <input class="form-input-modern"
                 placeholder="请输入宠物昵称"
                 aria-label="宠物昵称"
                 placeholder-style="color: #999999;"
                 placeholder-class="placeholder-text"
                 value="{{formData.name}}"
                 bindinput="onNameInput"
                 bindfocus="onInputFocus"
                 bindblur="onInputBlur"/>
        </view>

        <view class="form-group-modern">
          <view class="form-label-modern">
            <text class="label-text">宠物类型</text>
            <text class="label-required">*</text>
          </view>
          <view class="type-selector-modern">
            <view class="type-card-modern {{formData.type === 'cat' ? 'type-active' : ''}}"
                  bindtap="selectType"
                  data-type="cat">
              <image class="type-icon" src="/images/icons/paw.svg" mode="aspectFit" />
              <text class="type-name">猫咪</text>
            </view>
            <view class="type-card-modern {{formData.type === 'dog' ? 'type-active' : ''}}"
                  bindtap="selectType"
                  data-type="dog">
              <image class="type-icon" src="/images/icons/paw.svg" mode="aspectFit" />
              <text class="type-name">狗狗</text>
            </view>
          </view>
        </view>

        <view class="form-row-modern">
          <view class="form-group-modern form-half">
            <view class="form-label-modern">
              <text class="label-text">品种</text>
            </view>
            <input class="form-input-modern"
                   placeholder="请输入品种"
                   aria-label="品种"
                   placeholder-style="color: #999999;"
                   placeholder-class="placeholder-text"
                   value="{{formData.breed}}"
                   bindinput="onBreedInput"
                   bindfocus="onInputFocus"
                   bindblur="onInputBlur"/>
          </view>
          <view class="form-group-modern form-half">
            <view class="form-label-modern">
              <text class="label-text">性别</text>
            </view>
            <view class="gender-selector-modern">
              <view class="gender-option {{formData.gender === 'male' ? 'gender-active' : ''}}"
                    bindtap="onGenderChange"
                    data-value="male">
                <text class="gender-icon">♂</text>
                <text class="gender-text">公</text>
              </view>
              <view class="gender-option {{formData.gender === 'female' ? 'gender-active' : ''}}"
                    bindtap="onGenderChange"
                    data-value="female">
                <text class="gender-icon">♀</text>
                <text class="gender-text">母</text>
              </view>
            </view>
          </view>
        </view>

        <view class="form-row-modern">
          <view class="form-group-modern form-half">
            <view class="form-label-modern">
              <text class="label-text">年龄（月）</text>
              <text class="label-required">*</text>
            </view>
            <input class="form-input-modern"
                   type="number"
                   placeholder="请输入月数"
                   aria-label="年龄（月）"
                   placeholder-style="color: #999999;"
                   placeholder-class="placeholder-text"
                   value="{{formData.age}}"
                   bindinput="onAgeInput"
                   bindfocus="onInputFocus"
                   bindblur="onInputBlur"/>
          </view>
          <view class="form-group-modern form-half">
            <view class="form-label-modern">
              <text class="label-text">体重（kg）</text>
            </view>
            <input class="form-input-modern"
                   type="digit"
                   placeholder="请输入体重"
                   aria-label="体重（kg）"
                   placeholder-style="color: #999999;"
                   placeholder-class="placeholder-text"
                   value="{{formData.weight}}"
                   bindinput="onWeightInput"
                   bindfocus="onInputFocus"
                   bindblur="onInputBlur"/>
          </view>
        </view>
      </view>

      <!-- 健康记录 -->
      <view class="form-section-modern">
        <view class="section-title-modern">
          <image class="section-icon" src="/images/icons/paw.svg" mode="aspectFit" />
          <text class="section-text">健康记录</text>
        </view>

        <view class="form-group-modern">
          <view class="form-label-modern">
            <text class="label-text">上次疫苗日期</text>
          </view>
          <picker mode="date"
                  value="{{formData.vaccineDate}}"
                  bindchange="onVaccineDateChange">
            <view class="picker-input-modern {{formData.vaccineDate ? 'picker-selected' : ''}}">
              <text class="picker-text">{{formData.vaccineDate || '请选择疫苗日期'}}</text>
              <text class="picker-arrow">→</text>
            </view>
          </picker>
        </view>

        <view class="form-group-modern">
          <view class="form-label-modern">
            <text class="label-text">上次驱虫日期</text>
          </view>
          <picker mode="date"
                  value="{{formData.dewormDate}}"
                  bindchange="onDewormDateChange">
            <view class="picker-input-modern {{formData.dewormDate ? 'picker-selected' : ''}}">
              <text class="picker-text">{{formData.dewormDate || '请选择驱虫日期'}}</text>
              <text class="picker-arrow">→</text>
            </view>
          </picker>
        </view>
      </view>
    </scroll-view>

    <!-- 弹窗底部操作 -->
    <view class="modal-footer-modern">
      <view class="modal-btn-group">
        <view class="modal-btn-modern modal-cancel" bindtap="hideModal">
          <text class="modal-btn-text">取消</text>
        </view>
        <view class="modal-btn-modern modal-confirm" bindtap="savePet">
          <text class="modal-btn-text">{{isEdit ? '保存修改' : '创建档案'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 记录列表弹窗（独立于添加/编辑弹窗） -->
<view class="record-modal-mask" wx:if="{{showRecordModal}}" bindtap="hideRecordModal"></view>
<view class="record-modal-sheet" wx:if="{{showRecordModal}}">
  <view class="record-modal-header">
    <text class="record-modal-title">{{recordModalTitle}}</text>
    <view class="record-modal-close" bindtap="hideRecordModal">✖</view>
  </view>
  <view class="record-modal-list">
    <!-- 加载状态 -->
    <view class="record-modal-loading" wx:if="{{recordLoading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 记录列表 -->
    <block wx:elif="{{recordList && recordList.length > 0}}">
      <view class="record-list-item" wx:for="{{recordList}}" wx:key="_id" bindtap="viewRecordDetail" data-record-id="{{item._id}}">
        <view class="record-item-icon" style="background: {{item.bgColor}};">{{item.icon}}</view>
        <view class="record-item-info">
          <text class="record-item-title">{{item.title}}</text>
          <text class="record-item-desc">{{item.desc}}</text>
        </view>
        <text class="record-item-arrow">›</text>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="record-modal-empty" wx:else>
      <image class="empty-icon" src="/images/icons/clipboard.svg" mode="aspectFit" wx:if="{{currentRecordType === 'report'}}"/>
      <image class="empty-icon" src="/images/icons/clipboard.svg" mode="aspectFit" wx:else/>
      <text class="empty-text" wx:if="{{currentRecordType === 'report'}}">暂无AI健康报告</text>
      <text class="empty-text" wx:else>暂无记录</text>
      <text class="empty-hint" wx:if="{{currentRecordType === 'report'}}">在自查记录中查看评估详情，可生成AI报告</text>
      <text class="empty-hint" wx:else>进行症状自查后会在这里显示</text>
    </view>
  </view>
</view>
