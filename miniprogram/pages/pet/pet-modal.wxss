/* 宠物档案弹窗 / 表单样式 — 从 profile.wxss 提取 */

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.modal-show {
  opacity: 1;
  pointer-events: auto;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  
}

.modal-container-modern {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header-modern {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.modal-header-content {
  flex: 1;
}

.modal-title-modern {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.modal-subtitle-modern {
  display: block;
  font-size: 24rpx;
  color: #666666;
}

.modal-close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 24rpx;
  color: #666666;
}

.modal-scroll-content {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.form-section-modern {
  margin-bottom: 32rpx;
}

.section-title-modern {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 24rpx;
}

.section-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.form-group-modern {
  margin-bottom: 20rpx;
}

.form-label-modern {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 24rpx;
  color: #333333;
}

.label-required {
  color: #FF6B6B;
  margin-left: 4rpx;
}

.form-input-modern {
  width: 100%;
  padding: 16rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #FAFAFA;
  color: #333333;
}

.placeholder-text {
  color: #999999;
}

.type-selector-modern {
  display: flex;
  gap: 16rpx;
}

.type-card-modern {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.type-active {
  border-color: #667EEA;
  background: var(--brand-primary-light);
}

.type-emoji {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  display: block;
  font-size: 24rpx;
  color: #333333;
}

.form-row-modern {
  display: flex;
  gap: 16rpx;
}

.form-half {
  flex: 1;
}

.gender-selector-modern {
  display: flex;
  gap: 12rpx;
}

.gender-option {
  flex: 1;
  padding: 12rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.gender-active {
  border-color: #667EEA;
  background: var(--brand-primary-light);
}

.gender-icon {
  font-size: 24rpx;
}

.gender-text {
  font-size: 24rpx;
  color: #333333;
}

.picker-input-modern {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  background: #FAFAFA;
  color: #333333;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-selected {
  border-color: #667EEA;
  background: var(--brand-primary-light);
}

.avatar-upload-container {
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.avatar-preview-section {
  margin-bottom: 20rpx;
}

.avatar-preview-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  overflow: hidden;
}

.avatar-preview-image {
  width: 100%;
  height: 100%;
}

.avatar-preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-overlay-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.placeholder-icon {
  font-size: 48rpx;
}

.avatar-placeholder-text {
  font-size: 24rpx;
  color: #999999;
}

.avatar-actions-section {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.avatar-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #F0F2F5;
  border: none;
}

.upload-btn {
  background: var(--brand-primary);
  color: #FFFFFF;
}

.delete-btn {
  background: #FFEBEE;
  color: #FF6B6B;
}

.avatar-action-btn::after {
  border: none;
}

.avatar-tips {
  margin-top: 12rpx;
  text-align: center;
}

.tips-text {
  font-size: 20rpx;
  color: #999999;
}

.modal-footer-modern {
  padding: 32rpx;
  border-top: 1rpx solid #F0F2F5;
}

.modal-btn-group {
  display: flex;
  gap: 16rpx;
}

.modal-btn-modern {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
}

.modal-cancel {
  background: #F0F2F5;
  color: #666666;
}

.modal-confirm {
  background: var(--brand-primary);
  color: #FFFFFF;
}

.modal-btn-text {
  font-size: 28rpx;
  font-weight: 500;
}
