<view class="container">
  <view class="page-header">
    <view class="back-btn" bindtap="goBack" hover-class="back-btn-active">
      <view class="back-arrow"></view>
      <text class="back-text">返回</text>
    </view>
    <view class="page-title">会员状态</view>
    <view class="header-placeholder"></view>
  </view>

  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <!-- 续费到期提醒 -->
    <view class="renew-reminder" wx:if="{{showRenewReminder}}">
      <image class="reminder-icon" src="/images/icons/warning.svg" mode="aspectFit" />
      <text class="reminder-text">会员将在 {{daysRemaining}} 天后到期，续费享优惠价</text>
      <text class="reminder-link" bindtap="goToPurchase">立即续费 ></text>
    </view>

    <!-- 会员状态卡 -->
    <view class="member-card {{isMember ? 'active-card' : 'inactive-card'}}">
      <view class="member-badge">
        <image class="badge-icon" src="{{isMember ? '/images/icons/crown.svg' : '/images/icons/star.svg'}}" mode="aspectFit" />
      </view>
      <view class="member-info">
        <view class="member-type">{{isMember ? typeText : '尚未开通会员'}}</view>
        <view class="member-detail" wx:if="{{isMember}}">
          <text class="detail-item">到期：{{expireText}}</text>
          <text class="detail-sep">|</text>
          <text class="detail-item highlight">剩余 {{daysRemaining}} 天</text>
        </view>
        <view class="member-detail" wx:if="{{!isMember}}">
          <text class="detail-item">开通会员，享受更多专属权益</text>
        </view>
      </view>
    </view>

    <!-- 报告额度卡 -->
    <view class="credits-card" wx:if="{{isMember}}">
      <view class="credits-header">
        <text class="credits-title">本月报告额度</text>
        <text class="credits-hint" wx:if="{{memberInfo.report_credits_remaining <= 1}}">额度即将用完</text>
      </view>
      <view class="credits-bar-wrapper">
        <view class="credits-bar-bg">
          <view class="credits-bar-fill" style="width: {{memberInfo.report_credits_total > 0 ? (memberInfo.report_credits_remaining / memberInfo.report_credits_total * 100) : 0}}%"></view>
        </view>
        <text class="credits-num">{{creditsText}}</text>
      </view>
    </view>

    <!-- 自动续费开关（V1.5） -->
    <view class="auto-renew-card" wx:if="{{showAutoRenewToggle}}">
      <view class="auto-renew-row">
        <view class="auto-renew-info">
          <text class="auto-renew-title">自动续费</text>
          <text class="auto-renew-hint">到期前自动续费，可随时取消</text>
          <text class="auto-renew-detail" wx:if="{{renewPriceDisplay}}">续费价 ¥{{renewPriceDisplay}} · 下次 {{expireText}}</text>
        </view>
        <switch checked="{{autoRenew}}" bindchange="toggleAutoRenew" color="#667eea" />
      </view>
    </view>

    <!-- 会员成就卡（V1.5） -->
    <view class="achievement-card" wx:if="{{isMember && totalReports > 0}}">
      <view class="achievement-item">
        <text class="achievement-value">{{totalReports}}</text>
        <text class="achievement-label">已生成报告</text>
      </view>
      <view class="achievement-divider"></view>
      <view class="achievement-item">
        <text class="achievement-value saved">¥{{savedAmount}}</text>
        <text class="achievement-label">已为您节省</text>
      </view>
    </view>

    <!-- 家庭成员入口（V1.5） -->
    <view class="family-entry" wx:if="{{isMember && isFamilyMember}}" bindtap="goToFamily">
      <view class="family-row">
        <view class="family-info">
          <image class="family-icon" src="/images/icons/paw.svg" mode="aspectFit" />
          <text class="family-title">管理家庭成员</text>
        </view>
        <text class="family-arrow">></text>
      </view>
    </view>

    <!-- 点数包入口（V1.5） -->
    <view class="points-entry" bindtap="goToPoints">
      <view class="points-row">
        <view class="points-info">
          <image class="points-icon" src="/images/icons/gift.svg" mode="aspectFit" />
          <text class="points-title">购买点数包</text>
          <text class="points-subtitle">≈¥6.6/次，比单买更划算</text>
        </view>
        <text class="points-arrow">></text>
      </view>
    </view>

    <!-- 权益列表 -->
    <view class="benefits-section">
      <view class="section-title">会员权益</view>
      <view class="benefits-list">
        <view class="benefit-item">
          <view class="benefit-icon-wrap blue-icon"><image class="benefit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" /></view>
          <view class="benefit-text">
            <text class="benefit-name">每月{{memberInfo.report_credits_total || 3}}次AI报告</text>
            <text class="benefit-desc">价值 ¥{{benefitValue}}/月</text>
          </view>
          <view class="benefit-status" wx:if="{{isMember}}">✓</view>
        </view>
        <view class="benefit-item">
          <view class="benefit-icon-wrap green-icon"><image class="benefit-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" /></view>
          <view class="benefit-text">
            <text class="benefit-name">无限症状自查</text>
            <text class="benefit-desc">不限次数使用</text>
          </view>
          <view class="benefit-status" wx:if="{{isMember}}">✓</view>
        </view>
        <view class="benefit-item">
          <view class="benefit-icon-wrap orange-icon"><image class="benefit-icon" src="/images/icons/pill.svg" mode="aspectFit" /></view>
          <view class="benefit-text">
            <text class="benefit-name">疫苗/驱虫提醒</text>
            <text class="benefit-desc">到期自动提醒</text>
          </view>
          <view class="benefit-status" wx:if="{{isMember}}">✓</view>
        </view>
        <view class="benefit-item">
          <view class="benefit-icon-wrap purple-icon"><image class="benefit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" /></view>
          <view class="benefit-text">
            <text class="benefit-name">历史报告永久保存</text>
            <text class="benefit-desc">随时查看所有报告</text>
          </view>
          <view class="benefit-status" wx:if="{{isMember}}">✓</view>
        </view>
        <!-- 家庭会员专属 -->
        <view class="benefit-item" wx:if="{{isFamilyMember}}">
          <view class="benefit-icon-wrap pink-icon"><image class="benefit-icon" src="/images/icons/paw.svg" mode="aspectFit" /></view>
          <view class="benefit-text">
            <text class="benefit-name">家庭成员共享</text>
            <text class="benefit-desc">最多 4 人共享额度</text>
          </view>
          <view class="benefit-status" wx:if="{{isMember}}">✓</view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="action-btn primary" bindtap="goToPurchase">
        {{isMember ? '续费 / 升级会员' : '立即开通会员'}}
      </button>
      <button class="action-btn danger" wx:if="{{isMember && memberInfo.auto_renew && !autoRenew}}" bindtap="cancelAutoRenew" disabled="{{cancelling}}">
        取消自动续费
      </button>
    </view>
  </view>
</view>
