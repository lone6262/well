<!--会员中心页面 — V1.5 商业化增强版-->
<view class="page-container">
  <!-- 顶部品牌头部 -->
  <view class="page-header">
    <view class="header-inner">
      <view class="header-content">
        <image class="header-icon" src="/images/icons/crown.svg" mode="aspectFit" />
        <text class="header-title">会员中心</text>
        <text class="header-subtitle">为宝贝的健康保驾护航</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="state-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <view class="content-area" wx:if="{{!loading}}">
    <!-- 会员状态卡 -->
    <view class="vip-card {{isMember ? 'vip-active' : 'vip-inactive'}}">
      <view class="vip-top">
        <view class="vip-badge">
          <image class="vip-badge-icon" src="{{isMember ? '/images/icons/crown.svg' : '/images/icons/star.svg'}}" mode="aspectFit" />
        </view>
        <view class="vip-info">
          <text class="vip-type">{{isMember ? typeText : '尚未开通会员'}}</text>
          <text class="vip-desc" wx:if="{{isMember}}">到期：{{expireText}}</text>
          <text class="vip-desc" wx:else>开通会员，享受更多专属权益</text>
        </view>
        <view class="vip-days" wx:if="{{isMember}}">
          <text class="vip-days-num">{{memberInfo.days_remaining || 0}}</text>
          <text class="vip-days-unit">天</text>
        </view>
      </view>
    </view>

    <!-- 报告额度（会员专属） -->
    <view class="card" wx:if="{{isMember}}">
      <view class="card-row">
        <text class="card-title">本月报告额度</text>
        <text class="card-extra" wx:if="{{memberInfo.next_reset_at}}">{{memberInfo.next_reset_at}} 重置</text>
      </view>
      <view class="progress-row">
        <view class="progress-bg">
          <view class="progress-fill" style="width: {{memberInfo.report_credits_total > 0 ? (memberInfo.report_credits_remaining / memberInfo.report_credits_total * 100) : 0}}%"></view>
        </view>
        <text class="progress-text">{{creditsText}}</text>
      </view>
      <text class="progress-hint" wx:if="{{memberInfo.report_credits_remaining === 0}}">本月额度已用完，可购买点数包或升级套餐</text>
    </view>

    <!-- V2.0: 点数余额展示 -->
    <view class="card" wx:if="{{isMember || pointsBalance > 0}}">
      <view class="points-row">
        <view class="points-row-left">
          <image class="points-row-icon" src="/images/icons/gift.svg" mode="aspectFit" />
          <text class="card-title" style="margin-bottom:0;">我的点数</text>
        </view>
        <view class="points-row-right">
          <text class="points-balance-num">{{pointsBalance}}</text>
          <text class="points-balance-unit">点</text>
        </view>
      </view>
      <text class="points-expire-hint" wx:if="{{pointsExpireAt && pointsBalance > 0}}">有效期至 {{pointsExpireAt.substring(0,10)}}</text>
      <text class="points-expire-hint" wx:if="{{pointsBalance === 0}}">无可用点数，可购买点数包随时补充</text>
    </view>

    <!-- ===== V1.5 新增：快捷功能区 ===== -->
    <view class="card shortcut-card">
      <text class="card-title" style="margin-bottom: 24rpx;">增值服务</text>
      <view class="shortcut-grid">
        <!-- 点数包 -->
        <view class="shortcut-item" bindtap="goToPoints">
          <view class="shortcut-icon-wrap shortcut-blue">
            <image class="shortcut-icon" src="/images/icons/gift.svg" mode="aspectFit" />
          </view>
          <text class="shortcut-name">点数包</text>
          <text class="shortcut-price">{{pointsEntryPrice}}</text>
        </view>
        <!-- 优惠券 -->
        <view class="shortcut-item" bindtap="goToCoupons">
          <view class="shortcut-icon-wrap shortcut-orange">
            <image class="shortcut-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          </view>
          <text class="shortcut-name">优惠券</text>
          <text class="shortcut-price">{{couponCount > 0 ? couponCount + '张可用' : '领取'}}</text>
        </view>
        <!-- 套餐 -->
        <view class="shortcut-item" bindtap="goToBundle">
          <view class="shortcut-icon-wrap shortcut-purple">
            <image class="shortcut-icon" src="/images/icons/gift.svg" mode="aspectFit" />
          </view>
          <text class="shortcut-name">超值套餐</text>
          <text class="shortcut-price">{{bundleEntrySave}}</text>
        </view>
        <!-- 邀请好友 -->
        <view class="shortcut-item" bindtap="goToInvite">
          <view class="shortcut-icon-wrap shortcut-green">
            <image class="shortcut-icon" src="/images/icons/gift.svg" mode="aspectFit" />
          </view>
          <text class="shortcut-name">邀请好友</text>
          <text class="shortcut-price">赚额度</text>
        </view>
      </view>
    </view>

    <!-- ===== V1.5 新增：套餐推荐区（非会员显示） ===== -->
    <view class="card" wx:if="{{!isMember}}">
      <text class="card-title" style="margin-bottom: 20rpx;">开通会员享更多</text>
      <view class="recommend-list">
        <!-- 个人月卡 -->
        <view class="recommend-item" bindtap="goToPurchaseMonthly">
          <view class="recommend-info">
            <text class="recommend-name">个人月卡</text>
            <text class="recommend-desc">每月{{creditsMonthly}}次AI报告，约{{discountMonthly}}折</text>
          </view>
          <view class="recommend-right">
            <text class="recommend-price">¥{{priceMonthly}}</text>
            <text class="recommend-arrow">›</text>
          </view>
        </view>
        <!-- 个人年卡 -->
        <view class="recommend-item recommend-hot" bindtap="goToPurchaseYearly">
          <view class="recommend-hot-tag">推荐</view>
          <view class="recommend-info">
            <text class="recommend-name">个人年卡</text>
            <text class="recommend-desc">≈¥{{yearlyPerMonth}}/月，约{{discountYearly}}折</text>
          </view>
          <view class="recommend-right">
            <text class="recommend-price">¥{{priceYearly}}</text>
            <text class="recommend-arrow">›</text>
          </view>
        </view>
        <!-- 家庭月卡 -->
        <view class="recommend-item" bindtap="goToPurchaseFamilyMonthly">
          <view class="recommend-info">
            <text class="recommend-name">家庭月卡</text>
            <text class="recommend-desc">每月{{creditsFamilyMonthly}}次，约{{discountFamilyMonthly}}折</text>
          </view>
          <view class="recommend-right">
            <text class="recommend-price">¥{{priceFamilyMonthly}}</text>
            <text class="recommend-arrow">›</text>
          </view>
        </view>
        <!-- 家庭年卡 -->
        <view class="recommend-item" bindtap="goToPurchaseFamilyYearly">
          <view class="recommend-info">
            <text class="recommend-name">家庭年卡</text>
            <text class="recommend-desc">≈¥{{yearlyFamilyPerMonth}}/月，约{{discountFamilyYearly}}折</text>
          </view>
          <view class="recommend-right">
            <text class="recommend-price">¥{{priceFamilyYearly}}</text>
            <text class="recommend-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 权益列表 -->
    <view class="card">
      <text class="card-title" style="margin-bottom: 24rpx;">会员权益</text>

      <view class="benefit-item">
        <view class="benefit-icon-wrap benefit-blue">
          <image class="benefit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">每月{{memberInfo.report_credits_total || creditsMonthly}}次AI报告</text>
          <text class="benefit-desc">深度分析宠物健康状况</text>
        </view>
        <text class="benefit-value">¥{{currentPerReport}}/次 <text class="benefit-discount">约{{currentDiscount}}折</text></text>
      </view>

      <view class="benefit-item">
        <view class="benefit-icon-wrap benefit-green">
          <image class="benefit-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">无限症状自查</text>
          <text class="benefit-desc">不限次数随时使用</text>
        </view>
        <text class="benefit-value">无限</text>
      </view>

      <view class="benefit-item">
        <view class="benefit-icon-wrap benefit-orange">
          <image class="benefit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">历史报告永久保存</text>
          <text class="benefit-desc">随时查看所有报告</text>
        </view>
        <text class="benefit-value">永久</text>
      </view>

      <view class="benefit-item">
        <view class="benefit-icon-wrap benefit-purple">
          <image class="benefit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">会员专属内容</text>
          <text class="benefit-desc">深度养宠知识库</text>
        </view>
        <text class="benefit-value">独家</text>
      </view>

      <!-- V1.5 家庭会员专属权益 -->
      <view class="benefit-item" wx:if="{{isMember && isFamilyMember}}">
        <view class="benefit-icon-wrap benefit-pink">
          <image class="benefit-icon" src="/images/icons/paw.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">家庭成员共享</text>
          <text class="benefit-desc">最多4人共享额度，最多5只宠物</text>
        </view>
        <text class="benefit-value">家庭</text>
      </view>

      <!-- V1.5 自动续费 -->
      <view class="benefit-item benefit-last" wx:if="{{isMember}}">
        <view class="benefit-icon-wrap benefit-teal">
          <image class="benefit-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" />
        </view>
        <view class="benefit-info">
          <text class="benefit-name">自动续费</text>
          <text class="benefit-desc">到期自动续费，续费享优惠价</text>
        </view>
        <text class="benefit-value benefit-link" bindtap="goToStatus">管理 ›</text>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-area">
      <!-- 测试按钮（测试完成后移除） -->
      <view class="btn-test btn-full" bindtap="testPayment" hover-class="btn-hover">
        <text class="btn-test-icon">🧪</text>
        <text>测试支付 ¥0.01</text>
      </view>

      <view class="btn-row" wx:if="{{isMember}}">
        <view class="btn-secondary" bindtap="goToStatus" hover-class="btn-hover">会员详情</view>
        <view class="btn-primary" bindtap="goToPurchase" hover-class="btn-hover">续费 / 升级</view>
      </view>
      <view class="btn-primary btn-full" bindtap="goToPurchase" hover-class="btn-hover" wx:if="{{!isMember}}">立即开通会员</view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
