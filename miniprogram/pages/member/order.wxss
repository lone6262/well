/* 会员购买页面样式 */
page {
  background-color: var(--bg-secondary);
  width: 100%;
}

.container {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  transition: background 200ms ease;
}

.back-btn-active {
  background: rgba(0, 0, 0, 0.05);
}

.back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  margin-right: 6rpx;
}

.back-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.header-placeholder {
  width: 80rpx;
}

/* 内容区域 */
.content {
  padding: 24rpx;
}

/* V1.5: Tab 切换 */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-active {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  box-shadow: 0 4rpx 12rpx rgba(102,126,234,0.3);
}

.tab-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.tab-active .tab-text {
  color: var(--bg-card);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 套餐卡片 */
.plans-wrapper {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.plan-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.plan-card.selected {
  border-color: var(--brand-primary);
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.2);
}

.plan-card.recommend {
  background: var(--brand-primary-light);
}

.recommend-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
  color: var(--bg-card);
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 10rpx 10rpx;
  font-weight: bold;
}

.plan-check {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--brand-primary);
  color: var(--bg-card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

.plan-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  margin-top: 16rpx;
}

.plan-price {
  margin-bottom: 16rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: bold;
}

.price-amount {
  font-size: 48rpx;
  color: var(--text-primary);
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 4rpx;
}

.plan-save {
  display: inline-block;
  font-size: 22rpx;
  color: var(--bg-card);
  background: var(--brand-emergency);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

/* V1.5 续费价提示 */
.plan-renew-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.plan-features {
  display: flex;
  flex-direction: column;
}

.feature-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 价格说明 */
.price-note {
  text-align: center;
  margin-bottom: 40rpx;
}

.note-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 底部按钮 */
.bottom-action {
  padding: 20rpx 0 60rpx;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  color: var(--bg-card);
  border: none;
}

.confirm-btn.disabled {
  opacity: 0.6;
}

.confirm-btn::after {
  border: none;
}

/* 协议链接 */
.agreement-link {
  color: var(--brand-primary);
  text-decoration: underline;
  display: inline;
}

/* 模拟支付处理覆盖层 */
.pay-processing-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-processing-content {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.pay-processing-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.pay-processing-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.pay-processing-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 32rpx;
}

.pay-processing-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.pay-processing-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.pay-processing-method {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
