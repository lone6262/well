/* 会员购买页面 — Warm Professionalism v2.0 */
page {
  background: var(--bg-secondary);
  width: 100%;
}

.order-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========================================
   内容区域
   ======================================== */
.content {
  padding: 24rpx 32rpx;
}

/* ========================================
   Tab 切换
   ======================================== */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-lg);
  transition: all var(--duration-base) var(--ease-standard);
}

.tab-active {
  background: var(--brand-primary);
  box-shadow: var(--shadow-sm);
}

.tab-icon {
  width: 24rpx;
  height: 24rpx;
}

.tab-active .tab-icon {
  filter: brightness(0) invert(1);
}

.tab-label {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-secondary);
}

.tab-active .tab-label {
  color: var(--text-inverse);
}

/* ========================================
   点报数入口条
   ======================================== */
.paygo-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.paygo-bar-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.paygo-bar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.paygo-bar-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.paygo-bar-highlight {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--brand-primary);
  margin: 0 4rpx;
}

.paygo-bar-arrow {
  font-size: var(--font-size-lg);
  color: var(--border-dark);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========================================
   套餐卡片 — 两列并排
   ======================================== */
.plans {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.plan-card {
  flex: 1;
  min-width: 0;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 28rpx 24rpx;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: var(--shadow-xs);
  box-sizing: border-box;
  transition: all var(--duration-base) var(--ease-standard);
}

.plan-selected {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
  box-shadow: var(--shadow-md);
}

.plan-recommend {
  background: var(--brand-primary-light);
}

/* 推荐角标 */
.plan-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-size-xs);
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}

/* 勾选 */
.plan-check {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.plan-name {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.plan-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-symbol {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--brand-primary);
}

.price-amount {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1;
}

.price-unit {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-left: 4rpx;
}

.plan-renew {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.plan-tag {
  display: inline-block;
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--text-inverse);
  background: var(--brand-emergency);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
}

.plan-features {
  display: flex;
  flex-direction: column;
}

.feature-item {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  line-height: var(--line-height-relaxed);
}

/* ========================================
   价格说明
   ======================================== */
.price-note {
  text-align: center;
  margin-bottom: 24rpx;
}

.note-text {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  line-height: var(--line-height-normal);
}

.agreement-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-link {
  font-size: var(--font-size-xs);
  color: var(--brand-primary);
  font-weight: 500;
}

/* ========================================
   底部按钮
   ======================================== */
.bottom-action {
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity var(--duration-fast) var(--ease-standard);
}

.confirm-btn:active { opacity: 0.85; }
.confirm-disabled { opacity: 0.6; }

/* ========================================
   支付处理覆盖层
   ======================================== */
.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: var(--z-modal-backdrop);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-dialog {
  width: 85%;
  max-width: 560rpx;
  background: var(--bg-card);
  border-radius: var(--radius-3xl);
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: var(--shadow-md);
}

.pay-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.pay-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.pay-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.pay-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 32rpx;
}

.pay-amount {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.pay-method {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}
