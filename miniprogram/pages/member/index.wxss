/* ===================================
   会员中心页面 — Warm Professionalism v2.0
   =================================== */

page {
  background: var(--bg-secondary);
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 顶部头部 ===== */
.page-header {
  background: var(--brand-primary);
  border-radius: 0 0 var(--radius-3xl) var(--radius-3xl);
  overflow: hidden;
}

.header-inner { padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl); }

.header-content { padding-left: 8rpx; }

.header-icon {
  width: 44rpx; height: 44rpx;
  display: block;
  margin-bottom: 8rpx;
  filter: brightness(0) invert(1);
}

.header-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-inverse);
  opacity: 0.8;
}

/* ===== 加载状态 ===== */
.state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.state-text { font-size: var(--font-size-base); color: var(--text-tertiary); }

/* ===== 内容区域 ===== */
.content-area { padding: 20rpx var(--spacing-lg) 0; }

/* ===== VIP 状态卡 ===== */
.vip-card {
  border-radius: var(--radius-2xl);
  padding: 36rpx var(--spacing-xl);
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.vip-active {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  box-shadow: var(--shadow-md);
}

.vip-inactive {
  background: var(--bg-secondary);
  box-shadow: var(--shadow-xs);
}

/* 装饰圆 */
.vip-card::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: var(--text-inverse);
  opacity: 0.08;
}

.vip-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx; right: 60rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: var(--text-inverse);
  opacity: 0.05;
}

.vip-top {
  position: relative;
  display: flex;
  align-items: center;
}

.vip-badge { margin-right: 20rpx; }

.vip-badge-icon { width: 64rpx; height: 64rpx; filter: brightness(0) invert(1); }

.vip-info { flex: 1; }

.vip-type {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 8rpx;
}

.vip-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-inverse);
  opacity: 0.8;
}

.vip-inactive .vip-type { color: var(--text-primary); }
.vip-inactive .vip-desc { color: var(--text-tertiary); opacity: 1; }

.vip-days {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: var(--radius-xl);
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.3);
}

.vip-days-num {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--brand-secondary);
  line-height: 1;
}

.vip-days-unit {
  font-size: var(--font-size-xs);
  color: var(--brand-secondary);
  margin-top: 4rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: var(--spacing-xl);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-xs);
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-primary);
}

.card-extra {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* 进度条 */
.progress-row { display: flex; align-items: center; }

.progress-bg {
  flex: 1;
  height: 16rpx;
  background: var(--border-color);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-md);
  transition: width 0.5s ease;
}

.progress-text {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--brand-primary);
  min-width: 60rpx;
  text-align: right;
}

.progress-hint {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  margin-top: 10rpx;
}

/* ===== 点数余额 ===== */
.points-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.points-row-icon {
  width: 34rpx; height: 34rpx;
}

.points-row-right {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.points-balance-num {
  font-size: var(--font-size-xl);
  font-weight: 800;
  color: var(--brand-primary);
  line-height: 1;
}

.points-balance-unit {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.points-expire-hint {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  padding-left: 46rpx;
}

/* ===== 权益列表 ===== */
.benefit-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.benefit-last { border-bottom: none; padding-bottom: 4rpx; }

.benefit-icon-wrap {
  width: 68rpx; height: 68rpx;
  border-radius: var(--radius-xl);
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.benefit-blue { background: var(--brand-primary-light); }
.benefit-green { background: var(--brand-secondary-light); }
.benefit-orange { background: var(--color-warning-light); }
.benefit-purple { background: var(--color-info-light); }

.benefit-icon { width: 34rpx; height: 34rpx; }

.benefit-info { flex: 1; }

.benefit-name {
  display: block;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.benefit-desc {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.benefit-value {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--brand-primary);
  flex-shrink: 0;
}

.benefit-discount {
  font-size: var(--font-size-xs);
  color: var(--text-inverse);
  background: var(--brand-emergency);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
  font-weight: 500;
}

/* ===== 快捷功能区 ===== */
.shortcut-card { padding: 24rpx var(--spacing-xl); }

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.shortcut-icon-wrap {
  width: 88rpx; height: 88rpx;
  border-radius: var(--radius-2xl);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx;
}

.shortcut-blue { background: var(--brand-primary-light); }
.shortcut-orange { background: var(--color-warning-light); }
.shortcut-purple { background: var(--color-info-light); }
.shortcut-green { background: var(--brand-secondary-light); }

.shortcut-icon { width: 40rpx; height: 40rpx; }

.shortcut-name {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.shortcut-price {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* ===== 套餐推荐区 ===== */
.recommend-list { margin-top: 8rpx; }

.recommend-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: var(--radius-xl);
  background: var(--brand-primary-light);
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

.recommend-hot {
  background: var(--brand-primary-light);
  border: 1rpx solid var(--brand-primary);
}

.recommend-hot-tag {
  position: absolute;
  top: 0; right: 0;
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 var(--radius-xl) 0 var(--radius-md);
}

.recommend-info { flex: 1; }

.recommend-name {
  display: block;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 4rpx;
}

.recommend-desc {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.recommend-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.recommend-price {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--brand-primary);
  margin-right: 8rpx;
}

.recommend-arrow {
  font-size: var(--font-size-md);
  color: var(--border-dark);
}

/* ===== 权益扩展 ===== */
.benefit-pink { background: var(--color-danger-light); }
.benefit-teal { background: var(--color-success-light); }

.benefit-link { color: var(--brand-primary) !important; }

/* ===== 底部按钮 ===== */
.btn-area {
  padding: 16rpx 0 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.btn-full { width: 100%; }

.btn-secondary {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 500;
  line-height: 88rpx;
  text-align: center;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.btn-hover { opacity: 0.9; transform: scale(0.98); }

/* 底部安全区 */
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 20rpx); }
