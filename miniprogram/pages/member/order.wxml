<!--会员购买页面 — Warm Professionalism v2.0-->
<view class="order-page">

  <view class="content">
    <!-- 套餐切换标签 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'personal' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="personal">
        <image class="tab-icon" src="/images/icons/crown.svg" mode="aspectFit" />
        <text class="tab-label">个人会员</text>
      </view>
      <view class="tab-item {{activeTab === 'family' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="family">
        <image class="tab-icon" src="/images/icons/paw.svg" mode="aspectFit" />
        <text class="tab-label">家庭会员</text>
      </view>
    </view>

    <!-- 点报数入口 -->
    <view class="paygo-bar" bindtap="goToPoints">
      <view class="paygo-bar-left">
        <view class="paygo-bar-dot"></view>
        <text class="paygo-bar-text">不想开会员？试试</text>
        <text class="paygo-bar-highlight">点报数</text>
        <text class="paygo-bar-text">— 按次购买 ¥{{standardReportDisplay}}/次</text>
      </view>
      <text class="paygo-bar-arrow">›</text>
    </view>

    <!-- 个人会员方案 -->
    <view class="plans" wx:if="{{activeTab === 'personal'}}">
      <!-- 月卡 -->
      <view class="plan-card {{selectedType === 'monthly' ? 'plan-selected' : ''}} {{renewMode ? 'plan-selected' : ''}}" bindtap="selectPlan" data-type="monthly">
        <view class="plan-check" wx:if="{{selectedType === 'monthly' || renewMode}}">✓</view>
        <view class="plan-name">个人月卡</view>
        <view class="plan-price-row">
          <text class="price-symbol">¥</text>
          <text class="price-amount">{{priceMonthly}}</text>
          <text class="price-unit">/月</text>
        </view>
        <text class="plan-renew">续费仅 ¥{{renewMonthly}}/月</text>
        <view class="plan-tag">约{{monthlyDiscount}}折</view>
        <view class="plan-features">
          <text class="feature-item">• 每月{{creditsMonthly}}次AI报告</text>
          <text class="feature-item">• 最多3只宠物</text>
          <text class="feature-item">• 无限自查</text>
        </view>
      </view>

      <!-- 年卡（推荐） -->
      <view class="plan-card plan-recommend {{selectedType === 'yearly' ? 'plan-selected' : ''}} {{upgradeMode ? 'plan-selected' : ''}}" bindtap="selectPlan" data-type="yearly">
        <view class="plan-badge">{{upgradeMode ? '升级推荐' : '推荐'}}</view>
        <view class="plan-check" wx:if="{{selectedType === 'yearly' || upgradeMode}}">✓</view>
        <view class="plan-name">个人年卡</view>
        <view class="plan-price-row">
          <text class="price-symbol">¥</text>
          <text class="price-amount">{{priceYearly}}</text>
          <text class="price-unit">/年</text>
        </view>
        <text class="plan-renew">续费仅 ¥{{renewYearly}}/年</text>
        <view class="plan-tag">省{{yearlySavings}}%</view>
        <view class="plan-features">
          <text class="feature-item">• 每月{{creditsMonthly}}次AI报告</text>
          <text class="feature-item">• 最多3只宠物</text>
          <text class="feature-item">• 无限自查</text>
          <text class="feature-item">• 专属内容</text>
        </view>
      </view>
    </view>

    <!-- 家庭会员方案 -->
    <view class="plans" wx:if="{{activeTab === 'family'}}">
      <!-- 家庭月卡 -->
      <view class="plan-card {{selectedType === 'family_monthly' ? 'plan-selected' : ''}}" bindtap="selectPlan" data-type="family_monthly">
        <view class="plan-check" wx:if="{{selectedType === 'family_monthly'}}">✓</view>
        <view class="plan-name">家庭月卡</view>
        <view class="plan-price-row">
          <text class="price-symbol">¥</text>
          <text class="price-amount">{{priceFamilyMonthly}}</text>
          <text class="price-unit">/月</text>
        </view>
        <text class="plan-renew">续费仅 ¥{{renewFamilyMonthly}}/月</text>
        <view class="plan-tag">全家共享</view>
        <view class="plan-features">
          <text class="feature-item">• 每月{{creditsFamilyMonthly}}次AI报告</text>
          <text class="feature-item">• 最多5只宠物</text>
          <text class="feature-item">• 最多4位家庭成员</text>
        </view>
      </view>

      <!-- 家庭年卡（推荐） -->
      <view class="plan-card plan-recommend {{selectedType === 'family_yearly' ? 'plan-selected' : ''}}" bindtap="selectPlan" data-type="family_yearly">
        <view class="plan-badge">最划算</view>
        <view class="plan-check" wx:if="{{selectedType === 'family_yearly'}}">✓</view>
        <view class="plan-name">家庭年卡</view>
        <view class="plan-price-row">
          <text class="price-symbol">¥</text>
          <text class="price-amount">{{priceFamilyYearly}}</text>
          <text class="price-unit">/年</text>
        </view>
        <text class="plan-renew">续费仅 ¥{{renewFamilyYearly}}/年</text>
        <view class="plan-tag">≈¥{{familyYearlyPerMonth}}/月</view>
        <view class="plan-features">
          <text class="feature-item">• 每月{{creditsFamilyMonthly}}次AI报告</text>
          <text class="feature-item">• 最多5只宠物</text>
          <text class="feature-item">• 最多4位家庭成员</text>
          <text class="feature-item">• 专属内容</text>
        </view>
      </view>
    </view>

    <!-- 价格说明 -->
    <view class="price-note">
      <text class="note-text" wx:if="{{upgradeMode}}">升级后月度剩余天数将叠加到年度会员中</text>
      <text class="note-text" wx:elif="{{renewMode}}">续费后有效期将延长</text>
      <view class="agreement-row" wx:else>
        <text class="note-text">开通即表示同意</text>
        <text class="agreement-link" bindtap="viewAgreement">《会员服务协议》</text>
        <text class="note-text">，会员权益立时生效</text>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-action">
      <view class="confirm-btn {{purchasing ? 'confirm-disabled' : ''}}" bindtap="confirmPurchase">
        <text>{{purchasing ? '处理中...' : (upgradeMode ? '立即升级' : (renewMode ? '确认续费' : '立即开通'))}}</text>
      </view>
    </view>
  </view>

  <!-- 支付处理覆盖层 -->
  <view class="pay-mask" wx:if="{{showPayProcessing}}" catchtouchmove="true">
    <view class="pay-dialog">
      <image class="pay-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
      <view class="pay-spinner"></view>
      <text class="pay-title">正在处理{{upgradeMode ? "升级" : (renewMode ? "续费" : "支付")}}...</text>
      <text class="pay-desc">请稍候，正在连接支付服务</text>
      <text class="pay-amount">¥{{selectedPrice}}</text>
      <text class="pay-method">微信支付（模拟）</text>
    </view>
  </view>

</view>
