/* 会员中心页面样式 */
page {
  background-color: var(--bg-secondary);
  width: 100%;
}

.container {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  transition: background 200ms ease;
}

.back-btn-active {
  background: rgba(0, 0, 0, 0.05);
}

.back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  margin-right: 6rpx;
}

.back-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.header-placeholder {
  width: 80rpx;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 内容区域 */
.content {
  padding: 20rpx 24rpx;
}

/* 会员状态卡 */
.member-card {
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.active-card {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  color: var(--bg-card);
}

.inactive-card {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.member-badge {
  margin-right: 24rpx;
}

.badge-icon {
  width: 56rpx;
  height: 56rpx;
}

.member-info {
  flex: 1;
}

.member-type {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.member-detail {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.detail-item {
  font-size: 24rpx;
  opacity: 0.9;
}

.detail-sep {
  margin: 0 12rpx;
  font-size: 24rpx;
  opacity: 0.6;
}

.highlight {
  color: #ffd700;
  font-weight: bold;
  opacity: 1;
}

/* 报告额度卡 */
.credits-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.credits-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.credits-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.credits-reset {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.credits-bar-wrapper {
  display: flex;
  align-items: center;
}

.credits-bar-bg {
  flex: 1;
  height: 16rpx;
  background: var(--border-color);
  border-radius: 8rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.credits-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.credits-num {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--brand-primary);
  min-width: 60rpx;
  text-align: right;
}

.credits-hint {
  font-size: 22rpx;
  color: var(--color-warning);
  margin-top: 8rpx;
  display: block;
}

/* 权益列表 */
.benefits-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.benefits-list {
  /* container */
}

.benefit-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-secondary);
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.blue-icon {
  background: rgba(74, 144, 226, 0.1);
}

.green-icon {
  background: rgba(82, 196, 26, 0.1);
}

.orange-icon {
  background: rgba(250, 173, 20, 0.1);
}

.purple-icon {
  background: rgba(102, 126, 234, 0.1);
}

.benefit-icon {
  width: 32rpx;
  height: 32rpx;
}

.benefit-text {
  flex: 1;
}

.benefit-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.benefit-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 操作按钮 */
.action-section {
  padding: 20rpx 0;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  color: var(--bg-card);
}

.action-btn.primary::after {
  border: none;
}

/* Additional styles for status page */
.benefit-status { color: var(--color-success); font-size: 32rpx; font-weight: bold; }
.action-btn.danger { background: var(--bg-card); color: var(--brand-emergency); border: 2rpx solid var(--brand-emergency); margin-top: 16rpx; }
.action-btn.danger::after { border: none; }
.action-btn.danger[disabled] { color: var(--text-tertiary); border-color: var(--text-tertiary); }

/* V1.5 续费到期提醒 */
.renew-reminder {
  display: flex;
  align-items: center;
  background: var(--brand-primary-light);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-warning);
}
.reminder-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.reminder-text { flex: 1; font-size: 26rpx; color: var(--color-warning); }
.reminder-link { font-size: 26rpx; color: var(--brand-primary); font-weight: bold; }

/* V1.5 自动续费卡 */
.auto-renew-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.auto-renew-row { display: flex; align-items: center; justify-content: space-between; }
.auto-renew-title { font-size: 28rpx; font-weight: bold; color: var(--text-primary); display: block; }
.auto-renew-hint { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; display: block; }
.auto-renew-detail { font-size: 22rpx; color: var(--brand-primary); margin-top: 4rpx; display: block; }

/* V1.5 会员成就卡 */
.achievement-card {
  display: flex;
  align-items: center;
  background: var(--brand-primary-light);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.achievement-item { flex: 1; text-align: center; }
.achievement-value { font-size: 40rpx; font-weight: bold; color: var(--color-warning); display: block; }
.achievement-value.saved { color: var(--brand-emergency); }
.achievement-label { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; display: block; }
.achievement-divider { width: 1rpx; height: 60rpx; background: var(--border-color); margin: 0 20rpx; }

/* V1.5 家庭成员入口 */
.family-entry {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.family-row { display: flex; align-items: center; justify-content: space-between; }
.family-info { display: flex; align-items: center; }
.family-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.family-title { font-size: 28rpx; font-weight: bold; color: var(--text-primary); }
.family-arrow { font-size: 28rpx; color: var(--border-color); }

/* V1.5 点数包入口 */
.points-entry {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.points-row { display: flex; align-items: center; justify-content: space-between; }
.points-info { display: flex; align-items: center; flex-wrap: wrap; }
.points-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.points-title { font-size: 28rpx; font-weight: bold; color: var(--text-primary); }
.points-subtitle { font-size: 22rpx; color: var(--brand-emergency); margin-left: 16rpx; }
.points-arrow { font-size: 28rpx; color: var(--border-color); }

/* V1.5 pink icon */
.pink-icon { background: rgba(235, 47, 150, 0.1); }
