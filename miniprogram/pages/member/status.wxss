/* 会员状态页面 — Warm Professionalism v2.0 */
page {
  background: var(--bg-secondary);
  width: 100%;
}

.status-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 页面头部 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx var(--spacing-lg);
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: var(--brand-primary);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  transition: opacity var(--duration-fast) var(--ease-standard);
}

.back-btn-active { opacity: 0.7; }

.back-arrow {
  width: 16rpx; height: 16rpx;
  border-left: 4rpx solid var(--text-inverse);
  border-bottom: 4rpx solid var(--text-inverse);
  transform: rotate(45deg);
  margin-right: 6rpx;
}

.back-text { font-size: var(--font-size-base); color: var(--text-inverse); }

.page-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-inverse);
}

.header-placeholder { width: 80rpx; }

/* ===== 加载状态 ===== */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: var(--font-size-base); color: var(--text-tertiary); }

/* ===== 内容区域 ===== */
.content { padding: 20rpx var(--spacing-lg); }

/* ===== 续费到期提醒 ===== */
.renew-reminder {
  display: flex;
  align-items: center;
  background: var(--brand-primary-light);
  border-radius: var(--radius-xl);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-warning);
}

.reminder-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.reminder-text { flex: 1; font-size: 26rpx; color: var(--color-warning); }
.reminder-link { font-size: 26rpx; color: var(--brand-primary); font-weight: 700; }

/* ===== 会员状态卡 ===== */
.member-card {
  border-radius: var(--radius-2xl);
  padding: 36rpx var(--spacing-xl);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.active-card {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.inactive-card {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.member-badge { margin-right: 24rpx; }
.badge-icon { width: 56rpx; height: 56rpx; filter: brightness(0) invert(1); }

.member-info { flex: 1; }

.member-type {
  font-size: var(--font-size-lg);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.member-detail {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.detail-item { font-size: var(--font-size-sm); opacity: 0.9; }
.detail-sep { margin: 0 12rpx; font-size: var(--font-size-sm); opacity: 0.6; }

.highlight {
  color: var(--color-warning);
  font-weight: 700;
  opacity: 1;
}

/* ===== 报告额度卡 ===== */
.credits-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.credits-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.credits-title { font-size: var(--font-size-base); font-weight: 700; color: var(--text-primary); }
.credits-reset { font-size: var(--font-size-xs); color: var(--text-tertiary); }

.credits-bar-wrapper { display: flex; align-items: center; }

.credits-bar-bg {
  flex: 1;
  height: 16rpx;
  background: var(--border-color);
  border-radius: var(--radius-md);
  margin-right: 16rpx;
  overflow: hidden;
}

.credits-bar-fill {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-md);
  transition: width 0.3s ease;
}

.credits-num {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--brand-primary);
  min-width: 60rpx;
  text-align: right;
}

.credits-hint {
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  margin-top: 8rpx;
  display: block;
}

/* ===== 自动续费卡 ===== */
.auto-renew-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.auto-renew-row { display: flex; align-items: center; justify-content: space-between; }
.auto-renew-title { font-size: var(--font-size-base); font-weight: 700; color: var(--text-primary); display: block; }
.auto-renew-hint { font-size: var(--font-size-xs); color: var(--text-tertiary); margin-top: 4rpx; display: block; }
.auto-renew-detail { font-size: var(--font-size-xs); color: var(--brand-primary); margin-top: 4rpx; display: block; }

/* ===== 会员成就卡 ===== */
.achievement-card {
  display: flex;
  align-items: center;
  background: var(--brand-primary-light);
  border-radius: var(--radius-xl);
  padding: 24rpx var(--spacing-xl);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.achievement-item { flex: 1; text-align: center; }
.achievement-value { font-size: var(--font-size-xl); font-weight: 700; color: var(--color-warning); display: block; }
.achievement-value.saved { color: var(--brand-emergency); }
.achievement-label { font-size: var(--font-size-xs); color: var(--text-tertiary); margin-top: 4rpx; display: block; }
.achievement-divider { width: 1rpx; height: 60rpx; background: var(--border-color); margin: 0 20rpx; }

/* ===== 家庭成员入口 ===== */
.family-entry {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-xs);
}

.family-row { display: flex; align-items: center; justify-content: space-between; }
.family-info { display: flex; align-items: center; }
.family-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.family-title { font-size: var(--font-size-base); font-weight: 700; color: var(--text-primary); }
.family-arrow { font-size: var(--font-size-base); color: var(--border-dark); }

/* ===== 点数包入口 ===== */
.points-entry {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.points-row { display: flex; align-items: center; justify-content: space-between; }
.points-info { display: flex; align-items: center; flex-wrap: wrap; }
.points-icon { width: 36rpx; height: 36rpx; margin-right: 16rpx; }
.points-title { font-size: var(--font-size-base); font-weight: 700; color: var(--text-primary); }
.points-subtitle { font-size: var(--font-size-xs); color: var(--brand-emergency); margin-left: 16rpx; }
.points-arrow { font-size: var(--font-size-base); color: var(--border-dark); }

/* ===== 权益列表 ===== */
.benefits-section {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.benefit-item:last-child { border-bottom: none; }

.benefit-icon-wrap {
  width: 64rpx; height: 64rpx;
  border-radius: var(--radius-xl);
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}

.blue-icon { background: var(--brand-primary-light); }
.green-icon { background: var(--brand-secondary-light); }
.orange-icon { background: var(--color-warning-light); }
.purple-icon { background: var(--color-info-light); }
.pink-icon { background: var(--color-danger-light); }

.benefit-icon { width: 32rpx; height: 32rpx; }

.benefit-text { flex: 1; }

.benefit-name {
  font-size: var(--font-size-base);
  color: var(--text-primary);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.benefit-desc { font-size: var(--font-size-xs); color: var(--text-tertiary); }

.benefit-status { color: var(--color-success); font-size: var(--font-size-md); font-weight: 700; }

/* ===== 操作按钮 ===== */
.action-section { padding: 20rpx 0; }

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn.primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.action-btn.primary::after { border: none; }

.action-btn.danger {
  background: var(--bg-card);
  color: var(--brand-emergency);
  border: 2rpx solid var(--brand-emergency);
  margin-top: 16rpx;
}

.action-btn.danger::after { border: none; }
.action-btn.danger[disabled] { color: var(--text-tertiary); border-color: var(--text-tertiary); }
