/* 宠物知识库列表页面样式 */
.knowledge-page {
  min-height: 100vh;
  background: #f5f6f8;
}

/* === 分类标签栏 === */
.category-bar {
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
}

.category-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.category-tab {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}

.category-tab.active {
  background: #4A90E2;
}

.category-tab:active {
  opacity: 0.8;
}

.tab-text {
  font-size: 26rpx;
  color: #666;
}

.category-tab.active .tab-text {
  color: #ffffff;
  font-weight: 600;
}

/* === 加载状态 === */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top: 6rpx solid #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* === 文章列表 === */
.articles-list {
  padding: 16rpx;
}

.article-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.article-card:active {
  background: #fafafa;
}

/* === 文章标题 === */
.article-header {
  margin-bottom: 12rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* === 文章摘要 === */
.article-summary {
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* === 卡片底部 === */
.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* === 宠物类型标签 === */
.pet-type-badge {
  padding: 4rpx 16rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #4A90E2;
}

/* === 浏览量 === */
.view-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.view-icon {
  font-size: 22rpx;
}

.view-text {
  font-size: 22rpx;
  color: #999;
}

/* === 空状态 === */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* === 底部提示 === */
.bottom-hint {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
}
