/* 宠物知识库列表页面样式 */
.knowledge-page {
  min-height: 100vh;
  background: var(--bg-secondary);
}

/* === 分类标签栏 === */
.category-bar {
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
}

.category-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.category-tab {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: var(--bg-secondary);
  flex-shrink: 0;
}

.category-tab.active {
  background: var(--brand-primary);
}

.category-tab:active {
  opacity: 0.8;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.category-tab.active .tab-text {
  color: var(--bg-card);
  font-weight: 600;
}

/* === 加载状态 === */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-color);
  border-top: 6rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* === 文章列表 === */
.articles-list {
  padding: 16rpx;
}

.article-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.article-card:active {
  background: var(--bg-secondary);
}

/* === 文章标题 === */
.article-header {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

/* V1.5 会员专享标签 */
.member-only-badge {
  display: inline-flex;
  align-items: center;
  background: var(--brand-primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.member-only-text {
  font-size: 18rpx;
  color: var(--bg-card);
  white-space: nowrap;
}

.member-icon {
  width: 20rpx;
  height: 20rpx;
}

/* === 文章摘要 === */
.article-summary {
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* === 卡片底部 === */
.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: nowrap;
}

/* === 宠物类型标签 === */
.pet-type-badge {
  padding: 4rpx 16rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.badge-text {
  font-size: 22rpx;
  color: var(--brand-primary);
}

/* === 浏览量 === */
.view-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* image 本身即 .view-icon，直接设宽高（旧 .view-icon image 选择器不匹配，导致用默认 320×240 撑乱 footer） */
.view-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.view-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* === 空状态 === */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-icon-img {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* === 底部提示 === */
.bottom-hint {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
