/* 知识库文章详情页面样式 */
.detail-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 140rpx;
}

/* === 加载状态 === */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top: 6rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* === 文章头部 === */
.article-header {
  background: #ffffff;
  padding: 32rpx 24rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* === 宠物类型标签 === */
.pet-type-tag {
  padding: 4rpx 16rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
}

.tag-text {
  font-size: 22rpx;
  color: var(--brand-primary);
}

.meta-category {
  font-size: 22rpx;
  color: #666;
}

.meta-views {
  font-size: 22rpx;
  color: #999;
}

/* === 文章正文 === */
.article-body {
  background: #ffffff;
  padding: 24rpx;
  margin-top: 16rpx;
}

/* === rich-text 内容样式 === */
.content-h2 {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #eee;
}

.content-h3 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.content-p {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.content-li {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 8rpx;
  padding-left: 24rpx;
  position: relative;
}

/* === 相关症状 === */
.related-section {
  background: #ffffff;
  padding: 24rpx;
  margin-top: 16rpx;
}

.section-title {
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.symptom-tag {
  padding: 8rpx 20rpx;
  background: #fff7e6;
  border-radius: 20rpx;
}

.symptom-tag-text {
  font-size: 24rpx;
  color: #fa8c16;
}

/* === 分享提示 === */
.share-hint {
  display: flex;
  justify-content: center;
  padding: 32rpx 24rpx 0;
}

.share-hint-text {
  font-size: 24rpx;
  color: #bbb;
}

/* === 底部间距 === */
.bottom-space {
  height: 40rpx;
}

/* === 底部操作栏 === */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background: var(--brand-primary);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active {
  background: #3a7bd5;
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}
