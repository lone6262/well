<!--宠物知识库列表页面-->
<view class="knowledge-page">

  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <image class="search-icon" src="/images/icons/search.svg" mode="aspectFit" />
      <input class="search-input"
             type="text"
             placeholder="搜索知识库..."
             placeholder-class="search-placeholder"
             value="{{searchKeyword}}"
             bindinput="onSearchInput"
             bindconfirm="onSearchConfirm" />
      <image class="clear-icon {{searchKeyword ? 'show' : ''}}"
             src="/images/icons/close.svg"
             mode="aspectFit"
             bindtap="onClearSearch" />
    </view>
    <view class="search-result-hint" wx:if="{{showSearchResult}}">
      <text class="hint-text">找到 {{totalResults}} 篇相关文章</text>
    </view>
  </view>

  <!-- 分类标签栏 -->
  <scroll-view class="category-bar" scroll-x="true" enable-flex="true">
    <view class="category-tabs">
      <view class="category-tab {{activeCategory === item ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="*this"
            bindtap="onCategoryTap"
            data-category="{{item}}">
        <text class="tab-text">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading-section" wx:if="{{loading && articles.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载文章...</text>
  </view>

  <!-- 文章列表 -->
  <view class="articles-list" wx:if="{{!loading || articles.length > 0}}">
    <view class="article-card"
          wx:for="{{articles}}"
          wx:key="_id"
          bindtap="onArticleTap"
          data-id="{{item._id}}">

      <!-- 卡片头部 -->
      <view class="article-header">
        <text class="article-title">{{item.title}}</text>
        <view class="member-only-badge" wx:if="{{item.member_only}}">
          <text class="member-only-text"><image class="member-icon" src="/images/icons/crown.svg" mode="aspectFit" /> 会员专享</text>
        </view>
      </view>

      <!-- 摘要 -->
      <view class="article-summary" wx:if="{{item.summaryText}}">
        <text class="summary-text">{{item.summaryText}}</text>
      </view>

      <!-- 卡片底部 -->
      <view class="article-footer">
        <view class="pet-type-badge">
          <text class="badge-text">{{item.petTypeText}}</text>
        </view>
        <view class="view-count">
          <image class="view-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          <text class="view-text">{{item.viewText}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-section" wx:if="{{articles.length === 0 && !loading}}">
      <image class="empty-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
      <text class="empty-title">暂无相关文章</text>
      <text class="empty-desc">换个分类看看吧</text>
    </view>

    <!-- 底部加载提示 -->
    <view class="bottom-hint" wx:if="{{articles.length > 0}}">
      <text class="hint-text" wx:if="{{loading}}">加载中...</text>
      <text class="hint-text" wx:elif="{{!hasMore}}">— 已经到底了 —</text>
    </view>
  </view>

</view>
