page { background-color: #f5f6f8; }
.container { width: 100%; max-width: 750rpx; margin: 0 auto; min-height: 100vh; box-sizing: border-box; }
.page-header { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background-color: #ffffff; border-bottom: 1rpx solid #f0f0f0; }
.back-btn { display: flex; align-items: center; padding: 10rpx 20rpx; border-radius: 28rpx; }
.back-btn-active { background: rgba(0, 0, 0, 0.05); }
.back-arrow { width: 16rpx; height: 16rpx; border-left: 4rpx solid #333; border-bottom: 4rpx solid #333; transform: rotate(45deg); -webkit-transform: rotate(45deg); margin-right: 6rpx; }
.back-text { font-size: 28rpx; color: #333; }
.page-title { font-size: 34rpx; font-weight: bold; color: #333; }
.header-placeholder { width: 80rpx; }
.content-scroll { height: calc(100vh - 88rpx); }
.content { padding: 24rpx; }
.update-date { font-size: 24rpx; color: #999; margin-bottom: 24rpx; }
.section { background: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.section-text { font-size: 26rpx; color: #666; line-height: 1.8; display: block; margin-bottom: 8rpx; }
