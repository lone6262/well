.bundle-page { background: var(--bg-secondary); min-height: 100vh; padding: 20rpx; }
.bundle-card { background: var(--bg-card); border-radius: 20rpx; margin-bottom: 24rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
.bundle-header { background: var(--brand-primary); color: #fff; padding: 30rpx; }
.bundle-name { font-size: 36rpx; font-weight: bold; }
.bundle-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.bundle-items { padding: 24rpx 30rpx; }
.bundle-item { display: flex; align-items: center; font-size: 26rpx; color: var(--text-secondary); padding: 8rpx 0; }
.bundle-item .check { color: var(--brand-primary); margin-right: 12rpx; font-weight: bold; }
.bundle-price-section { padding: 0 30rpx 20rpx; border-top: 1rpx dashed var(--border-color); padding-top: 20rpx; }
.origin-price { font-size: 24rpx; color: var(--text-tertiary); text-decoration: line-through; }
.bundle-price-row { display: flex; align-items: baseline; margin-top: 8rpx; }
.bundle-price { font-size: 48rpx; font-weight: bold; color: var(--brand-emergency); }
.save-tag { font-size: 24rpx; color: #fff; background: var(--brand-emergency); padding: 4rpx 16rpx; border-radius: 20rpx; margin-left: 16rpx; }
.buy-btn { margin: 20rpx 30rpx 30rpx; background: var(--brand-emergency); color: #fff; border-radius: 50rpx; font-size: 32rpx; }
