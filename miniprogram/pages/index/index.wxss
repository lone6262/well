/* ===================================
   现代化首页样式 (微信小程序兼容版本)
   Modern Homepage Styles
   =================================== */

@import "../../utils/ui-components.wxss";

/* === 页面容器 === */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2f5 100%);
  padding-bottom: 96rpx;
}

/* === 顶部欢迎区域 === */

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.welcome-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.welcome-content {
  flex: 1;
  z-index: 1;
}

.welcome-greeting {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.greeting-emoji {
  font-size: 40rpx;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.user-avatar-section {
  position: relative;
  margin-left: 24rpx;
  z-index: 1;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: #eeeeee;
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #F5A623;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 2rpx solid #ffffff;
}

/* === 紧急救助按钮 - 重新设计版本：简洁稳定零重叠 === */

/* 紧急按钮外层容器 */
.emergency-wrapper {
  width: 100%;
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

/* 紧急按钮主体 - 垂直居中布局 */
.emergency-big-btn {
  width: 100%;
  height: 160rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 24rpx;
  border: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(245, 87, 108, 0.3);

  /* iOS兼容性 */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* 点击效果 */
.emergency-big-btn-press {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 大图标 - 简单直接 */
.emergency-icon-large {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 8rpx;

  /* iOS兼容性 */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
}

/* 主标题 - 居中显示 */
.emergency-title-main {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 4rpx;
  text-align: center;

  /* iOS兼容性 */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 副标题 - 简洁说明 */
.emergency-desc-small {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.3;
  text-align: center;

  /* iOS兼容性 */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 脉冲动画 - 简化版本 */
.pulse-animation {
  display: block;
  animation: heartbeat 1.5s ease-in-out infinite;
  -webkit-animation: heartbeat 1.5s ease-in-out infinite;

  /* iOS兼容性 */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
    -webkit-transform: scale(1);
  }
  50% {
    transform: scale(1.15);
    -webkit-transform: scale(1.15);
  }
}

@-webkit-keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
    -webkit-transform: scale(1);
  }
  50% {
    transform: scale(1.15);
    -webkit-transform: scale(1.15);
  }
}

/* === 主要功能网格 === */

.main-features {
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.section-more {
  font-size: 24rpx;
  color: #4A90E2;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.feature-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.primary-gradient {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.success-gradient {
  background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
}

.warning-gradient {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.info-gradient {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.member-gradient {
  background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
}

.invite-gradient {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.followup-gradient {
  background: linear-gradient(135deg, #0cebeb 0%, #20e3b2 50%, #29ffc6 100%);
}

.reward-badge {
  background: rgba(255, 215, 0, 0.3);
  border: 1rpx solid rgba(255, 215, 0, 0.5);
}

.feature-icon-large {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.feature-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.feature-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.feature-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.feature-card-pressed {
  transform: scale(0.95);
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

/* === 宠物健康状态卡片 === */

.health-status-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 48rpx;
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.health-title-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.health-icon {
  font-size: 40rpx;
}

.health-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.health-refresh {
  font-size: 24rpx;
  color: #4A90E2;
  padding: 12rpx 16rpx;
  background: #e3f2fd;
  border-radius: 12rpx;
}

.pets-scroll {
  width: 100%;
}

.pets-horizontal {
  white-space: nowrap;
}

.pet-health-card {
  display: inline-block;
  width: 160rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-right: 16rpx;
  text-align: center;
  vertical-align: top;
  transition: all 0.2s ease;
  cursor: pointer;
}

.pet-health-card-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  background: #fff;
}

.pet-avatar-wrapper {
  position: relative;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: center;
}

.pet-avatar-card {
  font-size: 60rpx;
  line-height: 88rpx;
  text-align: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: #f5f5f5;
  display: inline-block;
}

.pet-avatar-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: #f5f5f5;
  object-fit: cover;
}

.pet-health-dot {
  position: absolute;
  bottom: 0;
  right: 20rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  border: 3rpx solid #ffffff;
}

.health-good {
  background: #4caf50;
}

.health-warning {
  background: #ffc107;
}

.pet-name-card {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #212121;
  margin-bottom: 8rpx;
  white-space: normal;
}

.pet-status-card {
  display: block;
  font-size: 20rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  white-space: normal;
}

.status-good {
  background: #e8f5e9;
  color: #43a047;
}

.status-warning {
  background: #fff8e1;
  color: #ffb300;
}

.pet-add-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 180rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx dashed #bdbdbd;
  vertical-align: top;
}

.add-icon-large {
  font-size: 56rpx;
  color: #9e9e9e;
  margin-bottom: 12rpx;
}

.add-pet-text {
  font-size: 24rpx;
  color: #9e9e9e;
}

/* === 附近医院快捷预览 === */

.nearby-hospitals-section {
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.section-header-nearby {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.hospital-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 40rpx;
}

.section-title-nearby {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.section-more-nearby {
  font-size: 24rpx;
  color: #4A90E2;
}

.hospitals-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hospital-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.hospital-preview-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.hospital-info-compact {
  flex: 1;
  min-width: 0;
}

.hospital-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hospital-name-compact {
  font-size: 32rpx;
  font-weight: 500;
  color: #212121;
}

.hospital-badge-compact {
  background: #ffebee;
  color: #e53935;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.hospital-details-compact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #757575;
}

.hospital-separator {
  color: #9e9e9e;
}

.hospital-action-compact {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.navigate-icon-compact {
  font-size: 40rpx;
}

/* === 底部健康提示 === */

.health-tip-card {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe8cc 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx;
  border-left: 4rpx solid #F5A623;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
}

.tip-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tip-icon {
  font-size: 40rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F5A623;
}

.tip-content {
  padding-left: 44rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #757575;
  line-height: 1.75;
}

/* === 统一设备适配 - iOS兼容优化 === */

/* === 会员 Banner === */

.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(241, 39, 17, 0.2);
}

.member-banner-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-banner-icon {
  font-size: 32rpx;
}

.member-banner-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.member-banner-action {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* === 今日科普 - 精美卡片 === */

.knowledge-daily-card {
  margin: 0 24rpx 48rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.1), 0 1rpx 3rpx rgba(0, 0, 0, 0.06);
  transition: transform 200ms ease, box-shadow 200ms ease;
}

.knowledge-daily-card-active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(102, 126, 234, 0.08);
}

/* 顶部装饰渐变条 */
.daily-card-gradient-bar {
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 30%, #f5af19 60%, #f12711 100%);
}

/* 内容区 */
.daily-card-body {
  padding: 28rpx 28rpx 24rpx;
}

/* 标签行：左badge + 右箭头 */
.daily-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.daily-card-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #667eea;
  letter-spacing: 1rpx;
}

.daily-card-arrow {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.arrow-text {
  font-size: 22rpx;
  color: #999;
}

.arrow-chevron {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #bbb;
  border-right: 3rpx solid #bbb;
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
}

/* 标题 */
.daily-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #212121;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* 摘要 */
.daily-card-summary {
  display: block;
  font-size: 24rpx;
  color: #757575;
  line-height: 1.7;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 底部标签 */
.daily-card-footer {
  display: flex;
  gap: 24rpx;
}

.daily-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #667eea;
}

.tag-dot.dot-blue {
  background: #4facfe;
}

.tag-text {
  font-size: 20rpx;
  color: #999;
}

/* === 统一设备适配 - iOS兼容优化（续） === */

/* 极小屏幕设备优化（iPhone SE等） - 专门防止文字重叠 */
@media (max-width: 321px) {
  .emergency-big-btn {
    height: 120rpx;
  }

  .emergency-icon-large {
    font-size: 40rpx;
    margin-bottom: 4rpx;
  }

  .emergency-title-main {
    font-size: 32rpx;
  }

  .emergency-desc-small {
    font-size: 20rpx;
  }
}

/* 小屏设备优化 - 保持2列布局 */
@media (max-width: 375px) {
  .welcome-section {
    padding: 32rpx 16rpx 16rpx;
  }

  .greeting-text {
    font-size: 36rpx;
  }

  /* 统一保持2列布局，避免单列显示 */
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx; /* 统一16rpx间距 */
  }

  .feature-card {
    min-height: 180rpx; /* 统一卡片高度 */
  }

  .pet-health-card {
    width: 140rpx;
  }

  .hospital-name-compact {
    font-size: 28rpx;
  }

  /* iOS优化：小屏设备紧急按钮适配 */
  .emergency-big-btn {
    height: 140rpx;
  }

  .emergency-icon-large {
    font-size: 48rpx;
    margin-bottom: 6rpx;
  }

  .emergency-title-main {
    font-size: 36rpx;
  }

  .emergency-desc-small {
    font-size: 22rpx;
  }
}

/* 大屏设备 - 统一使用iPhone标准间距 */
@media (min-width: 414px) {
  /* 强制统一间距，避免不同设备间距差异 */
  .features-grid {
    gap: 16rpx; /* 统一为iPhone的16rpx标准 */
  }

  .pet-health-card {
    width: 160rpx; /* 适中的卡片宽度 */
  }

  /* iOS优化：大屏设备紧急按钮适配 */
  .emergency-big-btn {
    height: 180rpx;
  }

  .emergency-icon-large {
    font-size: 64rpx;
    margin-bottom: 10rpx;
  }

  .emergency-title-main {
    font-size: 44rpx;
  }

  .emergency-desc-small {
    font-size: 26rpx;
  }
}

/* 横屏适配 - 保持2列布局一致性 */
@media (orientation: landscape) {
  /* 统一保持2列，避免横屏变成3列 */
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx; /* 统一间距 */
  }

  /* iOS优化：横屏紧急按钮适配 */
  .emergency-big-btn {
    height: 120rpx;
  }

  .emergency-icon-large {
    font-size: 40rpx;
    margin-bottom: 4rpx;
  }

  .emergency-title-main {
    font-size: 32rpx;
  }

  .emergency-desc-small {
    font-size: 20rpx;
  }
}

/* === 实时更新指示器样式 === */

.live-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
  animation: pulse-dot 1.5s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.2);
  }
}

.live-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hospital-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.update-time-text {
  font-size: 22rpx;
  color: #909399;
  font-weight: 400;
}

.badge-24h {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #ffffff;
}

.badge-normal {
  background: #f0f2f5;
  color: #909399;
}

/* === 医院加载状态样式 === */
.hospitals-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 16rpx 0;
}

.loading-skeleton {
  width: 100%;
  margin-bottom: 24rpx;
}

.skeleton-line {
  height: 20rpx;
  background: linear-gradient(90deg, #f0f2f5 25%, #e8eaf0 50%, #f0f2f5 75%);
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-line.short {
  width: 60%;
  animation-delay: 0.2s;
}

.loading-text {
  font-size: 24rpx;
  color: #909399;
  text-align: center;
  margin-top: 16rpx;
}

@keyframes skeleton-loading {
  0% {
    opacity: 0.3;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.3;
  }
}

.hospitals-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 16rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #909399;
}

/* === 回访提醒弹窗 — 项目统一风格 === */

.followup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.followup-modal {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.followup-modal-deco {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  text-align: center;
  font-size: 72rpx;
  padding: 32rpx 0 16rpx;
}

.followup-modal-body {
  padding: 28rpx 32rpx 32rpx;
  text-align: center;
}

.followup-modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.followup-modal-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.followup-modal-pet {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  background: #f8f9ff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 4rpx;
}

.followup-pet-name { font-size: 28rpx; font-weight: bold; color: #333; }

.followup-pet-sep { margin: 0 12rpx; color: #d9d9d9; }

.followup-pet-symptoms { font-size: 26rpx; color: #666; }

.followup-modal-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.followup-btn-later {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  color: #999;
  background: #fff;
  border: none;
  border-right: 1rpx solid #f0f0f0;
  border-radius: 0;
  text-align: center;
}

.followup-btn-later::after { border: none; }

.followup-btn-go {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: bold;
  background: #fff;
  color: #667eea;
  border: none;
  border-radius: 0;
  text-align: center;
}

.followup-btn-go::after { border: none; }
/* 设备自适应媒体查询 */
