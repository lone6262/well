/* ===================================
   宠脉AI 首页样式 v2.0
   Homepage — "Warm Professionalism"
   =================================== */

/* === 页面容器 === */

.page-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
}

/* === 顶部欢迎区域 — 纯陶土色，无渐变 === */

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  background: var(--brand-primary);
  border-radius: 0 0 var(--radius-3xl) var(--radius-3xl);
  margin-bottom: 32rpx;
}

.welcome-content {
  flex: 1;
}

.welcome-greeting {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.greeting-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.greeting-text {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--text-inverse);
}

.welcome-subtitle {
  margin-top: 4rpx;
}

.welcome-subtitle text {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* 用户头像 */
.user-avatar-section {
  position: relative;
  flex-shrink: 0;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: var(--text-inverse);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-badge-icon {
  width: 20rpx;
  height: 20rpx;
}

/* === 紧急救助按钮 — 无渐变 === */

.emergency-wrapper {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.emergency-btn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  padding: 28rpx 32rpx;
  background: var(--brand-emergency);
  border-radius: var(--radius-2xl);
  border: none;
  transition: transform var(--duration-fast) var(--ease-standard);
}

.emergency-btn::after { border: none; }

.emergency-btn-press {
  transform: scale(0.97);
  opacity: 0.95;
}

.emergency-btn-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.emergency-btn-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.emergency-btn-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.emergency-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-inverse);
}

.emergency-desc {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* === 会员 Banner — 无渐变 === */

.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 32rpx;
  padding: 20rpx 24rpx;
  background: var(--brand-primary-light);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-xl);
}

.member-banner--inactive {
  background: var(--bg-card);
}

.member-banner-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.member-banner-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-banner-icon {
  width: 28rpx;
  height: 28rpx;
}

.member-banner-text {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  font-weight: 500;
}

.member-banner-action {
  font-size: var(--font-size-sm);
  color: var(--brand-primary);
  font-weight: 500;
  flex-shrink: 0;
}

/* === 功能网格 — 白底磁贴，无渐变 === */

.main-features {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-header-icon {
  width: 28rpx;
  height: 28rpx;
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
}

.section-refresh {
  font-size: var(--font-size-sm);
  color: var(--brand-primary);
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--brand-primary);
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.update-time {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

/* 磁贴卡片 */
.tile {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tile::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.tile-pressed {
  transform: scale(0.97);
}

.tile-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-accent-primary .tile-icon-wrap { background: var(--brand-primary-light); }
.tile-accent-success .tile-icon-wrap { background: var(--color-success-light); }
.tile-accent-warning .tile-icon-wrap { background: var(--color-warning-light); }
.tile-accent-info .tile-icon-wrap { background: var(--color-info-light); }
.tile-accent-secondary .tile-icon-wrap { background: var(--brand-secondary-light); }

.tile-icon {
  width: 28rpx;
  height: 28rpx;
}

.tile-content {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.tile-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
}

.tile-desc {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.tile-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* === 宠物健康状态 === */

.health-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.pets-scroll {
  white-space: nowrap;
}

.pet-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  margin-right: 20rpx;
  padding: 24rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  border: 1rpx solid var(--border-color);
  vertical-align: top;
}

.pet-card-hover {
  transform: scale(0.97);
}

.pet-card-avatar-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.pet-card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
}

.pet-card-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-card-avatar-icon {
  width: 32rpx;
  height: 32rpx;
}

.pet-health-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  border: 3rpx solid var(--bg-card);
}

.dot-good { background: var(--color-success); }
.dot-warning { background: var(--color-warning); }

.pet-card-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.pet-card-status {
  font-size: var(--font-size-xs);
}

.status-good { color: var(--color-success); }
.status-warning { color: var(--color-warning); }

/* 添加宠物卡片 */
.pet-card-add {
  border: 2rpx dashed var(--border-color);
  background: var(--bg-secondary);
  justify-content: center;
}

.pet-card-add-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-tertiary);
  border-radius: var(--radius-full);
  background: var(--bg-card);
  margin-bottom: 8rpx;
}

.pet-card-add-text {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* === 附近医院 === */

.nearby-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.live-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  background: var(--color-success-light);
  border-radius: var(--radius-full);
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-success);
}

.live-text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--color-success);
}

.hospital-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hospital-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  border: 1rpx solid var(--border-color);
  transition: transform var(--duration-fast) var(--ease-standard);
}

.hospital-card:active {
  transform: scale(0.97);
}

.hospital-card-info {
  flex: 1;
  min-width: 0;
}

.hospital-card-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hospital-card-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-card-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.badge-24h {
  background: var(--color-danger-light);
  color: var(--brand-emergency);
}

.badge-normal {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.hospital-card-details {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hospital-card-distance {
  font-size: var(--font-size-sm);
  color: var(--brand-primary);
  font-weight: 500;
}

.hospital-card-sep {
  color: var(--text-tertiary);
}

.hospital-card-address {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-card-action {
  width: 56rpx;
  height: 56rpx;
  background: var(--brand-primary-light);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.hospital-card-nav-icon {
  width: 28rpx;
  height: 28rpx;
}

/* === 今日科普卡片 — 无彩虹渐变 === */

.daily-card {
  margin: 0 32rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease-standard);
}

.daily-card-active {
  transform: scale(0.98);
}

.daily-card-bar {
  height: 4rpx;
  background: var(--brand-primary);
}

.daily-card-body {
  padding: 24rpx 28rpx;
}

.daily-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.daily-card-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.daily-card-badge-icon {
  width: 24rpx;
  height: 24rpx;
}

.daily-card-badge-label {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--brand-primary);
}

.daily-card-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.daily-card-link-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.daily-card-link-arrow {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
}

.daily-card-title {
  display: block;
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  margin-bottom: 8rpx;
}

.daily-card-summary {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  line-height: var(--line-height-relaxed);
  margin-bottom: 16rpx;
}

.daily-card-tags {
  display: flex;
  gap: 20rpx;
}

.daily-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.daily-tag-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
}

.daily-tag-dot--alt {
  background: var(--color-info);
}

.daily-tag-text {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* === 健康提示卡片（降级） === */

.tip-card {
  margin: 0 32rpx 40rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  border: 1rpx solid var(--border-color);
}

.tip-card-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.tip-card-icon {
  width: 24rpx;
  height: 24rpx;
}

.tip-card-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--brand-primary);
}

.tip-card-text {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  line-height: var(--line-height-relaxed);
}

/* === 回访提醒弹窗 === */

.followup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-modal-backdrop);
}

.followup-modal {
  width: 600rpx;
  background: var(--bg-card);
  border-radius: var(--radius-3xl);
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
}

.followup-modal-icon {
  margin-bottom: 24rpx;
}

.followup-modal-paw {
  width: 64rpx;
  height: 64rpx;
}

.followup-modal-title {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.followup-modal-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  line-height: var(--line-height-relaxed);
  margin-bottom: 20rpx;
}

.followup-modal-pet {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--brand-primary-light);
  border-radius: var(--radius-full);
}

.followup-pet-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--brand-primary);
}

.followup-pet-sep {
  color: var(--text-tertiary);
}

.followup-pet-symptoms {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.followup-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.followup-btn-later {
  flex: 1;
  height: 80rpx;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-base);
  font-weight: 500;
  border: none;
  line-height: 80rpx;
}

.followup-btn-later::after { border: none; }

.followup-btn-go {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-base);
  font-weight: 500;
  border: none;
  line-height: 80rpx;
}

.followup-btn-go::after { border: none; }

.followup-btn-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}
