/* ===================================
   现代化首页样式 (微信小程序兼容版本)
   Modern Homepage Styles
   =================================== */

@import "../../utils/ui-components.wxss";

/* === 页面容器 === */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2f5 100%);
  padding-bottom: 96rpx;
}

/* === 顶部欢迎区域 === */

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.welcome-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.welcome-content {
  flex: 1;
  z-index: 1;
}

.welcome-greeting {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.greeting-emoji {
  font-size: 40rpx;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.user-avatar-section {
  position: relative;
  margin-left: 24rpx;
  z-index: 1;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: #eeeeee;
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #F5A623;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 2rpx solid #ffffff;
}

/* === 现代化紧急按钮 - 优化排版 === */

.emergency-modern {
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.emergency-btn-modern {
  width: 100%;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  border: none;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

.emergency-btn-modern::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, transparent 100%);
}

.emergency-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  gap: 16rpx;
}

.emergency-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.emergency-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.emergency-icon-large {
  font-size: 48rpx;
}

.pulse-animation {
  animation: heartbeat 1.5s ease-in-out infinite;
  display: block;
}

@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.15);
  }
}

.emergency-text-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.emergency-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.emergency-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.3;
}

.emergency-arrow-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.emergency-arrow-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
  white-space: nowrap;
}

.emergency-arrow {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
}

.emergency-btn-pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

/* === 主要功能网格 === */

.main-features {
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.section-more {
  font-size: 24rpx;
  color: #4A90E2;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.feature-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.primary-gradient {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.success-gradient {
  background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
}

.warning-gradient {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.info-gradient {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.feature-icon-large {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.feature-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.feature-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.feature-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.feature-card-pressed {
  transform: scale(0.95);
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

/* === 宠物健康状态卡片 === */

.health-status-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 48rpx;
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.health-title-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.health-icon {
  font-size: 40rpx;
}

.health-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.health-refresh {
  font-size: 24rpx;
  color: #4A90E2;
  padding: 12rpx 16rpx;
  background: #e3f2fd;
  border-radius: 12rpx;
}

.pets-scroll {
  width: 100%;
}

.pets-horizontal {
  white-space: nowrap;
}

.pet-health-card {
  display: inline-block;
  width: 160rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-right: 16rpx;
  text-align: center;
  vertical-align: top;
  transition: all 0.2s ease;
  cursor: pointer;
}

.pet-health-card-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  background: #fff;
}

.pet-avatar-wrapper {
  position: relative;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: center;
}

.pet-avatar-card {
  font-size: 60rpx;
  line-height: 88rpx;
  text-align: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: #f5f5f5;
  display: inline-block;
}

.pet-avatar-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: #f5f5f5;
  object-fit: cover;
}

.pet-health-dot {
  position: absolute;
  bottom: 0;
  right: 20rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  border: 3rpx solid #ffffff;
}

.health-good {
  background: #4caf50;
}

.health-warning {
  background: #ffc107;
}

.pet-name-card {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #212121;
  margin-bottom: 8rpx;
  white-space: normal;
}

.pet-status-card {
  display: block;
  font-size: 20rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  white-space: normal;
}

.status-good {
  background: #e8f5e9;
  color: #43a047;
}

.status-warning {
  background: #fff8e1;
  color: #ffb300;
}

.pet-add-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 180rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx dashed #bdbdbd;
  vertical-align: top;
}

.add-icon-large {
  font-size: 56rpx;
  color: #9e9e9e;
  margin-bottom: 12rpx;
}

.add-pet-text {
  font-size: 24rpx;
  color: #9e9e9e;
}

/* === 附近医院快捷预览 === */

.nearby-hospitals-section {
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.section-header-nearby {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.hospital-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 40rpx;
}

.section-title-nearby {
  font-size: 36rpx;
  font-weight: 700;
  color: #212121;
}

.section-more-nearby {
  font-size: 24rpx;
  color: #4A90E2;
}

.hospitals-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hospital-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.hospital-preview-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.hospital-info-compact {
  flex: 1;
  min-width: 0;
}

.hospital-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hospital-name-compact {
  font-size: 32rpx;
  font-weight: 500;
  color: #212121;
}

.hospital-badge-compact {
  background: #ffebee;
  color: #e53935;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.hospital-details-compact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #757575;
}

.hospital-separator {
  color: #9e9e9e;
}

.hospital-action-compact {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.navigate-icon-compact {
  font-size: 40rpx;
}

/* === 底部健康提示 === */

.health-tip-card {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe8cc 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx;
  border-left: 4rpx solid #F5A623;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
}

.tip-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tip-icon {
  font-size: 40rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F5A623;
}

.tip-content {
  padding-left: 44rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #757575;
  line-height: 1.75;
}

/* === 响应式适配 === */

@media (max-width: 375px) {
  .welcome-section {
    padding: 32rpx 16rpx 16rpx;
  }

  .greeting-text {
    font-size: 36rpx;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: auto;
  }

  .pet-health-card {
    width: 140rpx;
  }

  .hospital-name-compact {
    font-size: 28rpx;
  }
}

@media (min-width: 414px) {
  .features-grid {
    gap: 24rpx;
  }

  .pet-health-card {
    width: 180rpx;
  }
}

/* === 横屏适配 === */

@media (orientation: landscape) {
  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .emergency-btn-modern {
    min-height: 100rpx;
  }
}

/* === 实时更新指示器样式 === */

.live-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
  animation: pulse-dot 1.5s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.2);
  }
}

.live-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hospital-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.update-time-text {
  font-size: 22rpx;
  color: #909399;
  font-weight: 400;
}

.badge-24h {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #ffffff;
}

.badge-normal {
  background: #f0f2f5;
  color: #909399;
}