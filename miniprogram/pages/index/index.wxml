<!--首页-->
<view class="container">
  <!-- 顶部急救按钮 -->
  <view class="emergency-section">
    <button class="emergency-btn" bindtap="toEmergency" hover-class="emergency-btn-hover">
      <view class="emergency-content">
        <text class="emergency-icon">🚨</text>
        <view class="emergency-text-group">
          <text class="emergency-title">宠物急症/误食</text>
          <text class="emergency-subtitle">一键救命通道</text>
        </view>
      </view>
    </button>
  </view>

  <!-- 症状自查卡片 -->
  <view class="card-section">
    <view class="card">
      <view class="card-title">🩺 症状自查</view>
      <view class="card-content">
        <text class="card-desc">快速评估宠物健康状况</text>
        <text class="card-desc">获取专业建议和风险分级</text>
      </view>
      <button class="primary-btn" bindtap="toSymptom" hover-class="btn-hover">
        <text>开始自查 →</text>
      </button>
    </view>
  </view>

  <!-- 就医导航卡片 -->
  <view class="card-section">
    <view class="card">
      <view class="card-title">🏥 附近宠物医院</view>
      <view class="card-content">
        <text class="card-desc">快速找到附近的宠物医院</text>
        <text class="card-desc">获取导航和联系方式</text>
      </view>
      <button class="secondary-btn" bindtap="toHospital" hover-class="btn-hover">
        <text>查看医院 →</text>
      </button>
    </view>
  </view>

  <!-- 附近医院预览（占位） -->
  <view class="hospital-preview">
    <view class="preview-title">附近24小时医院</view>
    <view class="hospital-list">
      <view class="hospital-item" wx:for="{{nearbyHospitals}}" wx:key="id">
        <view class="hospital-name">{{item.name}}</view>
        <view class="hospital-distance">{{item.distance}}km</view>
      </view>
    </view>
  </view>
</view>