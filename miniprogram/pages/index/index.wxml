<!--现代化首页设计 Modern Homepage Design-->
<view class="page-container">

  <!-- 顶部欢迎区域 -->
  <view class="welcome-section">
    <view class="welcome-content">
      <view class="welcome-greeting">
        <text class="greeting-emoji">👋</text>
        <text class="greeting-text">你好，宠物主人</text>
      </view>
      <view class="welcome-subtitle">
        <text>保护爱宠健康，从日常关注开始</text>
      </view>
    </view>

    <!-- 用户头像 -->
    <view class="user-avatar-section" bindtap="toUser">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" />
      <view class="avatar-badge">🐾</view>
    </view>
  </view>

  <!-- 紧急救助通道 - 重新设计版本：简洁大按钮 -->
  <view class="emergency-wrapper">
    <button class="emergency-big-btn" bindtap="toEmergency" hover-class="emergency-big-btn-press">
      <view class="emergency-icon-large pulse-animation">🚨</view>
      <view class="emergency-title-main">紧急救助</view>
      <view class="emergency-desc-small">24小时一键求助</view>
    </button>
  </view>

  <!-- 会员 Banner -->
  <view class="member-banner" wx:if="{{isMember}}" bindtap="goToMember">
    <view class="member-banner-content">
      <text class="member-banner-icon">👑</text>
      <text class="member-banner-text">会员特权已激活 · 剩余{{memberDaysRemaining}}天</text>
    </view>
    <text class="member-banner-action">查看权益 ›</text>
  </view>

  <!-- 非会员引导 Banner -->
  <view class="member-banner member-banner-inactive" wx:if="{{!isMember}}" bindtap="goToMember">
    <view class="member-banner-content">
      <text class="member-banner-icon">⭐</text>
      <text class="member-banner-text">开通会员，AI报告低至¥1/次</text>
    </view>
    <text class="member-banner-action">立即开通 ›</text>
  </view>

  <!-- 主要功能网格 -->
  <view class="main-features" role="navigation" aria-label="快捷功能">
    <view class="section-header">
      <text class="section-title">快速服务</text>
      <text class="section-more" bindtap="showMoreFeatures">查看全部 →</text>
    </view>

    <view class="features-grid">
      <!-- 症状自查 -->
      <view class="feature-card primary-gradient" bindtap="toSymptom" hover-class="feature-card-pressed" aria-label="症状自查">
        <view class="feature-icon-large">🩺</view>
        <view class="feature-content">
          <text class="feature-title">症状自查</text>
          <text class="feature-desc">智能评估健康</text>
        </view>
        <view class="feature-badge">AI</view>
      </view>

      <!-- 附近医院 -->
      <view class="feature-card success-gradient" bindtap="toHospital" hover-class="feature-card-pressed" aria-label="附近医院">
        <view class="feature-icon-large">🏥</view>
        <view class="feature-content">
          <text class="feature-title">附近医院</text>
          <text class="feature-desc">快速定位导航</text>
        </view>
        <view class="feature-badge">MAP</view>
      </view>

      <!-- 健康档案 -->
      <view class="feature-card warning-gradient" bindtap="toPetProfile" hover-class="feature-card-pressed" aria-label="健康档案">
        <view class="feature-icon-large">📋</view>
        <view class="feature-content">
          <text class="feature-title">健康档案</text>
          <text class="feature-desc">记录成长点滴</text>
        </view>
        <view class="feature-badge">NEW</view>
      </view>

      <!-- 科普知识 -->
      <view class="feature-card info-gradient" bindtap="toKnowledge" hover-class="feature-card-pressed" aria-label="科普知识">
        <view class="feature-icon-large">📚</view>
        <view class="feature-content">
          <text class="feature-title">科普知识</text>
          <text class="feature-desc">专业养宠指南</text>
        </view>
        <view class="feature-badge">HOT</view>
      </view>

      <!-- 会员中心 -->
      <view class="feature-card member-gradient" bindtap="goToMember" hover-class="feature-card-pressed" aria-label="会员中心">
        <view class="feature-icon-large">👑</view>
        <view class="feature-content">
          <text class="feature-title">会员中心</text>
          <text class="feature-desc">专属权益</text>
        </view>
        <view class="feature-badge" wx:if="{{isMember}}">VIP</view>
      </view>

      <!-- 邀请好友 -->
      <view class="feature-card invite-gradient" bindtap="goToInvite" hover-class="feature-card-pressed" aria-label="邀请好友">
        <view class="feature-icon-large">🎁</view>
        <view class="feature-content">
          <text class="feature-title">邀请好友</text>
          <text class="feature-desc">双方获奖</text>
        </view>
        <view class="feature-badge reward-badge">奖</view>
      </view>

      <!-- 回访记录 -->
      <view class="feature-card followup-gradient" bindtap="goToFollowupList" hover-class="feature-card-pressed" aria-label="回访记录">
        <view class="feature-icon-large">📝</view>
        <view class="feature-content">
          <text class="feature-title">回访记录</text>
          <text class="feature-desc">追踪恢复情况</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 宠物健康状态卡片 -->
  <view class="health-status-card">
    <view class="health-header">
      <view class="health-title-section">
        <text class="health-icon">💚</text>
        <text class="health-title">宠物健康状态</text>
      </view>
      <text class="health-refresh" bindtap="refreshHealthStatus">刷新</text>
    </view>

    <view class="pets-scroll">
      <scroll-view class="pets-horizontal" scroll-x="true" show-scrollbar="false">
        <view class="pet-health-card" wx:for="{{petsList}}" wx:key="id" bindtap="viewPetDetail" data-pet-id="{{item.id}}" data-pet-name="{{item.name}}" hover-class="pet-health-card-hover">
          <view class="pet-avatar-wrapper">
            <!-- 真实头像或emoji头像 -->
            <image wx:if="{{item.isRealAvatar}}" class="pet-avatar-image" src="{{item.avatar}}" mode="aspectFill"/>
            <text wx:else class="pet-avatar-card">{{item.avatar}}</text>
            <view class="pet-health-dot {{item.healthStatus === 'good' ? 'health-good' : 'health-warning'}}"></view>
          </view>
          <text class="pet-name-card">{{item.name}}</text>
          <text class="pet-status-card {{item.healthStatus === 'good' ? 'status-good' : 'status-warning'}}">
            {{item.healthStatus === 'good' ? '状态良好' : '需要关注'}}
          </text>
        </view>

        <!-- 添加宠物按钮 -->
        <view class="pet-add-card" bindtap="addPet">
          <view class="add-icon-large">+</view>
          <text class="add-pet-text">添加宠物</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 附近医院快捷预览 -->
  <view class="nearby-hospitals-section">
    <view class="section-header-nearby">
      <view class="hospital-header-left">
        <text class="section-icon">📍</text>
        <text class="section-title-nearby">附近24小时医院</text>
        <view class="live-indicator">
          <view class="live-dot"></view>
          <text class="live-text">实时</text>
        </view>
      </view>
      <view class="hospital-header-right">
        <text class="update-time-text">{{lastUpdateTime || '更新中...'}}</text>
        <text class="section-more-nearby" bindtap="toHospital">查看更多 →</text>
      </view>
    </view>

    <view class="hospitals-preview-list">
      <state-view
        wx:if="{{isLoadingHospitals && nearbyHospitals.length === 0}}"
        type="loading"
        title="正在定位附近医院..."
        card="{{true}}"
      />

      <!-- 医院列表显示 -->
      <view class="hospital-preview-card" wx:for="{{nearbyHospitals}}" wx:key="id" bindtap="navigateToHospital" data-hospital="{{item}}">
        <view class="hospital-info-compact">
          <view class="hospital-name-row">
            <text class="hospital-name-compact">{{item.name}}</text>
            <view class="hospital-badge-compact {{item.is24h ? 'badge-24h' : 'badge-normal'}}">{{item.is24h ? '24H' : '常规'}}</view>
          </view>
          <view class="hospital-details-compact">
            <text class="hospital-distance-compact">{{item.distance}}</text>
            <text class="hospital-separator">·</text>
            <text class="hospital-address-compact">{{item.address}}</text>
          </view>
        </view>
        <view class="hospital-action-compact">
          <view class="navigate-icon-compact">🧭</view>
        </view>
      </view>

      <state-view
        wx:if="{{!isLoadingHospitals && nearbyHospitals.length === 0}}"
        type="empty"
        icon="🏥"
        title="暂无附近医院数据"
        description="请检查定位权限或稍后重试"
        card="{{true}}"
      />
    </view>
  </view>

  <!-- 今日科普 - 精美卡片 -->
  <view class="knowledge-daily-card" bindtap="toKnowledgeDetail" data-id="{{dailyKnowledge._id}}" wx:if="{{dailyKnowledge}}" hover-class="knowledge-daily-card-active">
    <!-- 顶部装饰渐变条 -->
    <view class="daily-card-gradient-bar"></view>
    <!-- 内容区 -->
    <view class="daily-card-body">
      <!-- 标签行 -->
      <view class="daily-card-top">
        <view class="daily-card-badge">
          <text class="badge-icon">📖</text>
          <text class="badge-label">今日科普</text>
        </view>
        <view class="daily-card-arrow">
          <text class="arrow-text">阅读全文</text>
          <view class="arrow-chevron"></view>
        </view>
      </view>
      <!-- 标题 -->
      <text class="daily-card-title">{{dailyKnowledge.title}}</text>
      <!-- 摘要 -->
      <text class="daily-card-summary" wx:if="{{dailyKnowledge.summary}}">{{dailyKnowledge.summary}}</text>
      <!-- 底部标签 -->
      <view class="daily-card-footer">
        <view class="daily-tag">
          <text class="tag-dot"></text>
          <text class="tag-text">专业知识</text>
        </view>
        <view class="daily-tag">
          <text class="tag-dot dot-blue"></text>
          <text class="tag-text">每日更新</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 健康提示（无科普数据时降级显示） -->
  <view class="health-tip-card" wx:if="{{!dailyKnowledge}}">
    <view class="tip-header">
      <text class="tip-icon">💡</text>
      <text class="tip-title">今日健康提示</text>
    </view>
    <view class="tip-content">
      <text class="tip-text">{{dailyTip}}</text>
    </view>
  </view>

  <!-- 回访提醒弹窗 — 温馨治愈风 -->
  <view class="followup-mask" wx:if="{{showFollowupPopup}}" bindtap="closeFollowupPopup">
    <view class="followup-modal" catchtap="">
      <view class="followup-modal-deco">🐾</view>
      <view class="followup-modal-body">
        <text class="followup-modal-title">宝贝恢复了吗？</text>
        <text class="followup-modal-subtitle">告诉我们的恢复情况，帮助更好地照顾它</text>
        <view class="followup-modal-pet" wx:if="{{pendingFollowup}}">
          <text class="followup-pet-name">{{pendingFollowup.pet_name || '宠物'}}</text>
          <text class="followup-pet-sep">·</text>
          <text class="followup-pet-symptoms">{{pendingFollowup.symptom_list || '症状自查'}}</text>
        </view>
      </view>
      <view class="followup-modal-actions">
        <button class="followup-btn-later" bindtap="closeFollowupPopup">稍后再说</button>
        <button class="followup-btn-go" bindtap="goToFollowup">🐾 去反馈</button>
      </view>
    </view>
  </view>

</view>