<!--Mewora 宠物AI助手 首页 — Warm Professionalism v2.0-->
<view class="page-container">

  <!-- 顶部欢迎区域 -->
  <view class="welcome-section">
    <view class="welcome-content">
      <view class="welcome-greeting">
        <image class="greeting-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="品牌图标" />
        <text class="greeting-text">你好，宠物主人</text>
      </view>
      <view class="welcome-subtitle">
        <text>保护爱宠健康，从日常关注开始</text>
      </view>
    </view>

    <!-- 右上角操作区 -->
    <view class="top-actions">
      <!-- Phase 1.5: 反馈入口 -->
      <view class="feedback-entry" bindtap="toFeedback" aria-label="反馈">
        <image class="feedback-entry-icon" src="/images/icons/customer-service.svg" mode="aspectFit" />
      </view>
      <!-- 用户头像 -->
      <view class="user-avatar-section" bindtap="toUser">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" />
      <view class="avatar-badge">
        <image class="avatar-badge-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="宠物标识" />
      </view>
    </view>
    </view>
  </view>

  <!-- 紧急救助通道 -->
  <view class="emergency-wrapper">
    <button class="emergency-btn" bindtap="toEmergency" hover-class="emergency-btn-press">
      <view class="emergency-btn-icon-wrap pulse-subtle">
        <image class="emergency-btn-icon" src="/images/icons/alert.svg" mode="aspectFit" aria-label="急救" />
      </view>
      <view class="emergency-btn-text">
        <text class="emergency-title">紧急救助</text>
        <text class="emergency-desc">24小时一键求助</text>
      </view>
    </button>
  </view>

  <!-- 会员 Banner -->
  <view class="member-banner" wx:if="{{isMember}}" bindtap="goToMember">
    <view class="member-banner-content">
      <view class="member-banner-icon-wrap">
        <image class="member-banner-icon" src="/images/icons/crown.svg" mode="aspectFit" aria-label="会员" />
      </view>
      <text class="member-banner-text">会员特权已激活 · 剩余{{memberDaysRemaining}}天</text>
    </view>
    <text class="member-banner-action">查看权益 ›</text>
  </view>

  <!-- 非会员引导 Banner -->
  <view class="member-banner member-banner--inactive" wx:if="{{!isMember}}" bindtap="goToMember">
    <view class="member-banner-content">
      <view class="member-banner-icon-wrap">
        <image class="member-banner-icon" src="/images/icons/crown.svg" mode="aspectFit" aria-label="开通会员" />
      </view>
      <text class="member-banner-text">开通会员，AI报告低至¥{{firstReportDisplay}}/次</text>
    </view>
    <text class="member-banner-action">立即开通 ›</text>
  </view>

  <!-- 主要功能网格 -->
  <view class="main-features" role="navigation" aria-label="快捷功能">
    <view class="section-header">
      <text class="section-title">快速服务</text>
    </view>

    <view class="features-grid">
      <!-- 养宠工具（受 enable_tools 开关控制） -->
      <view class="tile tile-accent-info" bindtap="toToolsHub" hover-class="tile-pressed" aria-label="养宠工具" wx:if="{{flags.enableTools}}">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="养宠工具" />
        </view>
        <view class="tile-content">
          <text class="tile-title">养宠工具</text>
          <text class="tile-desc">年龄换算/食物安全</text>
        </view>
      </view>


      <!-- 症状自查 -->
      <view class="tile tile-accent-primary" bindtap="toSymptom" hover-class="tile-pressed" aria-label="症状自查">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/stethoscope.svg" mode="aspectFit" aria-label="症状自查" />
        </view>
        <view class="tile-content">
          <text class="tile-title">症状自查</text>
          <text class="tile-desc">智能评估健康</text>
        </view>
        <view class="tile-badge">AI</view>
      </view>

      <!-- 附近医院 -->
      <view class="tile tile-accent-info" bindtap="toHospital" hover-class="tile-pressed" aria-label="附近医院">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/hospital.svg" mode="aspectFit" aria-label="附近医院" />
        </view>
        <view class="tile-content">
          <text class="tile-title">附近医院</text>
          <text class="tile-desc">快速定位导航</text>
        </view>
      </view>

      <!-- 健康档案 -->
      <view class="tile tile-accent-success" bindtap="toPetProfile" hover-class="tile-pressed" aria-label="健康档案">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="健康档案" />
        </view>
        <view class="tile-content">
          <text class="tile-title">健康档案</text>
          <text class="tile-desc">记录成长点滴</text>
        </view>
      </view>

      <!-- 科普知识 -->
      <view class="tile tile-accent-secondary" bindtap="toKnowledge" hover-class="tile-pressed" aria-label="科普知识">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="科普知识" />
        </view>
        <view class="tile-content">
          <text class="tile-title">科普知识</text>
          <text class="tile-desc">专业养宠指南</text>
        </view>
      </view>

      <!-- 会员中心 -->
      <view class="tile tile-accent-warning" bindtap="goToMember" hover-class="tile-pressed" aria-label="会员中心">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/crown.svg" mode="aspectFit" aria-label="会员中心" />
        </view>
        <view class="tile-content">
          <text class="tile-title">会员中心</text>
          <text class="tile-desc">专属权益</text>
        </view>
        <view class="tile-badge" wx:if="{{isMember}}">VIP</view>
      </view>

      <!-- 邀请好友 -->
      <view class="tile tile-accent-primary" bindtap="goToInvite" hover-class="tile-pressed" aria-label="邀请好友">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/gift.svg" mode="aspectFit" aria-label="邀请好友" />
        </view>
        <view class="tile-content">
          <text class="tile-title">邀请好友</text>
          <text class="tile-desc">双方获奖</text>
        </view>
      </view>

      <!-- 回访记录 -->
      <view class="tile tile-accent-info" bindtap="goToFollowupList" hover-class="tile-pressed" aria-label="回访记录">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="回访记录" />
        </view>
        <view class="tile-content">
          <text class="tile-title">回访记录</text>
          <text class="tile-desc">追踪恢复情况</text>
        </view>
      </view>

      <!-- 宠物日记（V1.5.5 常驻入口，仅看 enable_diary 开关，不依赖今日有无日记） -->
      <view class="tile tile-accent-primary" bindtap="goToDiary" hover-class="tile-pressed" aria-label="宠物日记" wx:if="{{flags.enableDiary}}">
        <view class="tile-icon-wrap">
          <image class="tile-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="宠物日记" />
        </view>
        <view class="tile-content">
          <text class="tile-title">宠物日记</text>
          <text class="tile-desc">毛孩子的每一天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 陪伴卡（今日宠物日记） -->
  <view class="daily-card companion-card" bindtap="toDiaryDetail" data-id="{{todayDiary._id}}" wx:if="{{flags.enableDiary && todayDiary}}" hover-class="daily-card-active">
    <view class="daily-card-bar companion-card-bar"></view>
    <view class="daily-card-body">
      <view class="daily-card-top">
        <view class="daily-card-badge">
          <image class="daily-card-badge-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="日记" />
          <text class="daily-card-badge-label">{{todayDiary.petName}}今天想告诉你</text>
        </view>
        <view class="daily-card-link">
          <text class="daily-card-link-text">查看全部</text>
          <text class="daily-card-link-arrow">›</text>
        </view>
      </view>
      <text class="daily-card-title companion-card-text">{{todayDiary.content}}</text>
    </view>
  </view>

  <!-- 宠物健康状态卡片 -->
  <view class="health-section">
    <view class="section-header">
      <view class="section-header-left">
        <image class="section-header-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="健康" />
        <text class="section-title">宠物健康状态</text>
      </view>
      <text class="section-refresh" bindtap="refreshHealthStatus">刷新</text>
    </view>

    <scroll-view class="pets-scroll" scroll-x="true" show-scrollbar="false">
      <view class="pet-card" wx:for="{{petsList}}" wx:key="id" bindtap="viewPetDetail" data-pet-id="{{item.id}}" data-pet-name="{{item.name}}" hover-class="pet-card-hover">
        <view class="pet-card-avatar-wrap">
          <image wx:if="{{item.isRealAvatar}}" class="pet-card-avatar" src="{{item.avatar}}" mode="aspectFill"/>
          <view wx:else class="pet-card-avatar-fallback">
            <image class="pet-card-avatar-icon" src="{{item.petType === 'cat' ? '/images/icons/paw.svg' : '/images/icons/paw.svg'}}" mode="aspectFit" />
          </view>
          <view class="pet-health-dot {{item.healthStatus === 'good' ? 'dot-good' : 'dot-warning'}}"></view>
        </view>
        <text class="pet-card-name">{{item.name}}</text>
        <text class="pet-card-status {{item.healthStatus === 'good' ? 'status-good' : 'status-warning'}}">
          {{item.healthStatus === 'good' ? '状态良好' : '需要关注'}}
        </text>
      </view>

      <!-- 添加宠物 -->
      <view class="pet-card pet-card-add" bindtap="addPet">
        <view class="pet-card-add-icon">+</view>
        <text class="pet-card-add-text">添加宠物</text>
      </view>
    </scroll-view>
  </view>

  <!-- 附近医院快捷预览 -->
  <view class="nearby-section">
    <view class="section-header">
      <view class="section-header-left">
        <image class="section-header-icon" src="/images/icons/pin.svg" mode="aspectFit" aria-label="定位" />
        <text class="section-title">附近24小时医院</text>
        <view class="live-tag">
          <view class="live-dot"></view>
          <text class="live-text">实时</text>
        </view>
      </view>
      <view class="section-header-right">
        <text class="update-time">{{lastUpdateTime || '更新中...'}}</text>
        <text class="section-more" bindtap="toHospital">更多 ›</text>
      </view>
    </view>

    <view class="hospital-list">
      <state-view
        wx:if="{{isLoadingHospitals && nearbyHospitals.length === 0}}"
        type="loading"
        title="正在定位附近医院..."
        card="{{true}}"
      />

      <view class="hospital-card" wx:for="{{nearbyHospitals}}" wx:key="id" bindtap="navigateToHospital" data-hospital="{{item}}">
        <view class="hospital-card-info">
          <view class="hospital-card-name-row">
            <text class="hospital-card-name">{{item.name}}</text>
            <view class="hospital-card-badge {{item.is24h ? 'badge-24h' : 'badge-normal'}}">{{item.is24h ? '24H' : '常规'}}</view>
          </view>
          <view class="hospital-card-details">
            <text class="hospital-card-distance">{{item.distance}}</text>
            <text class="hospital-card-sep">·</text>
            <text class="hospital-card-address">{{item.address}}</text>
          </view>
        </view>
        <view class="hospital-card-action">
          <image class="hospital-card-nav-icon" src="/images/icons/compass.svg" mode="aspectFit" aria-label="导航" />
        </view>
      </view>

      <state-view
        wx:if="{{!isLoadingHospitals && nearbyHospitals.length === 0}}"
        type="empty"
        icon="hospital"
        title="暂无附近医院数据"
        description="请检查定位权限或稍后重试"
        card="{{true}}"
      />
    </view>
  </view>

  <!-- 今日科普 -->
  <view class="daily-card" bindtap="toKnowledgeDetail" data-id="{{dailyKnowledge._id}}" wx:if="{{dailyKnowledge}}" hover-class="daily-card-active">
    <view class="daily-card-bar"></view>
    <view class="daily-card-body">
      <view class="daily-card-top">
        <view class="daily-card-badge">
          <image class="daily-card-badge-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="科普" />
          <text class="daily-card-badge-label">今日科普</text>
        </view>
        <view class="daily-card-link">
          <text class="daily-card-link-text">阅读全文</text>
          <text class="daily-card-link-arrow">›</text>
        </view>
      </view>
      <text class="daily-card-title">{{dailyKnowledge.title}}</text>
      <text class="daily-card-summary" wx:if="{{dailyKnowledge.summary}}">{{dailyKnowledge.summary}}</text>
      <view class="daily-card-tags">
        <view class="daily-tag">
          <view class="daily-tag-dot"></view>
          <text class="daily-tag-text">专业知识</text>
        </view>
        <view class="daily-tag">
          <view class="daily-tag-dot daily-tag-dot--alt"></view>
          <text class="daily-tag-text">每日更新</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 健康提示（降级） -->
  <view class="tip-card" wx:if="{{!dailyKnowledge}}">
    <view class="tip-card-header">
      <image class="tip-card-icon" src="/images/icons/alert.svg" mode="aspectFit" aria-label="提示" />
      <text class="tip-card-title">今日健康提示</text>
    </view>
    <view class="tip-card-body">
      <text class="tip-card-text">{{dailyTip}}</text>
    </view>
  </view>

  <!-- 回访提醒弹窗 -->
  <view class="followup-mask" wx:if="{{showFollowupPopup}}" bindtap="closeFollowupPopup">
    <view class="followup-modal" catchtap="">
      <view class="followup-modal-icon">
        <image class="followup-modal-paw" src="/images/icons/paw.svg" mode="aspectFit" aria-label="宠物" />
      </view>
      <view class="followup-modal-body">
        <text class="followup-modal-title">宝贝恢复了吗？</text>
        <text class="followup-modal-subtitle">告诉我们恢复情况，帮助更好地照顾它</text>
        <view class="followup-modal-pet" wx:if="{{pendingFollowup}}">
          <text class="followup-pet-name">{{pendingFollowup.pet_name || '宠物'}}</text>
          <text class="followup-pet-sep">·</text>
          <text class="followup-pet-symptoms">{{pendingFollowup.symptom_list || '症状自查'}}</text>
        </view>
      </view>
      <view class="followup-modal-actions">
        <button class="followup-btn-later" bindtap="closeFollowupPopup">稍后再说</button>
        <button class="followup-btn-go" bindtap="goToFollowup">
          <image class="followup-btn-icon" src="/images/icons/paw.svg" mode="aspectFit" aria-label="反馈" />
          去反馈
        </button>
      </view>
    </view>
  </view>

</view>
