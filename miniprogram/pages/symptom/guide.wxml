<!-- 症状自查页面 - 现代化UI设计 -->
<view class="page">

  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack" aria-label="返回">
      <text>←</text>
    </view>
    <view class="nav-title">症状自查</view>
    <view class="nav-step">{{currentStep}}/3</view>
  </view>

  <!-- 进度条 -->
  <view class="progress-bar" aria-label="症状选择">
    <view class="progress-fill" style="width: {{(currentStep / 3) * 100}}%"></view>
  </view>

  <!-- 步骤1：选择宠物 -->
  <view class="content" wx:if="{{currentStep === 1}}">
    <view class="step-header">
      <text class="step-icon">🐾</text>
      <view class="step-info">
        <text class="step-title">选择您的宠物</text>
        <text class="step-desc">为哪只宠物进行症状自查？</text>
      </view>
    </view>

    <view class="pet-list">
      <view class="pet-card {{selectedPet === item.id ? 'active' : ''}}"
            wx:for="{{petList}}"
            wx:key="id"
            bindtap="selectPet"
            data-id="{{item.id}}">
        <image wx:if="{{item.avatar}}" class="pet-avatar-sm" src="{{item.avatar}}" mode="aspectFill"/>
        <text wx:else class="pet-emoji">{{item.emoji}}</text>
        <text class="pet-name">{{item.name}}</text>
        <text class="pet-info">{{item.age}} · {{item.gender}}</text>
      </view>

      <view class="pet-card add" bindtap="addNewPet">
        <text class="pet-emoji">+</text>
        <text class="pet-name">添加新宠物</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：选择症状 -->
  <view class="content" wx:if="{{currentStep === 2}}" role="form">
    <view class="step-header">
      <text class="step-icon">🩺</text>
      <view class="step-info">
        <text class="step-title">选择症状</text>
        <text class="step-desc">请选择宠物的症状表现，可多选</text>
      </view>
    </view>

    <view class="selected-info" wx:if="{{selectedSymptomNames.length > 0}}">
      <text>已选 {{selectedSymptomNames.length}} 个症状</text>
      <text class="clear-btn" bindtap="clearAllSymptoms">清空</text>
    </view>

    <view class="symptom-area">
      <view class="category-block" wx:for="{{symptomCategories}}" wx:key="name" wx:for-item="category" wx:for-index="catIndex">
        <view class="category-title">
          <text>{{category.emoji}} {{category.name}}</text>
          <text class="count">({{category.selectedCount}}/{{category.symptoms.length}})</text>
        </view>

        <view class="symptom-list">
          <view class="symptom-item {{symptom.selected ? 'selected' : ''}}"
                wx:for="{{category.symptoms}}"
                wx:for-item="symptom"
                wx:key="id"
                bindtap="toggleSymptom"
                data-category-index="{{catIndex}}"
                data-id="{{symptom.id}}"
                aria-checked="{{symptom.selected}}">
            <text class="symptom-emoji">{{symptom.emoji}}</text>
            <text class="symptom-name">{{symptom.name}}</text>
            <text class="symptom-check" wx:if="{{symptom.selected}}">✓</text>
          </view>
        </view>
      </view>
    </view>

    <view class="selected-tags" wx:if="{{selectedSymptomNames.length > 0}}">
      <scroll-view class="tags-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="tag" wx:for="{{selectedSymptomNames}}" wx:key="*this">
          <text>{{item}}</text>
          <text class="tag-close" catchtap="removeSymptom" data-symptom="{{item}}" data-index="{{index}}">×</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 步骤3：补充描述 -->
  <view class="content" wx:if="{{currentStep === 3}}">
    <view class="step-header">
      <text class="step-icon">📝</text>
      <view class="step-info">
        <text class="step-title">补充描述</text>
        <text class="step-desc">提供更多细节帮助准确评估</text>
      </view>
    </view>

    <view class="form-block">
      <view class="form-title">
        <text>详细描述</text>
        <text class="required">*</text>
      </view>
      <textarea class="textarea"
                placeholder="请详细描述宠物的症状表现、持续时间、严重程度等..."
                value="{{description}}"
                bindinput="onDescriptionInput"
                maxlength="300"/>
      <text class="char-count">{{description.length}}/300</text>
    </view>

    <view class="form-block">
      <view class="form-title">症状持续多久？</view>
      <view class="option-group">
        <view class="option-btn {{duration === 'acute' ? 'active' : ''}}"
              bindtap="selectDuration"
              data-value="acute">急性</view>
        <view class="option-btn {{duration === 'chronic' ? 'active' : ''}}"
              bindtap="selectDuration"
              data-value="chronic">慢性</view>
      </view>
    </view>

    <view class="form-block">
      <view class="form-title">症状严重程度？</view>
      <view class="option-group">
        <view class="option-btn {{severity === 'mild' ? 'active' : ''}}"
              bindtap="selectSeverity"
              data-value="mild">轻微</view>
        <view class="option-btn {{severity === 'moderate' ? 'active' : ''}}"
              bindtap="selectSeverity"
              data-value="moderate">中度</view>
        <view class="option-btn {{severity === 'severe' ? 'active' : ''}}"
              bindtap="selectSeverity"
              data-value="severe">严重</view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="btn btn-secondary" wx:if="{{currentStep > 1}}" bindtap="prevStep">
      上一步
    </button>
    <button class="btn btn-primary {{currentStep > 1 ? 'flex-1' : ''}}" bindtap="nextStep" disabled="{{!canNext}}" aria-label="提交评估">
      {{currentStep === 3 ? '提交评估' : '下一步'}}
    </button>
  </view>

</view>
