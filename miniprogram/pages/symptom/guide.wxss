/* ===================================
   症状自查页面 - 现代化UI设计系统
   Symptom Check Page - Modern UI Design System
   =================================== */

/* === 设计变量 === */
page {
  --primary-color: #3b82f6;
  --primary-light: #eff6ff;
  --secondary-color: #6b7280;
  --success-color: #10b981;
  --bg-color: #f8f9fa;
  --card-bg: #ffffff;
  --border-color: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --text-light: #9ca3af;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
}

/* === 页面容器 === */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 120rpx;
}

/* === 顶部导航 === */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  color: var(--text-primary);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.nav-step {
  padding: var(--spacing-xs) var(--spacing-sm);
  background: var(--primary-light);
  color: var(--primary-color);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 600;
}

/* === 进度条 === */
.progress-bar {
  height: 8rpx;
  background: var(--border-color);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary-color);
  transition: width 0.3s;
}

/* === 内容区域 === */
.content {
  padding: var(--spacing-lg);
}

/* === 步骤标题 === */
.step-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.step-icon {
  font-size: 48rpx;
}

.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.step-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.step-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* === 宠物列表 === */
.pet-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
}

.pet-card {
  background: var(--card-bg);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  text-align: center;
  transition: all 0.2s;
}

.pet-card.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.pet-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.pet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.pet-info {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.pet-card.add {
  border-style: dashed;
  border-color: var(--text-light);
}

.pet-card.add .pet-emoji {
  color: var(--text-light);
}

/* === 已选信息 === */
.selected-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--primary-color);
  color: #ffffff;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  font-size: 28rpx;
  font-weight: 600;
}

.clear-btn {
  margin-left: var(--spacing-sm);
  opacity: 0.9;
}

/* === 症状展示区域 === */
.symptom-area {
  padding: var(--spacing-sm) 0;
}

/* === 分类区块 === */
.category-block {
  margin-bottom: var(--spacing-lg);
}

.category-block:last-child {
  margin-bottom: 260rpx;
}

.category-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card-bg);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  border-left: 4rpx solid var(--primary-color);
}

.category-title .count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* === 症状列表 === */
.symptom-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-sm);
}

.symptom-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  background: var(--card-bg);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  position: relative;
  overflow: hidden;
}

.symptom-item.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.symptom-emoji {
  font-size: 32rpx;
  flex-shrink: 0;
}

.symptom-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.symptom-check {
  position: absolute;
  top: var(--spacing-xs);
  right: var(--spacing-xs);
  width: 32rpx;
  height: 32rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

/* === 已选标签 === */
.selected-tags {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
  padding: var(--spacing-sm) var(--spacing-lg);
  z-index: 10;
}

.tags-scroll {
  white-space: nowrap;
}

.tag {
  display: inline-flex;
  align-items: center;
  background: var(--primary-color);
  color: #ffffff;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-md);
  margin-right: var(--spacing-sm);
  font-size: 24rpx;
  white-space: nowrap;
}

.tag-close {
  margin-left: var(--spacing-xs);
  padding: 0 var(--spacing-xs);
  opacity: 0.8;
}

/* === 表单区块 === */
.form-block {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  border: 1rpx solid var(--border-color);
}

.form-title {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.form-title .required {
  color: #ef4444;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

/* === 选项按钮组 === */
.option-group {
  display: flex;
  gap: var(--spacing-sm);
}

.option-btn {
  flex: 1;
  text-align: center;
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  transition: all 0.2s;
}

.option-btn.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
  color: var(--primary-color);
}

/* === 底部按钮栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
  box-sizing: border-box;
  z-index: 100;
}

/* === 按钮样式 === */
.btn {
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: var(--bg-color);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
}

.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
}

.btn.flex-1 {
  flex: 1;
}

.btn[disabled] {
  opacity: 0.5;
  background: var(--border-color);
  color: var(--text-light);
}
