/* ===================================
   症状自查页面 - iOS按钮对齐终极方案
   Symptom Check Page - iOS Button Fix Final Solution
   =================================== */

/* === 底部按钮 - iOS优化终极版 === */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  padding: 20rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  z-index: 101;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  height: auto;
  min-height: 88rpx;
}

/* === 单按钮场景 - 强制居中 === */
.single-btn-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0;
  padding: 0;
}

.single-btn-wrapper .nav-btn {
  width: 400rpx !important;
  max-width: 400rpx !important;
  min-width: 400rpx !important;
  flex: none !important;
}

/* === 双按钮场景 - 强制均分 === */
.next-btn-wrapper {
  flex: 1;
  display: flex;
  align-items: stretch;
  margin: 0;
  padding: 0;
  width: 0; /* 防止flex子元素溢出 */
}

.next-btn-wrapper .nav-btn {
  width: 100% !important;
  flex: 1 !important;
}

/* === 按钮基础样式 - 简化版 === */
.nav-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* === 按钮内部元素 - 简化对齐 === */
.btn-icon {
  font-size: 28rpx;
  line-height: 1;
  height: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  height: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 按钮内部间距 - 使用margin */
.nav-btn .btn-icon:first-child {
  margin-right: 10rpx;
}

.nav-btn .btn-text + .btn-icon {
  margin-left: 10rpx;
}

/* === 按钮样式 - 保持原有颜色 === */
.prev-btn {
  background: #f3f4f6;
  color: #374151;
  border: 2rpx solid #e5e7eb;
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.next-btn[disabled] {
  opacity: 0.5;
  background: #e5e7eb;
  color: #9ca3af;
  box-shadow: none;
}

/* === 双按钮间距处理 === */
.bottom-actions > .prev-btn {
  margin-right: 16rpx;
  flex: 1;
  max-width: calc(50% - 8rpx);
}

.bottom-actions > .next-btn-wrapper {
  margin-left: 16rpx;
  flex: 1;
  max-width: calc(50% - 8rpx);
}

/* 响应式适配 - 小屏设备 */
@media (max-width: 320px) {
  .bottom-actions {
    padding: 16rpx 24rpx 24rpx;
  }

  .single-btn-wrapper .nav-btn {
    width: 320rpx !important;
    max-width: 320rpx !important;
    min-width: 320rpx !important;
  }
}
