/* ===================================
   症状自查页面 v2.0
   Symptom Check — "Warm Professionalism"
   =================================== */

/* === 页面容器 === */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 140rpx;
}

/* === 顶部导航 === */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
}

.nav-back-arrow {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
}

.nav-step-badge {
  padding: 6rpx 16rpx;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 600;
}

/* === 进度条 — 纯色 === */
.progress-bar {
  height: 6rpx;
  background: var(--border-light);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--brand-primary);
  transition: width 300ms var(--ease-standard);
}

/* === 内容区域 === */
.content {
  padding: 32rpx;
}

/* === 步骤标题 — 圆形编号替代 emoji === */
.step-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-size-md);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.step-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
}

.step-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* === 宠物列表 === */
.pet-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.pet-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-2xl);
  padding: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: border-color var(--duration-fast) var(--ease-standard),
              background-color var(--duration-fast) var(--ease-standard);
}

.pet-card--active {
  background: var(--brand-primary-light);
  border-color: var(--brand-primary);
}

.pet-card-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
}

.pet-card-fallback {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-card-fallback-icon {
  width: 32rpx;
  height: 32rpx;
}

.pet-card-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
}

.pet-card-info {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

/* 添加宠物 */
.pet-card--add {
  border-style: dashed;
  border-color: var(--border-dark);
  justify-content: center;
}

.pet-card-add-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

/* === 已选信息条 === */
.selected-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-primary);
  color: var(--text-inverse);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-xl);
  margin-bottom: 24rpx;
  font-size: var(--font-size-base);
  font-weight: 500;
}

.clear-btn {
  opacity: 0.85;
}

/* === 症状分类 — 色点替代 emoji === */
.symptom-area {
  padding: 8rpx 0;
}

.category-block {
  margin-bottom: 32rpx;
}

.category-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.category-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
}

.category-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
}

.category-count {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* === 症状列表 — 胶囊式 === */
.symptom-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.symptom-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast) var(--ease-standard),
              border-color var(--duration-fast) var(--ease-standard);
}

.symptom-chip--active {
  background: var(--brand-primary-light);
  border-color: var(--brand-primary);
}

.symptom-chip-name {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--text-primary);
}

.symptom-chip--active .symptom-chip-name {
  color: var(--brand-primary);
  font-weight: 600;
}

.symptom-chip-check {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.symptom-chip-check-icon {
  width: 20rpx;
  height: 20rpx;
}

/* === 已选标签栏 === */
.selected-tags {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-color);
  padding: 16rpx 32rpx;
  z-index: 10;
}

.tags-scroll {
  white-space: nowrap;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  margin-right: 12rpx;
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.selected-tag-close {
  font-size: var(--font-size-sm);
  opacity: 0.6;
  padding: 0 4rpx;
}

/* === 表单区块 === */
.form-block {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.form-label-text {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--text-primary);
}

.form-required {
  font-size: var(--font-size-base);
  color: var(--brand-emergency);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: var(--bg-secondary);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 16rpx;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  box-sizing: border-box;
}

.form-char-count {
  display: block;
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* === 选项按钮 — 胶囊式 === */
.option-group {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.option-pill {
  flex: 1;
  text-align: center;
  background: var(--bg-secondary);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-full);
  padding: 16rpx 12rpx;
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--text-primary);
  transition: background-color var(--duration-fast) var(--ease-standard),
              border-color var(--duration-fast) var(--ease-standard),
              color var(--duration-fast) var(--ease-standard);
}

.option-pill--active {
  background: var(--brand-primary-light);
  border-color: var(--brand-primary);
  color: var(--brand-primary);
  font-weight: 600;
}

/* === 底部按钮栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-color);
  box-sizing: border-box;
  z-index: 100;
}

.bottom-btn-secondary {
  padding: 0 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-base);
  font-weight: 500;
  border: none;
}

.bottom-btn-primary {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-base);
  font-weight: 600;
  border: none;
  transition: opacity var(--duration-fast) var(--ease-standard);
}

.bottom-btn-primary--flex {
  flex: 1;
}

.bottom-btn-primary--disabled {
  opacity: 0.45;
  background: var(--border-dark);
  color: var(--text-tertiary);
}
