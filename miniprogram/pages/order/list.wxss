/* 订单列表页面样式 */
page {
  background: var(--bg-secondary);
  width: 100%;
  overflow-x: hidden;
}

.order-list-page {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  transition: background 200ms ease;
}

.back-btn-active {
  background: rgba(0, 0, 0, 0.05);
}

.back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  margin-right: 6rpx;
}

.back-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.header-placeholder {
  width: 80rpx;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top: 4rpx solid var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.order-type {
  display: flex;
  align-items: center;
}

.type-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.order-status {
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--bg-secondary);
}

.order-body {
  margin-bottom: 16rpx;
}

.order-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.order-footer {
  display: flex;
  justify-content: flex-end;
}

.order-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.no-more {
  text-align: center;
  padding: 24rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: var(--border-color);
}

/* 订单操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  min-width: 140rpx;
  transition: opacity 200ms ease;
}

.action-btn:active {
  opacity: 0.7;
}

.action-cancel {
  color: var(--text-secondary);
  background: var(--bg-secondary);
  border: 1rpx solid var(--border-color);
}

.action-pay {
  color: #fff;
  background: var(--brand-primary);
  border: 1rpx solid var(--brand-primary);
}
