page { background: var(--bg-secondary); }
.container { width: 100%; max-width: 750rpx; margin: 0 auto; min-height: 100vh; box-sizing: border-box; }
.page-header { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background: var(--bg-card); border-bottom: 1rpx solid var(--border-color); }
.back-btn { display: flex; align-items: center; padding: 10rpx 20rpx; border-radius: 28rpx; }
.back-btn-active { background: rgba(0, 0, 0, 0.05); }
.back-arrow { width: 16rpx; height: 16rpx; border-left: 4rpx solid var(--text-primary); border-bottom: 4rpx solid var(--text-primary); transform: rotate(45deg); -webkit-transform: rotate(45deg); margin-right: 6rpx; }
.back-text { font-size: 28rpx; color: var(--text-primary); }
.page-title { font-size: 34rpx; font-weight: bold; color: var(--text-primary); }
.header-placeholder { width: 80rpx; }
.loading-wrapper { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--border-color); border-top: 4rpx solid var(--brand-primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: var(--text-tertiary); }
.content { padding: 20rpx 24rpx; }
.status-card { background: var(--brand-primary); border-radius: 16rpx; padding: 32rpx; display: flex; align-items: center; margin-bottom: 20rpx; }
.status-icon { width: 56rpx; height: 56rpx; margin-right: 24rpx; }
.status-info { flex: 1; }
.status-type { font-size: 32rpx; font-weight: bold; color: #fff; display: block; margin-bottom: 8rpx; }
.status-badge { font-size: 26rpx; font-weight: 500; background: rgba(255,255,255,0.2); display: inline-block; padding: 4rpx 16rpx; border-radius: 16rpx; }
.amount-card { background: var(--bg-card); border-radius: 16rpx; padding: 32rpx; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.amount-label { font-size: 28rpx; color: var(--text-secondary); }
.amount-value { font-size: 40rpx; font-weight: bold; color: var(--text-primary); }
.detail-card { background: var(--bg-card); border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.detail-title { font-size: 30rpx; font-weight: bold; color: var(--text-primary); margin-bottom: 20rpx; }
.detail-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid var(--border-color); }
.detail-row:last-child { border-bottom: none; }
.detail-label { font-size: 26rpx; color: var(--text-tertiary); min-width: 160rpx; }
.detail-value { font-size: 26rpx; color: var(--text-primary); flex: 1; text-align: right; word-break: break-all; }
.detail-value.link { color: var(--brand-primary); }

/* 退款相关 */
.refund-card { border-left: 6rpx solid #1890ff; }
.refund-status { color: #1890ff; font-weight: bold; }
.refund-notice {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 16rpx 0 0;
  line-height: 1.6;
}
.action-area { padding: 32rpx 0; }
.refund-btn {
  background: var(--bg-card);
  color: var(--brand-emergency);
  border: 2rpx solid var(--brand-emergency);
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.refund-policy {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.5;
}
