<!--订单列表页面-->
<view class="order-list-page">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="back-btn" bindtap="goBack" hover-class="back-btn-active">
      <view class="back-arrow"></view>
      <text class="back-text">返回</text>
    </view>
    <view class="page-title">我的订单</view>
    <view class="header-placeholder"></view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading && orders.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="_id" bindtap="onOrderTap" data-order="{{item}}">
      <view class="order-header">
        <view class="order-type">
          <image class="type-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
          <text class="type-name">{{item.typeText}}</text>
        </view>
        <view class="order-status" style="color: {{item.statusColor}};">
          {{item.statusText}}
        </view>
      </view>
      <view class="order-body">
        <view class="order-desc">{{item.description || '订单详情'}}</view>
        <view class="order-time">{{item.timeText || ''}}</view>
      </view>
      <view class="order-footer">
        <view class="order-amount">¥{{item.amountDisplay}}</view>
      </view>
      <!-- 待支付订单操作按钮 -->
      <view class="order-actions" wx:if="{{item.status === 'pending'}}" catchtap="onActionTap">
        <view class="action-btn action-cancel" catchtap="cancelOrder" data-id="{{item._id}}" data-index="{{index}}">取消订单</view>
        <view class="action-btn action-pay" catchtap="payOrder" data-order="{{item}}" data-index="{{index}}">立即支付</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <image class="empty-icon" src="/images/icons/clipboard.svg" mode="aspectFit" />
    <text class="empty-text">暂无订单</text>
  </view>

  <!-- 上拉加载更多 -->
  <view class="load-more" wx:if="{{orders.length > 0 && hasMore}}">
    <text class="load-more-text">加载更多...</text>
  </view>
  <view class="no-more" wx:if="{{orders.length > 0 && !hasMore}}">
    <text class="no-more-text">没有更多订单了</text>
  </view>
</view>
