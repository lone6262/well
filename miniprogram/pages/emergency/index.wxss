/* 急救页 v2.0 — 白底 + 暖红强调，无渐变无毛玻璃 */

.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 0 24rpx 40rpx;
}

/* 顶部暖红警示条 */
.alert-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--brand-emergency);
  padding: 20rpx 28rpx;
  color: var(--text-inverse);
  margin: 0 -24rpx 28rpx;
}
.alert-bar-dot {
  width: 12rpx; height: 12rpx;
  background: var(--text-inverse);
  border-radius: var(--radius-full);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.alert-bar-text { font-size: var(--font-size-sm); font-weight: 500; }

/* 最近医院卡片 */
.nearest-card {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
}
.nearest-badge {
  position: absolute; top: -8rpx; right: 28rpx;
  background: var(--brand-primary); color: var(--text-inverse);
  padding: 8rpx 20rpx; border-radius: var(--radius-full);
  font-size: var(--font-size-xs); font-weight: 700;
}
.nearest-name { display: block; font-size: var(--font-size-xl); font-weight: 700; color: var(--text-primary); margin-bottom: 16rpx; line-height: 1.3; }

.nearest-meta { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.nearest-meta-item {
  display: flex; align-items: center; gap: 6rpx;
  font-size: var(--font-size-sm); color: var(--text-secondary);
  background: var(--bg-secondary); padding: 8rpx 16rpx; border-radius: var(--radius-full);
}
.nearest-meta-icon { width: 20rpx; height: 20rpx; }
.nearest-meta-item--24h { background: var(--color-danger-light); color: var(--brand-emergency); font-weight: 600; }
.nearest-address { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); line-height: 1.5; margin-bottom: 24rpx; }

.nearest-actions { display: flex; gap: 16rpx; }
.nearest-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 24rpx; border-radius: var(--radius-xl);
  font-size: var(--font-size-base); font-weight: 600; border: none;
  transition: transform var(--duration-fast) var(--ease-standard);
}
.nearest-btn:active { transform: scale(0.97); }
.nearest-btn-icon { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); }
.nearest-btn--call { background: var(--color-success); color: var(--text-inverse); }
.nearest-btn--nav { background: var(--brand-primary); color: var(--text-inverse); }

/* 其他医院区域 */
.other-section {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  overflow: hidden;
}
.other-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.other-header-left { display: flex; align-items: center; gap: 14rpx; }
.other-header-icon { width: 28rpx; height: 28rpx; }
.other-header-text { display: flex; flex-direction: column; gap: 4rpx; }
.other-header-title { font-size: var(--font-size-base); font-weight: 600; color: var(--text-primary); }
.other-header-sub { font-size: var(--font-size-xs); color: var(--text-tertiary); }
.other-arrow { font-size: var(--font-size-sm); color: var(--text-tertiary); }

.other-list { padding: 16rpx 20rpx; }

.other-card {
  padding: 20rpx; border-bottom: 1rpx solid var(--border-light);
  margin-bottom: 12rpx;
}
.other-card:last-child { border-bottom: none; margin-bottom: 0; }

.other-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.other-card-badges { display: flex; gap: 8rpx; }
.other-badge {
  font-size: 18rpx; font-weight: 700; padding: 4rpx 12rpx; border-radius: var(--radius-full);
}
.other-badge--24h { background: var(--color-success-light); color: var(--color-success); }
.other-badge--er { background: var(--color-danger-light); color: var(--brand-emergency); }
.other-card-distance { font-size: var(--font-size-sm); color: var(--brand-primary); font-weight: 500; }

.other-card-name { display: block; font-size: var(--font-size-base); font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; }
.other-card-address { display: block; font-size: var(--font-size-xs); color: var(--text-secondary); margin-bottom: 16rpx; }

.other-card-actions { display: flex; gap: 16rpx; }
.other-card-action {
  display: flex; align-items: center; gap: 6rpx;
  font-size: var(--font-size-xs); font-weight: 500; color: var(--text-secondary);
}
.other-card-action-icon { width: 22rpx; height: 22rpx; }

.other-more {
  text-align: center; padding: 20rpx;
  font-size: var(--font-size-sm); color: var(--brand-primary); font-weight: 500;
}

/* 紧急提示 */
.tips-card {
  background: var(--bg-card); border-radius: var(--radius-2xl);
  padding: 24rpx 28rpx; margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}
.tips-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.tips-icon { width: 22rpx; height: 22rpx; }
.tips-title { font-size: var(--font-size-sm); font-weight: 600; color: var(--brand-emergency); }
.tips-list { display: flex; flex-direction: column; gap: 10rpx; }
.tips-item { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: 1.6; }

/* 返回链接 */
.back-link {
  display: flex; align-items: center; gap: 10rpx;
  padding: 20rpx;
  background: var(--bg-card); border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-color);
}
.back-link--active { background: var(--bg-secondary); }
.back-link-arrow { font-size: var(--font-size-md); color: var(--text-secondary); }
.back-link-text { font-size: var(--font-size-base); color: var(--text-secondary); font-weight: 500; }
