<!--紧急救助页面 - 极简设计-->
<view class="emergency-page">

  <!-- 顶部状态栏 -->
  <view class="emergency-status">
    <view class="status-dot"></view>
    <text class="status-text">紧急救助中</text>
  </view>

  <!-- 最近医院卡片 -->
  <view class="nearest-hospital-card" wx:if="{{nearestHospital}}">
    <view class="hospital-badge">⚡ 最近</view>

    <!-- 医院名称 -->
    <view class="hospital-name">{{nearestHospital.name}}</view>

    <!-- 关键信息 -->
    <view class="hospital-info">
      <text class="info-item">📍 {{nearestHospital.distanceDisplay}}</text>
      <text class="info-item">🕐 24小时</text>
    </view>

    <!-- 地址 -->
    <view class="hospital-address">{{nearestHospital.address}}</view>

    <!-- 一键操作按钮 -->
    <view class="emergency-actions">
      <button class="action-btn primary-action"
              bindtap="callHospital"
              data-phone="{{nearestHospital.phone}}"
              data-name="{{nearestHospital.name}}">
        <text class="btn-icon">📞</text>
        <text class="btn-text">立即拨打</text>
      </button>

      <button class="action-btn secondary-action"
              bindtap="navigateToHospital"
              data-hospital="{{nearestHospital}}">
        <text class="btn-icon">🧭</text>
        <text class="btn-text">开始导航</text>
      </button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="pulse-ring"></view>
    <text class="loading-text">正在定位最近医院...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{!isLoading && !nearestHospital}}">
    <text class="error-icon">❌</text>
    <text class="error-title">定位失败</text>
    <text class="error-desc">无法获取您的位置信息</text>
    <button class="retry-btn" bindtap="retryLocation">
      <text>🔄 重新定位</text>
    </button>
  </view>

  <!-- 其他医院列表（全新设计） -->
  <view class="other-hospitals-section" wx:if="{{otherHospitals.length > 0}}">
    <!-- 展开按钮 -->
    <view class="expand-header" bindtap="toggleOtherHospitals">
      <view class="expand-content">
        <text class="expand-icon-large">🏥</text>
        <view class="expand-text-group">
          <text class="expand-title">其他附近医院</text>
          <text class="expand-subtitle">{{otherHospitals.length}}家可选择医院，已显示{{displayOtherHospitals.length}}家</text>
        </view>
      </view>
      <view class="expand-arrow {{showOther ? 'arrow-up' : 'arrow-down'}}">
        <text class="arrow-icon">{{showOther ? '▲' : '▼'}}</text>
      </view>
    </view>

    <!-- 医院卡片网格 -->
    <view class="hospitals-grid" wx:if="{{showOther}}">
      <view class="hospital-card-mini"
            wx:for="{{displayOtherHospitals}}"
            wx:key="hospitalId"
            bindtap="selectHospital"
            data-hospital="{{item}}">

        <!-- 卡片头部 -->
        <view class="card-header-mini">
          <view class="hospital-badge-group">
            <text class="badge-24h" wx:if="{{item.is24h}}">24H</text>
            <text class="badge-emergency" wx:if="{{item.hasEmergency}}">急诊</text>
          </view>
          <text class="hospital-distance-mini">{{item.distanceDisplay}}</text>
        </view>

        <!-- 医院信息 -->
        <view class="hospital-content-mini">
          <text class="hospital-name-mini">{{item.name}}</text>
          <view class="hospital-details-mini">
            <text class="detail-text-mini">📍 {{item.address}}</text>
          </view>
        </view>

        <!-- 快速操作 -->
        <view class="card-actions-mini">
          <view class="mini-action-btn call-mini"
                  catchtap="callHospital"
                  data-phone="{{item.phone}}"
                  data-name="{{item.name}}">
            <text class="mini-btn-icon">📞</text>
            <text class="mini-btn-text">拨打</text>
          </view>
          <view class="mini-action-btn navigate-mini"
                  catchtap="navigateToHospital"
                  data-hospital="{{item}}">
            <text class="mini-btn-icon">🧭</text>
            <text class="mini-btn-text">导航</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多按钮 -->
    <view class="load-more-btn" wx:if="{{showOther && displayCount < otherHospitals.length}}" bindtap="loadMoreHospitals">
      <text class="load-more-text">查看更多医院（{{displayCount}}/{{otherHospitals.length}}）</text>
      <text class="load-more-arrow">▼</text>
    </view>

    <!-- 展开提示 -->
    <view class="expand-hint" bindtap="toggleOtherHospitals" wx:if="{{showOther}}">
      <text class="hint-text">收起列表</text>
      <text class="hint-icon">▲</text>
    </view>
  </view>

  <!-- 紧急提示 -->
  <view class="emergency-tips">
    <text class="tips-title">⚠️ 紧急处理建议</text>
    <view class="tips-list">
      <text class="tip-item">1. 保持冷静，观察宠物状态</text>
      <text class="tip-item">2. 拨打医院电话告知情况</text>
      <text class="tip-item">3. 准备宠物相关医疗记录</text>
    </view>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack" hover-class="back-btn-active">
    <view class="back-arrow"></view>
    <text class="back-text">返回首页</text>
  </view>

</view>