<!--紧急救助页面 — 白底 + 暖红强调，Warm Professionalism v2.0-->
<view class="page">

  <!-- 顶部暖红警示条 -->
  <view class="alert-bar">
    <view class="alert-bar-dot"></view>
    <text class="alert-bar-text">紧急救助中</text>
  </view>

  <!-- 最近医院卡片 — 白底 -->
  <view class="nearest-card" wx:if="{{nearestHospital}}">
    <view class="nearest-badge">最近</view>
    <text class="nearest-name">{{nearestHospital.name}}</text>
    <view class="nearest-meta">
      <view class="nearest-meta-item">
        <image class="nearest-meta-icon" src="/images/icons/pin.svg" mode="aspectFit" />
        <text>{{nearestHospital.distanceDisplay}}</text>
      </view>
      <view class="nearest-meta-item nearest-meta-item--24h">24小时</view>
    </view>
    <text class="nearest-address">{{nearestHospital.address}}</text>

    <view class="nearest-actions">
      <button class="nearest-btn nearest-btn--call" bindtap="callHospital"
              data-phone="{{nearestHospital.phone}}" data-name="{{nearestHospital.name}}">
        <image class="nearest-btn-icon" src="/images/icons/phone.svg" mode="aspectFit" aria-label="拨打" />
        <text>立即拨打</text>
      </button>
      <button class="nearest-btn nearest-btn--nav" bindtap="navigateToHospital"
              data-hospital="{{nearestHospital}}">
        <image class="nearest-btn-icon" src="/images/icons/compass.svg" mode="aspectFit" aria-label="导航" />
        <text>开始导航</text>
      </button>
    </view>
  </view>

  <state-view wx:if="{{isLoading}}" type="loading" title="正在定位最近医院..." />
  <state-view wx:if="{{!isLoading && !nearestHospital}}" type="error" icon="cross"
    title="定位失败" description="无法获取您的位置信息"
    show-action="{{true}}" action-text="重新定位" bind:action="retryLocation" />

  <!-- 其他医院 -->
  <view class="other-section" wx:if="{{otherHospitals.length > 0}}">
    <view class="other-header" bindtap="toggleOtherHospitals">
      <view class="other-header-left">
        <image class="other-header-icon" src="/images/icons/hospital.svg" mode="aspectFit" aria-label="医院" />
        <view class="other-header-text">
          <text class="other-header-title">其他附近医院</text>
          <text class="other-header-sub">{{otherHospitals.length}}家可选择</text>
        </view>
      </view>
      <text class="other-arrow">{{showOther ? '▲' : '▼'}}</text>
    </view>

    <view class="other-list" wx:if="{{showOther}}">
      <view class="other-card" wx:for="{{displayOtherHospitals}}" wx:key="hospitalId"
            bindtap="selectHospital" data-hospital="{{item}}">
        <view class="other-card-top">
          <view class="other-card-badges">
            <text class="other-badge other-badge--24h" wx:if="{{item.is24h}}">24H</text>
            <text class="other-badge other-badge--er" wx:if="{{item.hasEmergency}}">急诊</text>
          </view>
          <text class="other-card-distance">{{item.distanceDisplay}}</text>
        </view>
        <text class="other-card-name">{{item.name}}</text>
        <text class="other-card-address">{{item.address}}</text>
        <view class="other-card-actions">
          <view class="other-card-action" catchtap="callHospital" data-phone="{{item.phone}}" data-name="{{item.name}}">
            <image class="other-card-action-icon" src="/images/icons/phone.svg" mode="aspectFit" />拨打
          </view>
          <view class="other-card-action" catchtap="navigateToHospital" data-hospital="{{item}}">
            <image class="other-card-action-icon" src="/images/icons/compass.svg" mode="aspectFit" />导航
          </view>
        </view>
      </view>
    </view>

    <view class="other-more" wx:if="{{showOther && displayCount < otherHospitals.length}}" bindtap="loadMoreHospitals">
      查看更多（{{displayCount}}/{{otherHospitals.length}}）
    </view>
  </view>

  <!-- 紧急提示 -->
  <view class="tips-card">
    <view class="tips-header">
      <image class="tips-icon" src="/images/icons/warning.svg" mode="aspectFit" aria-label="提示" />
      <text class="tips-title">紧急处理建议</text>
    </view>
    <view class="tips-list">
      <text class="tips-item">1. 保持冷静，观察宠物状态</text>
      <text class="tips-item">2. 拨打医院电话告知情况</text>
      <text class="tips-item">3. 准备宠物相关医疗记录</text>
    </view>
  </view>

  <!-- 返回按钮 -->
  <view class="back-link" bindtap="goBack" hover-class="back-link--active">
    <text class="back-link-arrow">←</text>
    <text class="back-link-text">返回首页</text>
  </view>

</view>
