<!--AI健康报告页面-->
<view class="report-page">

  <!-- 加载状态 -->
  <view class="loading-section" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在生成AI报告...</text>
  </view>

  <!-- 报告内容 -->
  <view class="report-content" wx:if="{{!loading}}">

    <!-- 报告头部 -->
    <view class="report-header">
      <view class="risk-badge risk-badge-{{report.risk_level || 'low'}}">
        <text class="risk-badge-text">{{report.risk_level === 'high' ? '高风险' : report.risk_level === 'mid' ? '中风险' : '低风险'}}</text>
      </view>
      <text class="report-time">生成时间：{{report.created_at || '刚刚'}}</text>
    </view>

    <!-- 章节列表 -->
    <view class="section-card" wx:for="{{sections}}" wx:key="key">
      <view class="section-header" bindtap="toggleSection" data-index="{{index}}">
        <text class="section-icon">{{item.icon}}</text>
        <text class="section-title">{{item.title}}</text>
        <text class="section-arrow">{{expandedSections[index] ? '▼' : '▶'}}</text>
      </view>
      <view class="section-body" wx:if="{{expandedSections[index]}}">

        <!-- 纯文本内容 -->
        <text class="content-text" wx:if="{{item.type === 'text'}}">{{item.content}}</text>

        <!-- 列表内容 -->
        <view wx:if="{{item.type === 'list'}}">
          <view class="list-item" wx:for="{{item.content}}" wx:for-item="li" wx:key="*this">
            <text class="list-bullet">•</text>
            <text class="list-text">{{li}}</text>
          </view>
          <view class="empty-hint" wx:if="{{item.content.length === 0}}">
            <text class="empty-hint-text">暂无相关内容</text>
          </view>
        </view>

        <!-- 症状分析 -->
        <view wx:if="{{item.type === 'symptoms'}}">
          <view class="symptom-item" wx:for="{{item.content}}" wx:for-item="s" wx:key="name">
            <text class="symptom-name">{{s.name}}</text>
            <text class="symptom-explanation">{{s.explanation}}</text>
          </view>
          <view class="empty-hint" wx:if="{{item.content.length === 0}}">
            <text class="empty-hint-text">暂无症状分析数据</text>
          </view>
        </view>

        <!-- 常见误区 -->
        <view wx:if="{{item.type === 'misconceptions'}}">
          <view class="myth-item" wx:for="{{item.content}}" wx:for-item="m" wx:key="myth">
            <view class="myth-row">
              <text class="myth-label">❌ {{m.myth}}</text>
            </view>
            <view class="fact-row">
              <text class="fact-label">✅ {{m.fact}}</text>
            </view>
          </view>
          <view class="empty-hint" wx:if="{{item.content.length === 0}}">
            <text class="empty-hint-text">暂无常见误区数据</text>
          </view>
        </view>

      </view>
    </view>

    <!-- 底部免责声明（始终可见） -->
    <view class="disclaimer-box">
      <text class="disclaimer-icon">⚠️</text>
      <text class="disclaimer-text">本报告由AI生成，仅供参考，不构成专业兽医诊断建议。如您的宠物出现严重症状，请及时就医。</text>
    </view>

    <!-- 分享提示 -->
    <view class="share-hint">
      <text class="share-hint-text">觉得有用？点击右上角分享给朋友吧</text>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-space"></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{!loading}}">
    <view class="action-btn action-btn-home" bindtap="goHome">
      <text class="action-btn-text">返回首页</text>
    </view>
    <view class="action-btn action-btn-history" bindtap="goHistory">
      <text class="action-btn-text">查看记录</text>
    </view>
  </view>

</view>