/* 风险结果页面样式 - 自适应修复版本 */
page {
  width: 100%;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 风险卡片 - 自适应 */
.risk-card {
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  color: white;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.risk-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.risk-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.risk-description {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 信息区域 - 自适应 */
.info-section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.rule-info {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  word-break: break-all;
}

/* 宠物信息 - 自适应 */
.pet-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.info-item {
  display: flex;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.info-label {
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  font-weight: bold;
  flex: 1;
  word-break: break-all;
}

/* 症状标签 - 自适应 */
.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.symptom-tag {
  padding: 8rpx 16rpx;
  background-color: #e6f7ff;
  color: #4A90E2;
  border-radius: 4rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 免责声明 - 自适应 */
.disclaimer-section {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.disclaimer-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

/* 操作按钮 - 自适应 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 0 40rpx;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.action-btn {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  border: none;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.emergency-btn {
  background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%);
  color: white;
  font-weight: bold;
}

.primary-btn {
  background: #4A90E2;
  color: white;
}

.secondary-btn {
  background: #f0f0f0;
  color: #333;
}

/* 小屏幕适配 */
@media (max-width: 375px) {
  .risk-card {
    padding: 32rpx 16rpx;
  }

  .risk-icon {
    font-size: 70rpx;
  }

  .risk-title {
    font-size: 42rpx;
  }

  .risk-description {
    font-size: 26rpx;
  }

  .info-section {
    padding: 24rpx 16rpx;
  }

  .section-title {
    font-size: 28rpx;
  }

  .info-item {
    font-size: 26rpx;
  }

  .info-label {
    min-width: 140rpx;
  }

  .action-btn {
    padding: 20rpx;
    font-size: 30rpx;
  }

  .disclaimer-section {
    padding: 20rpx 16rpx;
  }
}

/* 大屏幕适配 */
@media (min-width: 414px) {
  .container {
    padding: 24rpx;
  }

  .risk-card {
    padding: 48rpx 24rpx;
  }

  .action-section {
    flex-direction: row;
  }

  .action-btn {
    padding: 28rpx 24rpx;
  }
}

/* 横屏适配 */
@media (orientation: landscape) {
  .risk-card {
    padding: 32rpx 24rpx;
  }

  .risk-icon {
    font-size: 70rpx;
  }

  .action-section {
    padding: 16rpx 0 32rpx;
  }

  .action-btn {
    padding: 20rpx;
  }
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文本溢出处理 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.break-word {
  word-wrap: break-word;
  word-break: break-all;
}