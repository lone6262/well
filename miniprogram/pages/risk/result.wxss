/* 风险结果页 v2.0 — Warm Professionalism */
page { width: 100%; overflow-x: hidden; }

.page {
  max-width: 750rpx;
  margin: 0 auto;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 会员标识 */
.member-indicator {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--brand-primary-light);
  border-radius: var(--radius-xl);
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
}
.member-indicator-icon { width: 24rpx; height: 24rpx; margin-right: 10rpx; }
.member-indicator-text { flex: 1; font-size: var(--font-size-sm); color: var(--brand-primary); font-weight: 500; }
.member-indicator-arrow { font-size: var(--font-size-sm); color: var(--text-tertiary); }

/* 风险卡片 — 状态卡片模式 */
.risk-card {
  border-radius: var(--radius-3xl);
  padding: 40rpx 28rpx;
  text-align: center;
  color: var(--text-inverse);
  margin-bottom: 24rpx;
}
.risk-card--low { background: var(--color-success); }
.risk-card--mid { background: var(--color-warning); }
.risk-card--high { background: var(--brand-emergency); }

.risk-card-icon-wrap {
  width: 72rpx; height: 72rpx;
  margin: 0 auto 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
}
.risk-card-icon { width: 40rpx; height: 40rpx; filter: brightness(0) invert(1); }
.risk-card-title { display: block; font-size: var(--font-size-2xl); font-weight: 700; margin-bottom: 12rpx; }
.risk-card-desc { display: block; font-size: var(--font-size-base); line-height: var(--line-height-normal); opacity: 0.9; }

/* 信息卡片 — content-card 模式 */
.info-card {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border-color);
  border-left: 4rpx solid var(--brand-primary);
}
.info-card-title { display: block; font-size: var(--font-size-md); font-weight: 600; color: var(--text-primary); margin-bottom: 12rpx; }
.info-card-rule { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-relaxed); background: var(--bg-secondary); padding: 16rpx; border-radius: var(--radius-md); }

.info-card-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.info-card-label { font-size: var(--font-size-sm); color: var(--text-secondary); min-width: 140rpx; }
.info-card-value { font-size: var(--font-size-sm); color: var(--text-primary); font-weight: 600; }

/* 症状标签 */
.symptom-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.symptom-tag {
  padding: 8rpx 16rpx; background: var(--brand-primary-light); color: var(--brand-primary);
  border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 500;
}

/* 免责声明 */
.disclaimer-card {
  background: var(--color-warning-light); border: 1rpx solid var(--color-warning);
  border-radius: var(--radius-2xl); padding: 20rpx 24rpx; margin-bottom: 20rpx;
}
.disclaimer-header { display: flex; align-items: center; gap: 8rpx; margin-bottom: 10rpx; }
.disclaimer-icon { width: 24rpx; height: 24rpx; }
.disclaimer-title { font-size: var(--font-size-base); font-weight: 600; color: var(--color-warning); }
.disclaimer-text { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-relaxed); }

/* AI 报告卡 — 白底 + 左边框 */
.report-card {
  background: var(--bg-card); border-radius: var(--radius-2xl);
  padding: 28rpx; margin-bottom: 20rpx;
  border: 1rpx solid var(--border-color);
  border-left: 4rpx solid var(--brand-primary);
}
.report-card-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; }
.report-card-icon { width: 28rpx; height: 28rpx; }
.report-card-title { font-size: var(--font-size-md); font-weight: 600; color: var(--text-primary); }
.report-card-desc { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: 16rpx; }

.report-quota-notice {
  background: var(--color-warning-light); border-radius: var(--radius-md);
  padding: 12rpx 16rpx; margin-bottom: 16rpx; font-size: var(--font-size-xs);
  color: var(--color-warning); line-height: 1.8;
}
.report-upgrade-link { display: block; font-weight: 600; margin-top: 6rpx; }

.report-price-row { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; margin-bottom: 16rpx; }
.report-price { font-size: var(--font-size-2xl); font-weight: 700; color: var(--brand-primary); text-align: center; }
.report-member-link { font-size: var(--font-size-sm); color: var(--brand-primary); font-weight: 500; text-align: center; }

/* 点数包推荐条（付费时单份更划算） */
.report-points-promo {
  display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4rpx;
  margin-bottom: 16rpx; padding: 16rpx;
  background: var(--brand-primary-light); border-radius: var(--radius-md);
  border: 1rpx dashed var(--brand-primary);
}
.promo-label { font-size: var(--font-size-sm); font-weight: 700; color: var(--brand-primary); }
.promo-detail { font-size: var(--font-size-xs); color: var(--text-secondary); }

.report-compliance { display: block; font-size: var(--font-size-xs); color: var(--text-tertiary); text-align: center; padding: 12rpx 0; margin-bottom: 8rpx; }

.report-btn {
  width: 100%; background: var(--brand-primary); color: var(--text-inverse);
  border-radius: var(--radius-full); font-weight: 600; border: none;
}

/* 已购买报告 */
.report-done-card { background: var(--bg-card); border-radius: var(--radius-2xl); padding: 24rpx; margin-bottom: 20rpx; border: 1rpx solid var(--border-color); text-align: center; }
.report-done-header { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-bottom: 16rpx; }
.report-done-icon { width: 28rpx; height: 28rpx; }
.report-done-text { font-size: var(--font-size-base); font-weight: 600; color: var(--color-success); }
.report-done-btn { background: var(--brand-primary); color: var(--text-inverse); border-radius: var(--radius-full); border: none; }

/* 操作按钮区 */
.actions { display: flex; flex-direction: column; gap: 16rpx; padding-bottom: 40rpx; }
.actions-row { display: flex; gap: 16rpx; }

.home-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  flex: 1; height: 88rpx; border-radius: var(--radius-full);
  font-size: var(--font-size-md); font-weight: 600;
  transition: transform var(--duration-fast) var(--ease-standard);
}
.home-btn:active { transform: scale(0.97); }
.home-btn--emergency { background: var(--brand-emergency); color: var(--text-inverse); }
.home-btn--hospital {
  background: var(--brand-secondary-light); color: var(--brand-secondary);
}
.home-btn--hospital .home-btn-icon { filter: none; }
.home-btn--secondary { background: var(--brand-primary-light); color: var(--brand-primary); }
.home-btn-icon { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); }

/* 高风险警告框 */
.high-risk-box {
  background: var(--color-danger-light); border: 1rpx solid var(--brand-emergency);
  border-radius: var(--radius-2xl); padding: 32rpx 24rpx; margin-bottom: 20rpx; text-align: center;
}
.high-risk-icon { width: 56rpx; height: 56rpx; margin-bottom: 12rpx; }
.high-risk-title { display: block; font-size: var(--font-size-lg); font-weight: 700; color: var(--brand-emergency); margin-bottom: 10rpx; }
.high-risk-desc { display: block; font-size: var(--font-size-sm); color: var(--text-primary); line-height: var(--line-height-relaxed); margin-bottom: 16rpx; }
.high-risk-symptoms { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-bottom: 16rpx; }
.high-risk-tag { padding: 6rpx 16rpx; background: var(--brand-emergency); color: var(--text-inverse); border-radius: var(--radius-full); font-size: var(--font-size-xs); }
.high-risk-note { display: block; font-size: var(--font-size-xs); color: var(--brand-emergency); padding: 12rpx; background: rgba(255,255,255,0.6); border-radius: var(--radius-md); }

/* 支付面板 */
.pay-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-overlay); z-index: 1000; display: flex; align-items: flex-end; }
.pay-panel { width: 100%; max-width: 750rpx; background: var(--bg-card); border-radius: var(--radius-3xl) var(--radius-3xl) 0 0; padding: 32rpx 24rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.pay-panel-header { text-align: center; margin-bottom: 28rpx; }
.pay-panel-title { display: block; font-size: var(--font-size-lg); font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.pay-panel-desc { display: block; font-size: var(--font-size-sm); color: var(--text-tertiary); }

.pay-option { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border: 2rpx solid var(--border-color); border-radius: var(--radius-2xl); margin-bottom: 16rpx; position: relative; overflow: hidden; }
.pay-option--recommend { border-color: var(--brand-primary); background: var(--brand-primary-light); }
.pay-option--hover { transform: scale(0.98); }
.pay-recommend-badge { position: absolute; top: 0; right: 0; background: var(--brand-primary); color: var(--text-inverse); font-size: 18rpx; padding: 4rpx 16rpx; border-radius: 0 0 0 var(--radius-md); }

.pay-option-left { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.pay-option-icon { width: 40rpx; height: 40rpx; }
.pay-option-info { display: flex; flex-direction: column; gap: 4rpx; }
.pay-option-name { font-size: var(--font-size-base); font-weight: 700; color: var(--text-primary); }
.pay-option-desc { font-size: var(--font-size-xs); color: var(--text-tertiary); }
.pay-option-price { font-size: var(--font-size-2xl); font-weight: 700; color: var(--brand-emergency); flex-shrink: 0; }
.pay-option-price small { font-size: var(--font-size-xs); color: var(--text-tertiary); font-weight: normal; }
.pay-cancel { text-align: center; font-size: var(--font-size-base); color: var(--text-tertiary); padding: 20rpx 0 0; }

/* 免责弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-overlay); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; max-width: 600rpx; background: var(--bg-card); border-radius: var(--radius-3xl); padding: 40rpx 32rpx; }
.modal-title { font-size: var(--font-size-lg); font-weight: 700; color: var(--color-warning); text-align: center; margin-bottom: 28rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.modal-title-icon { width: 28rpx; height: 28rpx; }
.modal-content { margin-bottom: 28rpx; }
.modal-item { font-size: var(--font-size-base); color: var(--text-primary); line-height: 1.8; margin-bottom: 12rpx; }
.modal-highlight { color: var(--brand-emergency); font-weight: 700; }

.modal-checkbox-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; margin-bottom: 20rpx; }
.modal-checkbox { width: 40rpx; height: 40rpx; border: 2rpx solid var(--border-dark); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.modal-checkbox--checked { background: var(--brand-primary); border-color: var(--brand-primary); }
.modal-checkbox-check { width: 24rpx; height: 24rpx; filter: brightness(0) invert(1); }
.modal-checkbox-label { font-size: var(--font-size-base); color: var(--text-primary); }

.modal-confirm { width: 100%; background: var(--brand-primary); color: var(--text-inverse); border-radius: var(--radius-full); font-size: var(--font-size-md); font-weight: 700; padding: 20rpx 0; border: none; }
.modal-confirm--disabled { background: var(--border-dark); }
