/* 风险结果页面样式 - 自适应修复版本 */
page {
  width: 100%;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 风险卡片 - 自适应 */
.risk-card {
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  color: white;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.risk-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.risk-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.risk-description {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 信息区域 - 自适应 */
.info-section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.rule-info {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  word-break: break-all;
}

/* 宠物信息 - 自适应 */
.pet-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.info-item {
  display: flex;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.info-label {
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  font-weight: bold;
  flex: 1;
  word-break: break-all;
}

/* 症状标签 - 自适应 */
.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.symptom-tag {
  padding: 8rpx 16rpx;
  background-color: #e6f7ff;
  color: #4A90E2;
  border-radius: 4rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 免责声明 - 自适应 */
.disclaimer-section {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.disclaimer-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

/* 操作按钮 - 自适应 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 0 40rpx;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.action-btn {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  border: none;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.emergency-btn {
  background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%);
  color: white;
  font-weight: bold;
}

.primary-btn {
  background: #4A90E2;
  color: white;
}

.secondary-btn {
  background: #f0f0f0;
  color: #333;
}

/* 小屏幕适配 */
@media (max-width: 375px) {
  .risk-card {
    padding: 32rpx 16rpx;
  }

  .risk-icon {
    font-size: 70rpx;
  }

  .risk-title {
    font-size: 42rpx;
  }

  .risk-description {
    font-size: 26rpx;
  }

  .info-section {
    padding: 24rpx 16rpx;
  }

  .section-title {
    font-size: 28rpx;
  }

  .info-item {
    font-size: 26rpx;
  }

  .info-label {
    min-width: 140rpx;
  }

  .action-btn {
    padding: 20rpx;
    font-size: 30rpx;
  }

  .disclaimer-section {
    padding: 20rpx 16rpx;
  }
}

/* 大屏幕适配 */
@media (min-width: 414px) {
  .container {
    padding: 24rpx;
  }

  .risk-card {
    padding: 48rpx 24rpx;
  }

  .action-section {
    flex-direction: row;
  }

  .action-btn {
    padding: 28rpx 24rpx;
  }
}

/* 横屏适配 */
@media (orientation: landscape) {
  .risk-card {
    padding: 32rpx 24rpx;
  }

  .risk-icon {
    font-size: 70rpx;
  }

  .action-section {
    padding: 16rpx 0 32rpx;
  }

  .action-btn {
    padding: 20rpx;
  }
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文本溢出处理 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.break-word {
  word-wrap: break-word;
  word-break: break-all;
}

/* AI报告卡片 */
.ai-report-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.report-card-header {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.report-card-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.quota-exhausted-notice {
  background: rgba(255, 200, 50, 0.2);
  border: 1rpx solid rgba(255, 200, 50, 0.5);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  color: #FFE082;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  line-height: 1.8;
}

.upgrade-link {
  display: block;
  color: #FFD54F;
  font-weight: 600;
  text-decoration: underline;
  margin-top: 6rpx;
}

.report-card-price {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-link {
  color: #667eea;
  font-size: 24rpx;
  font-weight: 500;
}

.price-tag {
  color: #ffd700;
  font-size: 36rpx;
  font-weight: bold;
}

.report-btn {
  background: #ffffff;
  color: #667eea;
  border-radius: 40rpx;
  font-weight: bold;
}

/* 已购买报告 */
.report-purchased-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.purchased-header {
  font-size: 30rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.view-report-btn {
  background: #4A90E2;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* === 支付选项面板 === */

.pay-options-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.pay-options-panel {
  width: 100%;
  max-width: 750rpx;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.pay-panel-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.pay-panel-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.pay-panel-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.pay-option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
  transition: all 200ms ease;
}

.pay-option-recommend {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.04);
}

.pay-option-hover {
  transform: scale(0.98);
  background: #f9f9fb;
}

.pay-recommend-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 0 12rpx;
}

.pay-option-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.pay-option-icon {
  font-size: 48rpx;
}

.pay-option-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pay-option-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.pay-option-desc {
  font-size: 22rpx;
  color: #999;
}

.pay-option-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #f5222d;
  flex-shrink: 0;
}

.pay-option-price small {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
}

.pay-panel-cancel {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 20rpx 0 0;
}