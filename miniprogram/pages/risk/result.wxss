/* 风险结果页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 风险卡片 */
.risk-card {
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  color: white;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.risk-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.risk-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.risk-description {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 信息区域 */
.info-section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.rule-info {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

/* 宠物信息 */
.pet-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  min-width: 160rpx;
}

.info-value {
  color: #333;
  font-weight: bold;
}

/* 症状标签 */
.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.symptom-tag {
  padding: 8rpx 16rpx;
  background-color: #e6f7ff;
  color: #4A90E2;
  border-radius: 4rpx;
  font-size: 24rpx;
}

/* 免责声明 */
.disclaimer-section {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.disclaimer-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 操作按钮 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 0;
}

.emergency-btn {
  background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%);
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.primary-btn {
  background: #4A90E2;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  border: none;
}

.secondary-btn {
  background: #f0f0f0;
  color: #333;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  border: none;
}