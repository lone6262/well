<!--风险结果页面-->
<view class="container">
  <!-- 风险等级卡片 -->
  <view class="risk-card" style="background-color: {{riskDisplayInfo.color}};">
    <view class="risk-icon">{{riskDisplayInfo.icon}}</view>
    <view class="risk-title">{{riskDisplayInfo.title}}</view>
    <view class="risk-description">{{riskDisplayInfo.description}}</view>
  </view>

  <!-- 匹配规则说明 -->
  <view class="info-section">
    <view class="section-title">评估依据</view>
    <view class="rule-info">{{matchedRule}}</view>
  </view>

  <!-- 宠物信息 -->
  <view class="info-section">
    <view class="section-title">宠物信息</view>
    <view class="pet-info">
      <view class="info-item">
        <text class="info-label">宠物名称：</text>
        <text class="info-value">{{petInfo.name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">宠物类型：</text>
        <text class="info-value">{{petInfo.type === 'cat' ? '猫' : '狗'}}</text>
      </view>
    </view>
  </view>

  <!-- 已选症状 -->
  <view class="info-section">
    <view class="section-title">已选症状</view>
    <view class="symptom-tags">
      <view class="symptom-tag" wx:for="{{selectedSymptoms}}" wx:key="*this">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-section">
    <view class="disclaimer-title">⚠️ 免责声明</view>
    <view class="disclaimer-content">
      本评估结果基于您提供的症状信息，由规则引擎辅助生成，不能作为最终诊断依据。若宠物出现持续恶化、痛苦加剧或高风险提示，请务必及时就医。
    </view>
  </view>

  <!-- AI报告入口卡片（高风险不显示，优先就医） -->
  <view class="ai-report-card" wx:if="{{!loading && quotaInfo && !reportPurchased && riskLevel !== 'high'}}">
    <view class="report-card-header">📋 AI健康报告</view>
    <view class="report-card-desc">包含症状分析、护理建议、就医指导等8大章节</view>
    <!-- 会员额度耗尽提示 -->
    <view class="quota-exhausted-notice" wx:if="{{quotaInfo.member_quota_exhausted}}">
      <text>⚠️ 本月免费额度已用完（{{quotaInfo.member_quota_used}}/{{quotaInfo.member_quota_total}}），本次 ¥9.90</text>
      <text class="upgrade-link" bindtap="goToMember">升级年度会员，每月更多免费额度 →</text>
    </view>
    <view class="report-card-price">
      <text class="price-tag" wx:if="{{quotaInfo.quota_source === 'first_report'}}">首份仅需 ¥1.00</text>
      <text class="price-tag" wx:elif="{{quotaInfo.has_free_quota}}">免费获取</text>
      <text class="price-tag" wx:else>¥9.90</text>
      <text class="member-link" wx:if="{{quotaInfo.quota_source === 'paid' && !quotaInfo.member_quota_exhausted}}" bindtap="goToMember">成为会员，免费获取 →</text>
    </view>
    <!-- 合规：付费前固定提示 -->
    <view class="compliance-notice">
      ⚕️ 本报告仅为健康参考，不构成医疗诊断，如有紧急症状请立即就医
    </view>
    <button class="report-btn" bindtap="getAIReport" loading="{{purchasing}}">
      {{quotaInfo.has_free_quota && quotaInfo.price === 0 ? '免费获取报告' : '获取AI报告'}}
    </button>
  </view>

  <!-- 已有报告提示（高风险不显示） -->
  <view class="report-purchased-card" wx:if="{{!loading && reportPurchased && riskLevel !== 'high'}}">
    <view class="purchased-header">✅ 已获取AI报告</view>
    <button class="view-report-btn" bindtap="viewExistingReport">查看报告详情</button>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <!-- 高风险：全屏红色警告 + 紧急操作 -->
    <block wx:if="{{riskLevel === 'high'}}">
      <view class="high-risk-warning-box">
        <view class="warning-icon">🚨</view>
        <view class="warning-title">您的宠物可能处于危险中</view>
        <view class="warning-desc">检测到高风险症状，请立即联系附近宠物医院，切勿延误。</view>
        <view class="warning-symptoms">
          <text class="warning-symptom-tag" wx:for="{{selectedSymptoms}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="warning-note">⚠️ AI 报告无法替代紧急救治，请优先就医</view>
      </view>
      <button class="emergency-btn" bindtap="goToEmergency">
        🚨 前往急救通道
      </button>
      <button class="primary-btn" bindtap="viewHospitals">
        🏥 查看附近医院
      </button>
    </block>

    <!-- 中风险：显示查看医院和返回首页按钮 -->
    <block wx:if="{{riskLevel === 'mid'}}">
      <button class="primary-btn" bindtap="viewHospitals">
        🏥 查看附近医院
      </button>
      <button class="secondary-btn" bindtap="goHome">
        返回首页
      </button>
    </block>

    <!-- 低风险：只显示返回首页按钮 -->
    <button class="secondary-btn" wx:if="{{riskLevel === 'low'}}" bindtap="goHome">
      返回首页
    </button>
  </view>

  <!-- 支付选项面板 -->
  <view class="pay-options-mask" wx:if="{{showPayOptions}}" bindtap="closePayOptions">
    <view class="pay-options-panel" catchtap="">
      <view class="pay-panel-header">
        <text class="pay-panel-title">获取AI健康报告</text>
        <text class="pay-panel-desc">包含症状分析、护理建议、就医指导等8大章节</text>
      </view>
      <view class="pay-option-item" bindtap="paySingleReport" hover-class="pay-option-hover">
        <view class="pay-option-left">
          <text class="pay-option-icon">📋</text>
          <view class="pay-option-info">
            <text class="pay-option-name">单份报告</text>
            <text class="pay-option-desc">一次性获取完整AI报告</text>
          </view>
        </view>
        <text class="pay-option-price">¥9.90</text>
      </view>
      <view class="pay-option-item pay-option-recommend" bindtap="chooseMembership" hover-class="pay-option-hover">
        <view class="pay-recommend-badge">推荐</view>
        <view class="pay-option-left">
          <text class="pay-option-icon">👑</text>
          <view class="pay-option-info">
            <text class="pay-option-name">开通会员</text>
            <text class="pay-option-desc">每月3份免费报告 + 无限自查</text>
          </view>
        </view>
        <text class="pay-option-price">¥19.90<small>/月</small></text>
      </view>
      <view class="pay-panel-cancel" bindtap="closePayOptions">取消</view>
    </view>
  </view>

  <!-- 免责声明强制勾选弹窗 -->
  <view class="disclaimer-modal-mask" wx:if="{{showDisclaimerModal}}">
    <view class="disclaimer-modal">
      <view class="disclaimer-modal-title">⚠️ 重要声明</view>
      <view class="disclaimer-modal-content">
        <view class="disclaimer-modal-item">1. 本 AI 健康报告仅为健康参考，<text class="disclaimer-highlight">不构成兽医诊断</text>。</view>
        <view class="disclaimer-modal-item">2. 如您的宠物出现紧急症状（抽搐、昏迷、大出血等），请立即就医，不要等待报告。</view>
        <view class="disclaimer-modal-item">3. 报告内容基于您提供的症状信息，由 AI 辅助生成，可能存在局限性。</view>
      </view>
      <view class="disclaimer-checkbox-row" bindtap="toggleDisclaimerAgree">
        <view class="disclaimer-checkbox {{disclaimerAgreed ? 'checked' : ''}}">
          <text wx:if="{{disclaimerAgreed}}">✓</text>
        </view>
        <text class="disclaimer-checkbox-label">我已知晓并同意以上声明</text>
      </view>
      <button class="disclaimer-confirm-btn {{disclaimerAgreed ? '' : 'disabled'}}" bindtap="confirmDisclaimer">
        确认并继续
      </button>
    </view>
  </view>
</view>