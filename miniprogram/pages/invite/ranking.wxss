/* ===================================
   邀请排行榜页面 - 重设计样式
   Invite Ranking Page Styles
   =================================== */

@import "../../utils/ui-components.wxss";

/* === 页面容器 === */
page {
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2f5 100%);
  width: 100%;
}

.ranking-page {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* === 加载状态 === */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* === 领奖台 Banner === */
.podium-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 24rpx 0;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 24rpx;
}

.podium-banner-deco {
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.podium-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.podium-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.podium-slot--1 { order: 2; }
.podium-slot--2 { order: 1; }
.podium-slot--3 { order: 3; }

.podium-face {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.2);
}
.podium-face--1 {
  width: 120rpx;
  height: 120rpx;
  border-color: #ffd700;
}

.podium-crown {
  font-size: 36rpx;
  position: absolute;
  top: -16rpx;
}

.podium-nick {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.podium-score {
  font-size: 22rpx;
  color: #ffd700;
  font-weight: 700;
  margin-bottom: 8rpx;
}

/* 领奖台高度柱 */
.podium-bar {
  width: 100rpx;
  border-radius: 12rpx 12rpx 0 0;
}
.podium-bar--1 {
  height: 80rpx;
  background: linear-gradient(180deg, #ffd700, rgba(255, 215, 0, 0.3));
}
.podium-bar--2 {
  height: 56rpx;
  background: linear-gradient(180deg, #c0c0c0, rgba(192, 192, 192, 0.3));
}
.podium-bar--3 {
  height: 40rpx;
  background: linear-gradient(180deg, #cd7f32, rgba(205, 127, 50, 0.3));
}

/* === 空状态 === */
.ranking-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
}
.ranking-empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}
.ranking-empty-title {
  font-size: 30rpx;
  color: #212121;
  margin-bottom: 8rpx;
  font-weight: 500;
}
.ranking-empty-hint {
  font-size: 24rpx;
  color: #757575;
}

/* === 排行列表 === */
.rank-list {
  padding: 0 24rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}
.rank-row--even {
  background: #fafbff;
}

.rank-num {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #999;
  flex-shrink: 0;
}
.rank-face {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 16rpx;
  background: #eee;
}
.rank-nick {
  flex: 1;
  font-size: 28rpx;
  color: #212121;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-score {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 700;
}

/* === 我的排名 - 固定底部 === */
.my-rank {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(102, 126, 234, 0.2);
  z-index: 100;
}

.my-rank-inner {
  display: flex;
  align-items: center;
  max-width: 750rpx;
  margin: 0 auto;
}

.my-rank-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 16rpx;
}
.my-rank-position {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffd700;
  margin-right: 16rpx;
}
.my-rank-detail {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: auto;
}

/* ===================================
   响应式断点 Responsive Breakpoints
   =================================== */

/* 极小屏幕（iPhone SE 等） */
@media (max-width: 321px) {
  .podium-face {
    width: 72rpx;
    height: 72rpx;
  }
  .podium-face--1 {
    width: 96rpx;
    height: 96rpx;
  }
  .podium-bar { width: 80rpx; }
  .podium-bar--1 { height: 60rpx; }
  .podium-bar--2 { height: 44rpx; }
  .podium-bar--3 { height: 32rpx; }
  .podium-nick { font-size: 20rpx; max-width: 100rpx; }
  .podium-score { font-size: 18rpx; }
  .podium-crown { font-size: 28rpx; }
}

/* 小屏幕 */
@media (max-width: 375px) {
  .podium-banner { padding: 32rpx 16rpx 0; }
  .podium-row { gap: 12rpx; }
}

/* 大屏幕 */
@media (min-width: 414px) {
  .podium-face {
    width: 112rpx;
    height: 112rpx;
  }
  .podium-face--1 {
    width: 140rpx;
    height: 140rpx;
  }
  .podium-bar { width: 120rpx; }
  .podium-bar--1 { height: 100rpx; }
  .podium-bar--2 { height: 72rpx; }
  .podium-bar--3 { height: 56rpx; }
}

/* 横屏 */
@media (orientation: landscape) {
  .podium-banner { padding: 24rpx 24rpx 0; }
  .podium-bar--1 { height: 60rpx; }
  .podium-bar--2 { height: 44rpx; }
  .podium-bar--3 { height: 32rpx; }
  .ranking-page { padding-bottom: 100rpx; }
}
