/* ===================================
   邀请好友页面 - 重设计样式
   Invite Friends Page Styles
   =================================== */

@import "../../utils/ui-components.wxss";

/* === 页面容器 === */
page {
  background: var(--bg-secondary);
  width: 100%;
}

.invite-page {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* === 加载状态 === */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* === Hero 统计卡片 === */
.invite-hero {
  background: var(--brand-primary);
  border-radius: 24rpx;
  padding: 36rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

/* 装饰性圆形 */
.hero-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.hero-decoration-1 {
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
}
.hero-decoration-2 {
  bottom: -40rpx;
  left: -30rpx;
  width: 150rpx;
  height: 150rpx;
}

/* 统计网格 - 默认2x2 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #fff;
}
.stats-value--pending { color: #ffd700; }
.stats-value--success { color: var(--color-success); }
.stats-value--reward { color: #ffd700; }

.stats-caption {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* === 里程碑进度 === */
.milestone-track {
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  padding-top: 20rpx;
  position: relative;
  z-index: 1;
}

.milestone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.milestone-label {
  font-size: 24rpx;
}
.milestone-counter {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffd700;
}

.milestone-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}
.milestone-fill {
  height: 100%;
  background: var(--brand-accent);
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.milestone-badge {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(82, 196, 26, 0.2);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-success);
}

/* === 操作按钮 === */
.action-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}
.action-btn::after { border: none; }
.action-btn:active {
  transform: scale(0.97);
}

.action-btn--primary {
  background: var(--brand-primary);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.action-btn--outline {
  background: var(--bg-card);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.action-label {
  font-size: 28rpx;
}

/* === 规则卡片 === */
.rules-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.rules-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.rules-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.rules-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.rules-steps {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.step-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
}
.step-card--1 { background: var(--brand-primary-light); }
.step-card--2 { background: rgba(16, 185, 129, 0.06); }
.step-card--3 { background: rgba(255, 179, 0, 0.06); }

.step-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.step-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.step-detail {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.step-connector {
  width: 2rpx;
  height: 16rpx;
  background: var(--border-color);
  margin-left: 39rpx;
}

/* === 排行预览卡片 === */
.ranking-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.ranking-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ranking-card-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.ranking-card-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.ranking-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.ranking-card-link {
  font-size: 24rpx;
  color: var(--brand-primary);
  padding: 8rpx 16rpx;
}

.ranking-card-list { /* container */ }

.ranking-card-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.ranking-card-item:last-child { border-bottom: none; }

.rank-medal {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.rank-medal-icon {
  width: 32rpx;
  height: 32rpx;
}
.rank-medal-text {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--brand-primary);
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 16rpx;
  background: var(--border-color);
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-count {
  font-size: 24rpx;
  color: var(--brand-primary);
  font-weight: 700;
}

/* === 海报画布（隐藏）=== */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* ===================================
   响应式断点 Responsive Breakpoints
   =================================== */

/* 极小屏幕（iPhone SE 等） */
@media (max-width: 321px) {
  .invite-page {
    padding: 16rpx 16rpx 0;
  }
  .stats-grid {
    gap: 12rpx;
  }
  .stats-value {
    font-size: 36rpx;
  }
  .stats-caption {
    font-size: 20rpx;
  }
  .action-btn {
    height: 80rpx;
    font-size: 26rpx;
  }
  .action-icon {
    font-size: 28rpx;
  }
  .step-card {
    padding: 12rpx;
  }
  .step-detail {
    font-size: 20rpx;
  }
  .ranking-card-title {
    font-size: 28rpx;
  }
}

/* 小屏幕 */
@media (max-width: 375px) {
  .invite-hero {
    padding: 28rpx 16rpx 20rpx;
  }
  .stats-grid {
    gap: 16rpx;
  }
  .stats-value {
    font-size: 40rpx;
  }
  .action-group {
    gap: 12rpx;
  }
  .step-card {
    padding: 12rpx;
  }
}

/* 大屏幕 */
@media (min-width: 414px) {
  .stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .stats-value {
    font-size: 48rpx;
  }
  .stats-caption {
    font-size: 24rpx;
  }
  .action-btn {
    height: 96rpx;
  }
  .step-card {
    padding: 20rpx;
  }
}

/* 横屏 */
@media (orientation: landscape) {
  .invite-page {
    padding: 16rpx 24rpx 0;
  }
  .stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .action-group {
    max-width: 600rpx;
    margin-left: auto;
    margin-right: auto;
  }
}
