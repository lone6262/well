/* 宠物起名 */
.page-container { padding: var(--spacing-xl); min-height: 100vh; background: var(--bg-color); }
.page-header { margin-bottom: var(--spacing-xl); }
.page-title { display: block; font-size: var(--font-size-xl); font-weight: 700; color: var(--text-primary); }
.page-subtitle { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); }
.name-display { display: flex; align-items: center; justify-content: center; min-height: 200rpx; margin: var(--spacing-xl) 0; }
.name-text { font-size: var(--font-size-4xl); font-weight: 700; color: var(--brand-primary); }
.btn-row { display: flex; gap: var(--spacing-md); margin-bottom: var(--spacing-md); }
.gen-btn { flex: 1; background: var(--bg-card); color: var(--text-primary); border-radius: var(--radius-xl); font-size: var(--font-size-base); border: 2rpx solid var(--border-color); }
.gen-btn.primary { background: var(--brand-primary); color: var(--text-inverse); font-weight: 600; border: none; }
.history { margin-top: var(--spacing-xl); }
.history-title { font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--spacing-md); display: block; }
.history-list { display: flex; flex-wrap: wrap; gap: var(--spacing-md); }
.history-tag { padding: var(--spacing-sm) var(--spacing-lg); background: var(--bg-card); border-radius: var(--radius-full); font-size: var(--font-size-sm); color: var(--text-secondary); }

