/* 养宠工具中心 */
.tools-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-2xl);
}

.tools-header {
  padding: var(--spacing-lg) 0 var(--spacing-xl);
  display: flex;
  flex-direction: column;
}

.tools-title {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--text-primary);
  line-height: var(--line-height-tight);
}

.tools-subtitle {
  font-size: var(--font-size-base);
  color: var(--text-tertiary);
  margin-top: var(--spacing-xs);
}

/* 工具网格 */
.tools-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-lg);
}

.tool-card {
  width: calc(50% - var(--spacing-lg) / 2);
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: var(--spacing-xl) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  transition: all var(--duration-fast) var(--ease-standard);
}

.tool-card-hover {
  transform: scale(0.97);
  box-shadow: var(--shadow-xs);
}

.tool-card-coming {
  opacity: 0.5;
}

/* 工具图标（统一陶土浅底 + SVG 图标）*/
.tool-card-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-2xl);
  background-color: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.tool-card-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 工具文字 */
.tool-card-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.tool-card-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
}

.tool-card-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  text-align: center;
}

/* 底部 AI 报告引导（固态品牌底，无渐变）*/
.tools-cta {
  margin-top: var(--spacing-2xl);
  background: var(--brand-primary);
  border-radius: var(--radius-2xl);
  padding: var(--spacing-xl) var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-md);
}

.tools-cta-content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  flex: 1;
}

.tools-cta-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-on-brand);
}

.tools-cta-desc {
  font-size: var(--font-size-sm);
  color: var(--text-on-brand-muted);
}

.tools-cta-btn {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  background-color: var(--bg-on-brand-subtle);
  border-radius: var(--radius-full);
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--text-on-brand);
  font-weight: 500;
  white-space: nowrap;
}

.tools-cta-arrow {
  font-size: var(--font-size-md);
}
