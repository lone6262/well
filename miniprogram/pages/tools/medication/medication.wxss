/* 常用药速查 */
.page-container { padding: var(--spacing-xl); min-height: 100vh; background: var(--bg-color); }
.page-header { margin-bottom: var(--spacing-xl); }
.page-title { display: block; font-size: var(--font-size-xl); font-weight: 700; color: var(--text-primary); }
.page-subtitle { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); }
.search-bar { margin-bottom: var(--spacing-lg); }
.search-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 0 var(--spacing-lg);
  font-size: var(--font-size-base);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  transition: border-color var(--duration-base) var(--ease-standard);
}
.search-input:focus { border-color: var(--brand-primary); }
.med-list { display: flex; flex-direction: column; gap: var(--spacing-md); }
.med-card { background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--spacing-lg); box-shadow: var(--shadow-xs); border-left: 4rpx solid var(--color-success); }
.med-card.caution { border-left-color: var(--color-warning); }
.med-card.danger { border-left-color: var(--color-danger); }
.med-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-sm); }
.med-name { font-size: var(--font-size-md); font-weight: 700; color: var(--text-primary); }
.med-badges { display: flex; gap: var(--spacing-xs); }
.med-badge { padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 600; }
.med-badge.safe { background: var(--color-success-light); color: var(--color-success); }
.med-badge.caution { background: var(--color-warning-light); color: var(--color-warning); }
.med-badge.danger { background: var(--color-danger-light); color: var(--color-danger); }
.med-dose { font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--spacing-xs); }
.med-note { font-size: var(--font-size-sm); color: var(--text-tertiary); line-height: var(--line-height-normal); }
.disclaimer { margin-top: var(--spacing-xl); padding: var(--spacing-lg); background: var(--color-warning-light); border-radius: var(--radius-lg); border-left: 4rpx solid var(--color-warning); }
.disclaimer text { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-normal); }

