/* 发情周期 */
.page-container { padding: var(--spacing-xl); min-height: 100vh; background: var(--bg-color); }
.page-header { margin-bottom: var(--spacing-xl); }
.page-title { display: block; font-size: var(--font-size-xl); font-weight: 700; color: var(--text-primary); }
.page-subtitle { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); }
.pet-switcher { display: flex; gap: var(--spacing-md); margin-bottom: var(--spacing-xl); }
.switch-btn { flex: 1; text-align: center; padding: var(--spacing-md); border-radius: var(--radius-lg); background: var(--bg-card); font-size: var(--font-size-base); color: var(--text-secondary); border: 2rpx solid var(--border-color); }
.switch-btn.active { background: var(--brand-primary); color: var(--text-inverse); border-color: var(--brand-primary); font-weight: 600; }
.form-group { margin-bottom: var(--spacing-lg); }
.form-label { display: block; font-size: var(--font-size-base); color: var(--text-secondary); margin-bottom: var(--spacing-sm); }
.picker-value {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 0 var(--spacing-lg);
  font-size: var(--font-size-base);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
}
.calc-btn { background: var(--brand-primary); color: var(--text-inverse); border-radius: var(--radius-xl); font-size: var(--font-size-base); font-weight: 600; margin-top: var(--spacing-md); }
.result-card { background: var(--bg-card); border-radius: var(--radius-2xl); padding: var(--spacing-lg); margin-top: var(--spacing-lg); box-shadow: var(--shadow-sm); text-align: center; }
.result-label { font-size: var(--font-size-sm); color: var(--text-secondary); }
.result-date { font-size: var(--font-size-2xl); font-weight: 700; color: var(--brand-primary); margin: var(--spacing-md) 0; }
.result-info { text-align: left; font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-relaxed); margin-top: var(--spacing-md); }
.result-note { font-size: var(--font-size-sm); color: var(--text-tertiary); margin-top: var(--spacing-md); line-height: var(--line-height-normal); text-align: left; padding: var(--spacing-md); background: var(--bg-secondary); border-radius: var(--radius-md); }

