/* 疫苗时间表 */
.page-container { padding: var(--spacing-xl); min-height: 100vh; background: var(--bg-color); }
.page-header { margin-bottom: var(--spacing-xl); }
.page-title { display: block; font-size: var(--font-size-xl); font-weight: 700; color: var(--text-primary); }
.page-subtitle { display: block; font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); }
.pet-switcher { display: flex; gap: var(--spacing-md); margin-bottom: var(--spacing-xl); }
.switch-btn { flex: 1; text-align: center; padding: var(--spacing-md); border-radius: var(--radius-lg); background: var(--bg-card); font-size: var(--font-size-base); color: var(--text-secondary); border: 2rpx solid var(--border-color); }
.switch-btn.active { background: var(--brand-primary); color: var(--text-inverse); border-color: var(--brand-primary); font-weight: 600; }
.timeline { position: relative; padding-left: var(--spacing-md); }
.timeline-item { position: relative; padding-bottom: var(--spacing-xl); padding-left: var(--spacing-xl); border-left: 4rpx solid var(--border-light); }
.timeline-item:last-child { border-left-color: transparent; }
.timeline-dot { position: absolute; left: -14rpx; top: var(--spacing-xs); width: 24rpx; height: 24rpx; border-radius: var(--radius-full); background: var(--brand-primary); border: 4rpx solid var(--bg-card); }
.timeline-content { background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--spacing-lg); box-shadow: var(--shadow-xs); }
.timeline-age { font-size: var(--font-size-sm); font-weight: 700; color: var(--brand-primary); }
.timeline-vaccine { font-size: var(--font-size-base); font-weight: 600; color: var(--text-primary); margin-top: var(--spacing-xs); }
.timeline-desc { font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--spacing-xs); line-height: var(--line-height-normal); }
.disclaimer { margin-top: var(--spacing-xl); padding: var(--spacing-lg); background: var(--color-warning-light); border-radius: var(--radius-lg); border-left: 4rpx solid var(--color-warning); }
.disclaimer text { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-normal); }

