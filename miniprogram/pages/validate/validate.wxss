/* pages/validate/validate.wxss */
.validate-page {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 环境ID区域 */
.env-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.env-id-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-secondary);
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.env-id {
  font-family: monospace;
  font-size: 28rpx;
  color: var(--text-primary);
  word-break: break-all;
}

.copy-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: var(--brand-primary);
  color: var(--text-on-brand);
  border: none;
  border-radius: 6rpx;
}

.help-text {
  text-align: center;
}

.link {
  color: var(--brand-primary);
  font-size: 26rpx;
  text-decoration: underline;
}

/* 验证结果 */
.result-section {
  margin-bottom: 30rpx;
}

.result-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: var(--shadow-md);
}

.result-card.success {
  border-left: 6rpx solid var(--color-success);
}

.result-card.error {
  border-left: 6rpx solid var(--color-danger);
}

.result-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.result-content {
  flex: 1;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.result-message {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.result-suggestion {
  font-size: 26rpx;
  color: var(--color-warning);
  background: var(--color-warning-light);
  padding: 15rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

/* 操作按钮 */
.action-section {
  margin-bottom: 30rpx;
}

.validate-btn {
  background: var(--brand-primary);
  color: var(--text-on-brand);
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.validate-btn[disabled] {
  background: var(--text-disabled);
}

.clear-btn {
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx;
}

/* 日志区域 */
.log-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-md);
}

.log-container {
  max-height: 500rpx;
  background: var(--bg-terminal);
  border-radius: 8rpx;
  padding: 15rpx;
}

.log-item {
  font-family: monospace;
  font-size: 24rpx;
  color: var(--text-terminal);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* 使用说明 */
.guide-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-md);
}

.guide-content {
  margin-top: 20rpx;
}

.guide-item {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 15rpx;
  padding-left: 20rpx;
}
