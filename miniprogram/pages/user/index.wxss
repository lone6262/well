/* 用户中心页面样式 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  padding: 60rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  color: white;
  position: relative;
}

/* 用户操作按钮 */
.user-actions {
  position: absolute;
  top: 60rpx;
  right: 32rpx;
}

.login-btn {
  background: white;
  color: #4A90E2;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border: none;
  font-weight: bold;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid white;
}

.user-avatar {
  margin-right: 24rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid white;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.user-status {
  display: flex;
  align-items: center;
}

.member-badge {
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.member-badge.active {
  background: #f5e6a3;
  color: #8a6d3b;
}

/* 菜单区域 */
.menu-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 免责声明 */
.disclaimer-section {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.disclaimer-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}