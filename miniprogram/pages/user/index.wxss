/* ===================================
   现代化用户中心页面样式 - 重构版
   Modern User Center Styles - Redesign
   =================================== */

@import "../../utils/design-tokens.wxss";

/* === 页面容器 === */

.user-center-page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 96rpx;
}

/* === 用户信息卡片 === */

.user-profile-card {
  background: var(--bg-card);
  margin: 16rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
  overflow: hidden;
}

.profile-content {
  padding: 32rpx 24rpx;
}

/* === 用户信息区域 === */

.user-info-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.user-avatar-wrapper {
  position: relative;
  margin-bottom: 16rpx;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--rounded-full, 9999rpx);
  border: 4rpx solid var(--border-color);
  background: var(--bg-secondary);
}

.user-details-wrapper {
  text-align: center;
  margin-bottom: 24rpx;
  width: 100%;
}

.user-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.user-name-text {
  font-size: var(--text-xl, 40rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary);
  margin-right: 8rpx;
}

.edit-name-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  transition: var(--transition, all 200ms ease);
}

.edit-name-btn:active {
  transform: scale(0.95);
  background: var(--border-color);
}

.edit-icon {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.user-status-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: var(--brand-primary-light);
  border-radius: var(--rounded-full, 9999rpx);
}

.status-text {
  font-size: var(--text-sm, 24rpx);
  color: var(--brand-primary-dark);
  font-weight: var(--font-medium, 500);
}

/* === 头像编辑提示 === */
.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 0 0 12rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-text {
  font-size: 20rpx;
  color: var(--bg-card);
  font-weight: 500;
}

/* === 用户操作按钮 === */

.user-actions-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
}

.action-button {
  padding: 12rpx 32rpx;
  border-radius: var(--rounded-full, 9999rpx);
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-medium, 500);
  border: none;
  min-width: 200rpx;
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.action-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.primary-button {
  background: var(--brand-primary);
  color: var(--bg-card);
}

.secondary-button {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

/* === 用户数据统计 === */

.user-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.stat-item {
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: var(--rounded-lg, 12rpx);
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.stat-item:active {
  background: var(--bg-secondary);
}

.stat-number {
  display: block;
  font-size: var(--text-2xl, 48rpx);
  font-weight: var(--font-bold, 700);
  color: var(--brand-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: var(--text-xs, 20rpx);
  color: var(--text-secondary);
}

/* === 宠物快捷入口 === */

.pets-section {
  margin: 16rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--text-lg, 36rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary);
}

.section-more {
  font-size: var(--text-sm, 24rpx);
  color: var(--brand-primary);
}

.pets-scroll {
  white-space: nowrap;
}

.pet-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 120rpx;
  padding: 16rpx;
  background: var(--bg-secondary);
  border-radius: var(--rounded-lg, 12rpx);
  margin-right: 12rpx;
  vertical-align: top;
  position: relative;
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.pet-card:active {
  background: var(--border-color);
  transform: scale(0.98);
}

.pet-avatar {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-card);
  border-radius: var(--rounded-full, 9999rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-xs, 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05));
}

.pet-emoji {
  font-size: var(--text-3xl, 56rpx);
}

.pet-emoji image,
.pet-emoji img {
  width: 40rpx;
  height: 40rpx;
}

.pet-emoji-add {
  font-size: var(--text-4xl, 64rpx);
  color: var(--text-tertiary);
}

.pet-name {
  font-size: var(--text-sm, 24rpx);
  color: var(--text-primary);
  font-weight: var(--font-medium, 500);
  text-align: center;
  white-space: normal;
}

.pet-health-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--rounded-full, 9999rpx);
  border: 3rpx solid var(--bg-card);
}

.pet-health-dot.good {
  background: var(--color-success);
}

.pet-health-dot.warning {
  background: var(--color-warning);
}

.pet-health-dot.danger {
  background: var(--brand-emergency);
}

.add-pet-card {
  background: var(--border-color);
  border: 2rpx dashed var(--text-tertiary);
}

/* === 功能菜单区域 === */

.menu-section {
  padding: 0 16rpx 16rpx;
}

.menu-group {
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.menu-header {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-header-title {
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary);
}

.menu-list {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-secondary);
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--rounded-lg, 12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon image,
.menu-icon img {
  width: 28rpx;
  height: 28rpx;
}

.primary-icon {
  background: var(--brand-primary-light);
}

.accent-icon {
  background: var(--brand-emergency);
  opacity: 0.1;
}

.info-icon {
  background: var(--brand-primary-light);
}

.success-icon {
  background: var(--color-success);
  opacity: 0.1;
}

.warning-icon {
  background: var(--color-warning);
  opacity: 0.1;
}

.secondary-icon {
  background: var(--bg-secondary);
}

.gray-icon {
  background: var(--border-color);
}

.icon-text {
  font-size: var(--text-xl, 40rpx);
}

.menu-item-text {
  font-size: var(--text-base, 28rpx);
  color: var(--text-primary);
  font-weight: var(--font-medium, 500);
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-item-count {
  background: var(--brand-emergency);
  opacity: 0.1;
  color: var(--brand-emergency);
  padding: 4rpx 8rpx;
  border-radius: var(--rounded-full, 9999rpx);
  font-size: var(--text-xs, 20rpx);
  font-weight: var(--font-bold, 700);
  min-width: 24rpx;
  text-align: center;
}

.menu-item-tag {
  padding: 4rpx 8rpx;
  border-radius: var(--rounded-md, 8rpx);
  font-size: var(--text-xs, 20rpx);
  font-weight: var(--font-medium, 500);
}

.recommend-tag {
  background: var(--color-warning);
  color: var(--bg-card);
}

.vip-tag {
  background: var(--brand-primary);
  color: var(--bg-card);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.purple-icon {
  background: var(--brand-primary);
  opacity: 0.1;
}

.menu-arrow {
  font-size: var(--text-2xl, 48rpx);
  color: var(--text-tertiary);
  font-weight: var(--font-light, 300);
}

/* === 免责声明 === */

.disclaimer-card {
  margin: 16rpx;
  background: var(--color-warning);
  opacity: 0.1;
  border-radius: 16rpx;
  padding: 16rpx;
  border-left: 4rpx solid var(--color-warning);
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.disclaimer-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.disclaimer-icon {
  font-size: var(--text-lg, 36rpx);
  width: 22rpx;
  height: 22rpx;
}

.disclaimer-title {
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-bold, 700);
  color: var(--color-warning);
}

.disclaimer-text {
  font-size: var(--text-sm, 24rpx);
  color: var(--color-warning);
  line-height: var(--leading-relaxed, 1.75);
}

/* === 版本信息 === */

.version-info {
  text-align: center;
  padding: 16rpx;
}

.version-text {
  font-size: var(--text-xs, 20rpx);
  color: var(--text-tertiary);
}
