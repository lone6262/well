/* ===================================
   现代化用户中心页面样式 - 重构版
   Modern User Center Styles - Redesign
   =================================== */

@import "../../utils/design-tokens.wxss";

/* === 页面容器 === */

.user-center-page {
  min-height: 100vh;
  background: var(--bg-secondary, #f8f9fa);
  padding-bottom: 96rpx;
}

/* === 用户信息卡片 === */

.user-profile-card {
  background: var(--bg-primary, #ffffff);
  margin: 16rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
  overflow: hidden;
}

.profile-content {
  padding: 32rpx 24rpx;
}

/* === 用户信息区域 === */

.user-info-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.user-avatar-wrapper {
  position: relative;
  margin-bottom: 16rpx;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--rounded-full, 9999rpx);
  border: 4rpx solid var(--border-light, #e0e0e0);
  background: var(--bg-gray-100, #f5f5f5);
}

.user-details-wrapper {
  text-align: center;
  margin-bottom: 24rpx;
  width: 100%;
}

.user-name-text {
  font-size: var(--text-xl, 40rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary, #212121);
  margin-bottom: 8rpx;
}

.user-status-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: var(--bg-primary-50, #e3f2fd);
  border-radius: var(--rounded-full, 9999rpx);
}

.status-text {
  font-size: var(--text-sm, 24rpx);
  color: var(--color-primary-600, #1976d2);
  font-weight: var(--font-medium, 500);
}

/* === 用户操作按钮 === */

.user-actions-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
}

.action-button {
  padding: 12rpx 32rpx;
  border-radius: var(--rounded-full, 9999rpx);
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-medium, 500);
  border: none;
  min-width: 200rpx;
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.action-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.primary-button {
  background: var(--color-primary-500, #2196f3);
  color: var(--text-inverse, #ffffff);
}

.secondary-button {
  background: var(--bg-gray-100, #f5f5f5);
  color: var(--text-secondary, #757575);
}

/* === 用户数据统计 === */

.user-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-light, #e0e0e0);
}

.stat-item {
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: var(--rounded-lg, 12rpx);
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.stat-item:active {
  background: var(--bg-gray-50, #fafafa);
}

.stat-number {
  display: block;
  font-size: var(--text-2xl, 48rpx);
  font-weight: var(--font-bold, 700);
  color: var(--color-primary-500, #2196f3);
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: var(--text-xs, 20rpx);
  color: var(--text-secondary, #757575);
}

/* === 宠物快捷入口 === */

.pets-section {
  margin: 16rpx;
  background: var(--bg-primary, #ffffff);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--text-lg, 36rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary, #212121);
}

.section-more {
  font-size: var(--text-sm, 24rpx);
  color: var(--color-primary-500, #2196f3);
}

.pets-scroll {
  white-space: nowrap;
}

.pet-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 120rpx;
  padding: 16rpx;
  background: var(--bg-gray-50, #fafafa);
  border-radius: var(--rounded-lg, 12rpx);
  margin-right: 12rpx;
  vertical-align: top;
  position: relative;
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.pet-card:active {
  background: var(--bg-gray-100, #f5f5f5);
  transform: scale(0.98);
}

.pet-avatar {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-primary, #ffffff);
  border-radius: var(--rounded-full, 9999rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-xs, 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05));
}

.pet-emoji {
  font-size: var(--text-3xl, 56rpx);
}

.pet-emoji-add {
  font-size: var(--text-4xl, 64rpx);
  color: var(--text-tertiary, #9e9e9e);
}

.pet-name {
  font-size: var(--text-sm, 24rpx);
  color: var(--text-primary, #212121);
  font-weight: var(--font-medium, 500);
  text-align: center;
  white-space: normal;
}

.pet-health-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--rounded-full, 9999rpx);
  border: 3rpx solid var(--bg-primary, #ffffff);
}

.pet-health-dot.good {
  background: var(--color-success-500, #4caf50);
}

.pet-health-dot.warning {
  background: var(--color-warning-500, #ffc107);
}

.pet-health-dot.danger {
  background: var(--color-danger-500, #f44336);
}

.add-pet-card {
  background: var(--bg-gray-100, #f5f5f5);
  border: 2rpx dashed var(--border-medium, #bdbdbd);
}

/* === 功能菜单区域 === */

.menu-section {
  padding: 0 16rpx 16rpx;
}

.menu-group {
  background: var(--bg-primary, #ffffff);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.menu-header {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light, #e0e0e0);
}

.menu-header-title {
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-bold, 700);
  color: var(--text-primary, #212121);
}

.menu-list {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light, #e0e0e0);
  transition: var(--transition, all 200ms cubic-bezier(0.4, 0, 0.2, 1));
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-gray-50, #fafafa);
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--rounded-lg, 12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.primary-icon {
  background: var(--bg-primary-100, #bbdefb);
}

.accent-icon {
  background: var(--bg-danger-50, #ffebee);
}

.info-icon {
  background: var(--bg-info-50, #e3f2fd);
}

.success-icon {
  background: var(--bg-success-50, #e8f5e9);
}

.warning-icon {
  background: var(--bg-warning-50, #fff8e1);
}

.secondary-icon {
  background: var(--bg-gray-100, #f5f5f5);
}

.gray-icon {
  background: var(--bg-gray-50, #fafafa);
}

.icon-text {
  font-size: var(--text-xl, 40rpx);
}

.menu-item-text {
  font-size: var(--text-base, 28rpx);
  color: var(--text-primary, #212121);
  font-weight: var(--font-medium, 500);
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-item-count {
  background: var(--bg-danger-50, #ffebee);
  color: var(--color-danger-600, #e53935);
  padding: 4rpx 8rpx;
  border-radius: var(--rounded-full, 9999rpx);
  font-size: var(--text-xs, 20rpx);
  font-weight: var(--font-bold, 700);
  min-width: 24rpx;
  text-align: center;
}

.menu-item-tag {
  padding: 4rpx 8rpx;
  border-radius: var(--rounded-md, 8rpx);
  font-size: var(--text-xs, 20rpx);
  font-weight: var(--font-medium, 500);
}

.recommend-tag {
  background: var(--color-secondary-500, #ff9800);
  color: var(--text-inverse, #ffffff);
}

.menu-arrow {
  font-size: var(--text-2xl, 48rpx);
  color: var(--text-tertiary, #9e9e9e);
  font-weight: var(--font-light, 300);
}

/* === 免责声明 === */

.disclaimer-card {
  margin: 16rpx;
  background: var(--bg-warning-50, #fff8e1);
  border-radius: 16rpx;
  padding: 16rpx;
  border-left: 4rpx solid var(--color-warning-500, #ffc107);
  box-shadow: var(--shadow-sm, 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1));
}

.disclaimer-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.disclaimer-icon {
  font-size: var(--text-lg, 36rpx);
}

.disclaimer-title {
  font-size: var(--text-base, 28rpx);
  font-weight: var(--font-bold, 700);
  color: var(--color-warning-600, #ffb300);
}

.disclaimer-text {
  font-size: var(--text-sm, 24rpx);
  color: var(--color-warning-600, #ffb300);
  line-height: var(--leading-relaxed, 1.75);
}

/* === 版本信息 === */

.version-info {
  text-align: center;
  padding: 16rpx;
}

.version-text {
  font-size: var(--text-xs, 20rpx);
  color: var(--text-tertiary, #9e9e9e);
}
