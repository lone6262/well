/* 自查记录/健康报告列表页面样式 */
.records-page {
  min-height: 100vh;
  background: #f5f6f8;
}

/* === 顶部标题栏 === */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.header-count {
  font-size: 24rpx;
  color: #999;
}

/* === 加载状态 === */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top: 6rpx solid #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* === 记录列表 === */
.records-list {
  padding: 16rpx;
}

.record-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.record-card:active {
  background: #fafafa;
}

/* === 卡片头部 === */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-left {
  flex: 1;
}

.pet-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pet-emoji {
  font-size: 32rpx;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

/* === 风险标签 === */
.risk-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.risk-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

/* === 症状行 === */
.symptoms-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.symptoms-label {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 4rpx;
}

.symptoms-text {
  font-size: 24rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}

/* === 描述预览 === */
.desc-row {
  margin-bottom: 12rpx;
}

.desc-text {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

/* === 底部操作提示 === */
.card-bottom {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.view-detail-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 500;
}

/* === 空状态 === */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* === 加载更多 === */
.load-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin: 8rpx 0 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.load-more-btn:active {
  background: #f5f5f5;
}

.load-more-text {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 500;
}


/* === 删除按钮 === */
.delete-record-btn {
  padding: 8rpx 20rpx;
  background: #FFEBEE;
  color: #FF6B6B;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.delete-record-btn:active {
  background: #FFCDD2;
}
