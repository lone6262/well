/* 自查记录/健康报告列表 — Warm Professionalism v2.0 */
.records-page {
  min-height: 100vh;
  background: var(--bg-secondary);
}

/* === 顶部标题栏 === */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx var(--spacing-lg);
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
}

.header-back {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
}

.back-arrow {
  font-size: var(--font-size-lg);
  color: var(--text-primary);
}

.header-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-primary);
}

.header-count {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* === 记录列表 === */
.records-list { padding: var(--spacing-md); }

.record-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-xs);
}

.record-card:active { background: var(--bg-secondary); }

/* === 卡片头部 === */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-md);
}

.card-left { flex: 1; }

.pet-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pet-emoji { font-size: var(--font-size-md); }

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.record-date {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* === 风险标签 === */
.risk-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.risk-text {
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--text-inverse);
}

/* === 症状行 === */
.symptoms-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.symptoms-label {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-right: 4rpx;
}

.symptoms-text {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  flex: 1;
  line-height: var(--line-height-normal);
}

/* === 描述预览 === */
.desc-row { margin-bottom: 12rpx; }

.desc-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: var(--line-height-normal);
}

/* === 底部操作提示 === */
.card-bottom {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
}

.view-detail-text {
  font-size: var(--font-size-sm);
  color: var(--brand-primary);
  font-weight: 500;
}

/* === 加载更多 === */
.load-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  margin: 8rpx 0 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
}

.load-more-btn:active { background: var(--bg-secondary); }

.load-more-text {
  font-size: 26rpx;
  color: var(--brand-primary);
  font-weight: 500;
}

/* === 删除按钮 === */
.delete-record-btn {
  padding: 8rpx 20rpx;
  background: var(--color-danger-light);
  color: var(--brand-emergency);
  font-size: var(--font-size-xs);
  border-radius: var(--radius-md);
  font-weight: 500;
}

.delete-record-btn:active {
  background: var(--brand-emergency);
  color: var(--text-inverse);
}
