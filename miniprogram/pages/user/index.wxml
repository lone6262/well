<!-- 现代化用户中心页面 Modern User Center Page -->
<view class="user-center-page">

  <!-- 用户信息卡片 -->
  <view class="user-profile-card">
    <view class="profile-content">
      <!-- 用户头像和信息 -->
      <view class="user-info-section">
        <view class="user-avatar-wrapper" bindtap="changeAvatar">
          <image class="avatar-image" src="{{userInfo.avatar || '/images/avatar.png'}}" mode="aspectFill" />
        </view>

        <view class="user-details-wrapper">
          <view class="user-name-row">
            <view class="user-name-text">{{userInfo.nickname || '宠物爱好者'}}</view>
            <view class="edit-name-btn" bindtap="editNickname" wx:if="{{userInfo.isLoggedIn}}">
              <image class="edit-icon" src="/images/icons/clipboard.svg" mode="aspectFit" aria-label="编辑昵称" />
            </view>
          </view>
          <view class="user-status-badge">
            <text class="status-text">{{userInfo.isMember ? '会员用户' : '普通用户'}}</text>
          </view>
        </view>

        <!-- 用户操作按钮 -->
        <view class="user-actions-wrapper">
          <button wx:if="{{!userInfo.isLoggedIn}}" class="action-button primary-button" bindtap="login">
            微信登录
          </button>
          <button wx:else class="action-button secondary-button" bindtap="logout">
            退出登录
          </button>
        </view>
      </view>

      <!-- 用户数据统计 -->
      <view class="user-stats-grid" aria-label="用户统计">
        <view class="stat-item" bindtap="viewHistory">
          <text class="stat-number">{{userStats.checkCount || 0}}</text>
          <text class="stat-label">自查次数</text>
        </view>
        <view class="stat-item" bindtap="viewReports">
          <text class="stat-number">{{userStats.reportCount || 0}}</text>
          <text class="stat-label">健康报告</text>
        </view>
        <view class="stat-item" bindtap="viewPets">
          <text class="stat-number">{{userStats.petCount || 0}}</text>
          <text class="stat-label">宠物档案</text>
        </view>
        <view class="stat-item" bindtap="viewFavorites">
          <text class="stat-number">{{userStats.favoriteCount || 0}}</text>
          <text class="stat-label">收藏医院</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 宠物快捷入口 -->
  <view class="pets-section" wx:if="{{userInfo.isLoggedIn && userPets.length > 0}}">
    <view class="section-header">
      <text class="section-title">我的宠物</text>
      <text class="section-more" bindtap="viewAllPets">查看全部 →</text>
    </view>

    <scroll-view class="pets-scroll" scroll-x="{{true}}" show-scrollbar="false">
      <view class="pet-card" wx:for="{{userPets}}" wx:key="petId" bindtap="viewPetDetail" data-pet="{{item}}">
        <view class="pet-avatar">
          <image class="pet-emoji" src="/images/icons/paw.svg" mode="aspectFit" />
        </view>
        <text class="pet-name">{{item.name}}</text>
        <view class="pet-health-dot {{item.healthStatus}}"></view>
      </view>

      <!-- 添加宠物按钮 -->
      <view class="pet-card add-pet-card" bindtap="addNewPet">
        <view class="pet-avatar">
          <text class="pet-emoji-add">+</text>
        </view>
        <text class="pet-name">添加宠物</text>
      </view>
    </scroll-view>
  </view>

  <!-- 功能菜单区域 -->
  <view class="menu-section">
    <!-- 主要功能 -->
    <view class="menu-group">
      <view class="menu-header">
        <text class="menu-header-title">我的服务</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="viewHistory" aria-label="查看自查记录">
          <view class="menu-item-left">
            <view class="menu-icon primary-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">自查记录</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-count" wx:if="{{userStats.checkCount > 0}}">{{userStats.checkCount}}</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewFollowupRecords" aria-label="查看回访记录">
          <view class="menu-item-left">
            <view class="menu-icon success-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">回访记录</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewReports" aria-label="查看健康报告">
          <view class="menu-item-left">
            <view class="menu-icon accent-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">健康报告</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-count" wx:if="{{userStats.reportCount > 0}}">{{userStats.reportCount}}</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewMemberCenter" aria-label="查看会员中心">
          <view class="menu-item-left">
            <view class="menu-icon purple-icon">
              <image class="menu-icon-img" src="/images/icons/crown.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">会员中心</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-tag vip-tag" wx:if="{{userInfo.isMember}}">VIP</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewOrders" aria-label="查看我的订单">
          <view class="menu-item-left">
            <view class="menu-icon info-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">我的订单</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-count" wx:if="{{userStats.orderCount > 0}}">{{userStats.orderCount}}</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewCoupons" aria-label="我的优惠券">
          <view class="menu-item-left">
            <view class="menu-icon warning-icon">
              <image class="menu-icon-img" src="/images/icons/gift.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">优惠券</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-tag recommend-tag">V1.5</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewPoints" aria-label="积分中心">
          <view class="menu-item-left">
            <view class="menu-icon success-icon">
              <image class="menu-icon-img" src="/images/icons/gift.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">点数中心</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-tag recommend-tag">V1.5</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="viewInvite" aria-label="邀请好友">
          <view class="menu-item-left">
            <view class="menu-icon accent-icon">
              <image class="menu-icon-img" src="/images/icons/gift.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">邀请好友</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-tag recommend-tag">赚额度</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 其他功能 -->
    <view class="menu-group">
      <view class="menu-header">
        <text class="menu-header-title">更多功能</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="shareApp" aria-label="分享给好友">
          <view class="menu-item-left">
            <view class="menu-icon success-icon">
              <image class="menu-icon-img" src="/images/icons/paw.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">分享给好友</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-item-tag recommend-tag">推荐</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="contactUs" aria-label="联系我们">
          <view class="menu-item-left">
            <view class="menu-icon warning-icon">
              <image class="menu-icon-img" src="/images/icons/phone.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">联系我们</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="about" aria-label="关于我们">
          <view class="menu-item-left">
            <view class="menu-icon secondary-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">关于我们</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-item" bindtap="settings" aria-label="设置">
          <view class="menu-item-left">
            <view class="menu-icon gray-icon">
              <image class="menu-icon-img" src="/images/icons/clipboard.svg" mode="aspectFit" />
            </view>
            <text class="menu-item-text">设置</text>
          </view>
          <view class="menu-item-right">
            <text class="menu-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-card">
    <view class="disclaimer-header">
      <image class="disclaimer-icon" src="/images/icons/warning.svg" mode="aspectFit" aria-label="重要提示" />
      <text class="disclaimer-title">重要提示</text>
    </view>
    <text class="disclaimer-text">
      本工具提供的宠物健康建议仅供参考，不能替代专业兽医的诊断与治疗。如宠物出现严重症状，请立即就医。
    </text>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">版本 {{appVersion || '1.0.0'}}</text>
  </view>

</view>
