<!--自查记录/健康报告列表页面-->
<view class="records-page">

  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="header-back" bindtap="goBack">
      <text class="back-arrow">←</text>
    </view>
    <text class="header-title">{{pageTitle}}</text>
    <text class="header-count">共{{records.length}}条</text>
  </view>

  <state-view
    wx:if="{{loading}}"
    type="loading"
    title="正在加载记录..."
  />

  <!-- 记录列表 -->
  <view class="records-list" wx:if="{{!loading}}">
    <view class="record-card"
          wx:for="{{records}}"
          wx:key="_id"
          bindtap="viewDetail"
          data-record="{{item}}">

      <!-- 卡片头部 -->
      <view class="card-top">
        <view class="card-left">
          <view class="pet-info-row">
            <image class="pet-emoji" src="{{item.petType === 'cat' ? '/images/icons/cat.svg' : '/images/icons/dog.svg'}}" aria-label="{{item.petType === 'cat' ? '猫' : '狗'}}" style="width:36rpx;height:36rpx;" />
            <text class="pet-name">{{item.petName}}</text>
          </view>
          <text class="record-date">{{item.dateText}}</text>
        </view>
        <view class="risk-badge" style="background-color: {{item.riskColor}};">
          <text class="risk-text">{{item.riskText}}</text>
        </view>
      </view>

      <!-- 症状标签 -->
      <view class="symptoms-row" wx:if="{{item.symptomsText}}">
        <text class="symptoms-label">症状：</text>
        <text class="symptoms-text">{{item.symptomsText}}</text>
      </view>

      <!-- 描述预览 -->
      <view class="desc-row" wx:if="{{item.description}}">
        <text class="desc-text">{{item.description}}</text>
      </view>

      <!-- 底部操作提示 -->
      <view class="card-bottom">
        <text class="view-detail-text">点击查看详情 ›</text>
        <view class="delete-record-btn" catchtap="deleteRecord" data-id="{{item._id}}">删除</view>
      </view>
    </view>

    <state-view
      wx:if="{{records.length === 0}}"
      type="empty"
      icon="clipboard"
      title="暂无{{pageTitle}}"
      description="进行症状自查后记录将显示在这里"
    />

    <!-- 加载更多 -->
    <view class="load-more-btn" wx:if="{{hasMore}}" bindtap="loadMore">
      <text class="load-more-text">加载更多</text>
    </view>
  </view>

</view>
