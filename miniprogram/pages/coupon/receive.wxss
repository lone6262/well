.receive-page { background: var(--bg-secondary); min-height: 100vh; padding: 20rpx; }
.coupon-card { display: flex; background: var(--bg-card); border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.coupon-left { width: 200rpx; background: var(--brand-emergency); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 20rpx; }
.coupon-value { font-size: 44rpx; font-weight: bold; }
.coupon-condition { font-size: 22rpx; margin-top: 6rpx; opacity: 0.9; }
.coupon-right { flex: 1; padding: 24rpx; display: flex; flex-direction: column; justify-content: center; position: relative; }
.coupon-name { font-size: 30rpx; font-weight: bold; color: var(--text-primary); margin-bottom: 6rpx; }
.coupon-meta { font-size: 24rpx; color: var(--text-tertiary); }
.coupon-stock { font-size: 22rpx; color: var(--border-color); margin-top: 6rpx; }
.receive-btn { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); background: var(--brand-emergency); color: #fff; border: none; font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 30rpx; }
.empty { text-align: center; padding: 100rpx 0; color: var(--text-tertiary); font-size: 28rpx; }
.loading { text-align: center; padding: 100rpx 0; color: var(--text-tertiary); }
