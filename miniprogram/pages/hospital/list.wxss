/* 医院列表页 v2.0 — Warm Professionalism */

.page { min-height: 100vh; background: var(--bg-color); }

/* 状态栏 */
.status-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
}
.status-bar-left { display: flex; align-items: center; gap: 8rpx; }
.status-bar-icon { width: 24rpx; height: 24rpx; }
.status-bar-text { font-size: var(--font-size-sm); color: var(--text-secondary); }
.status-bar-right {
  display: flex; align-items: center; gap: 8rpx;
  padding: 6rpx 14rpx; border-radius: var(--radius-full);
  font-size: var(--font-size-xs); font-weight: 500;
}
.status-bar--ok { background: var(--color-success-light); color: var(--color-success); }
.status-bar--limited { background: var(--color-warning-light); color: var(--color-warning); }
.status-dot { width: 10rpx; height: 10rpx; border-radius: var(--radius-full); background: currentColor; }

/* 急诊横滑区域 */
.er-section { padding: 24rpx 32rpx 16rpx; }
.er-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.er-header-left { display: flex; align-items: center; gap: 10rpx; }
.er-header-icon { width: 28rpx; height: 28rpx; }
.er-header-title { font-size: var(--font-size-md); font-weight: 600; color: var(--text-primary); }
.er-header-count { font-size: var(--font-size-xs); color: var(--text-inverse); background: var(--brand-emergency); padding: 6rpx 14rpx; border-radius: var(--radius-full); font-weight: 600; }

.er-scroll { white-space: nowrap; }
.er-card {
  display: inline-flex; flex-direction: column; align-items: center;
  width: 180rpx; padding: 20rpx 16rpx;
  background: var(--bg-card); border: 1rpx solid var(--border-color);
  border-radius: var(--radius-2xl); margin-right: 16rpx;
  vertical-align: top;
}
.er-card-icon-wrap {
  width: 48rpx; height: 48rpx;
  background: var(--color-danger-light); border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx; position: relative;
}
.er-card-icon { width: 28rpx; height: 28rpx; }
.er-card-badge {
  position: absolute; top: -6rpx; right: -8rpx;
  background: var(--brand-emergency); color: var(--text-inverse);
  font-size: 16rpx; padding: 2rpx 8rpx; border-radius: var(--radius-full); font-weight: 700;
}
.er-card-name { display: block; font-size: var(--font-size-sm); font-weight: 600; color: var(--text-primary); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; margin-bottom: 4rpx; }
.er-card-distance { display: block; font-size: var(--font-size-xs); color: var(--text-tertiary); text-align: center; }

/* 快速操作 */
.quick-actions { display: flex; gap: 16rpx; padding: 8rpx 32rpx 20rpx; }
.quick-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 22rpx; border-radius: var(--radius-xl);
  font-size: var(--font-size-base); font-weight: 500; border: none;
}
.quick-btn::after { border: none; }
.quick-btn-icon { width: 24rpx; height: 24rpx; }
.quick-btn--primary { background: var(--brand-primary); color: var(--text-inverse); }
.quick-btn--primary .quick-btn-icon { filter: brightness(0) invert(1); }
.quick-btn--secondary { background: var(--bg-card); color: var(--text-primary); border: 1rpx solid var(--border-color); }

/* 医院主列表 */
.list-section { padding: 0 32rpx 120rpx; }
.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.list-title { font-size: var(--font-size-md); font-weight: 600; color: var(--text-primary); }
.list-sort { font-size: var(--font-size-sm); color: var(--text-tertiary); }

.hospital-card {
  background: var(--bg-card); border-radius: var(--radius-2xl);
  padding: 24rpx; margin-bottom: 16rpx;
  border: 1rpx solid var(--border-color);
  border-left: 4rpx solid var(--brand-primary);
}
.hospital-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.hospital-card-main { flex: 1; }
.hospital-card-name { display: block; font-size: var(--font-size-md); font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; }
.hospital-card-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }
.hospital-tag { padding: 4rpx 12rpx; border-radius: var(--radius-full); font-size: 18rpx; font-weight: 600; }
.hospital-tag--24h { background: var(--color-success-light); color: var(--color-success); }
.hospital-tag--er { background: var(--color-danger-light); color: var(--brand-emergency); }

.hospital-card-distance {
  background: var(--brand-primary-light); padding: 8rpx 16rpx;
  border-radius: var(--radius-lg); font-size: var(--font-size-sm);
  color: var(--brand-primary); font-weight: 500; flex-shrink: 0; margin-left: 16rpx;
}

.hospital-card-info { margin-bottom: 16rpx; }
.hospital-card-row { display: flex; align-items: flex-start; gap: 10rpx; margin-bottom: 10rpx; }
.hospital-card-row:last-child { margin-bottom: 0; }
.hospital-card-row-icon { width: 20rpx; height: 20rpx; flex-shrink: 0; margin-top: 4rpx; }
.hospital-card-row text { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: 1.5; }

.hospital-card-footer {
  display: flex; gap: 12rpx;
  border-top: 1rpx solid var(--border-light); padding-top: 16rpx;
}
.hospital-card-action {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 6rpx;
  padding: 14rpx; border-radius: var(--radius-lg);
  font-size: var(--font-size-sm); font-weight: 500;
}
.hospital-card-action-icon { width: 22rpx; height: 22rpx; }
.hospital-card-action--call { background: var(--color-success-light); color: var(--color-success); }
.hospital-card-action--nav { background: var(--brand-primary-light); color: var(--brand-primary); }
.hospital-card-action--detail { background: var(--color-info-light); color: var(--color-info); }

.load-more {
  text-align: center; padding: 24rpx;
  font-size: var(--font-size-sm); color: var(--brand-primary); font-weight: 500;
  background: var(--bg-card); border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-color);
}

/* 地图 FAB */
.map-fab {
  position: fixed; bottom: 100rpx; right: 32rpx;
  width: 96rpx; height: 96rpx;
  background: var(--brand-secondary); border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-md);
}
.map-fab-icon { width: 36rpx; height: 36rpx; filter: brightness(0) invert(1); }
