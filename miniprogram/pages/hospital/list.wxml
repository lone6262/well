<!--宠物医院列表页面 - 全新设计-->
<view class="hospital-page">

  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <view class="location-info">
      <text class="location-icon">📍</text>
      <text class="location-text">{{locationText}}</text>
    </view>
    <view class="api-status {{apiAvailable ? 'status-ok' : 'status-limited'}}">
      <text class="status-dot"></text>
      <text class="status-text">{{apiAvailable ? '实时数据' : '推荐数据'}}</text>
    </view>
  </view>

  <!-- 紧急医院快捷入口 -->
  <view class="emergency-section" wx:if="{{emergencyHospitals.length > 0}}">
    <view class="emergency-header">
      <text class="emergency-title">🚨 24小时急诊</text>
      <text class="emergency-count">{{emergencyHospitals.length}}家</text>
    </view>
    <scroll-view class="emergency-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="emergency-card"
            wx:for="{{emergencyHospitals}}"
            wx:key="hospitalId"
            bindtap="quickNavigate"
            data-hospital="{{item}}">
        <view class="emergency-marker">
          <text class="marker-icon">🏥</text>
          <text class="marker-badge">24H</text>
        </view>
        <text class="emergency-name">{{item.name}}</text>
        <text class="emergency-distance">{{item.distanceDisplay}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 快速操作区 -->
  <view class="quick-actions">
    <button class="action-btn primary-btn" bindtap="navigateToNearest">
      <text class="btn-icon">🧭</text>
      <text class="btn-text">最近医院</text>
    </button>
    <button class="action-btn secondary-btn" bindtap="showMapMode">
      <text class="btn-icon">🗺️</text>
      <text class="btn-text">地图模式</text>
    </button>
  </view>

  <!-- 医院主列表 -->
  <view class="hospital-list">
    <!-- 列表头部 -->
    <view class="list-header">
      <text class="list-title">附近医院</text>
      <view class="list-sort">
        <text class="sort-text">按距离排序</text>
        <text class="sort-icon">↓</text>
      </view>
    </view>

    <!-- 医院卡片 -->
    <view class="hospital-cards">
      <view class="hospital-card"
            wx:for="{{displayHospitals}}"
            wx:key="hospitalId"
            bindtap="viewHospital"
            data-id="{{item.hospitalId}}">

        <!-- 卡片头部 -->
        <view class="card-header">
          <view class="hospital-main-info">
            <text class="hospital-name">{{item.name}}</text>
            <view class="hospital-tags">
              <text class="tag tag-24h" wx:if="{{item.is24h}}">24H</text>
              <text class="tag tag-emergency" wx:if="{{item.hasEmergency}}">急诊</text>
              <text class="tag tag-rating">⭐ {{item.rating}}</text>
            </view>
          </view>
          <view class="distance-tag">
            <text class="distance-text">{{item.distanceDisplay}}</text>
          </view>
        </view>

        <!-- 卡片内容 -->
        <view class="card-content">
          <view class="info-row">
            <text class="info-icon">📍</text>
            <text class="info-text">{{item.address}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">📞</text>
            <text class="info-text">{{item.phone}}</text>
          </view>
        </view>

        <!-- 卡片底部操作 -->
        <view class="card-footer">
          <button class="footer-btn call-btn"
                  catchtap="callHospital"
                  data-phone="{{item.phone}}">
            <text class="footer-icon">📞</text>
            <text>电话</text>
          </button>
          <button class="footer-btn navigate-btn"
                  catchtap="navigateToHospital"
                  data-hospital="{{item}}">
            <text class="footer-icon">🧭</text>
            <text>导航</text>
          </button>
          <button class="footer-btn detail-btn"
                  catchtap="showHospitalDetail"
                  data-hospital="{{item}}">
            <text class="footer-icon">📋</text>
            <text>详情</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-section" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载医院信息...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && displayHospitals.length === 0}}">
    <text class="empty-icon">🏥</text>
    <text class="empty-title">暂无医院信息</text>
    <text class="empty-desc">{{apiAvailable ? '附近没有找到宠物医院' : 'API配额受限，显示推荐医院'}}</text>
    <button class="retry-btn" bindtap="reloadHospitals">
      <text>🔄 重新加载</text>
    </button>
  </view>

  <!-- 底部地图按钮 -->
  <view class="map-fab" bindtap="showFullMap">
    <text class="fab-icon">🗺️</text>
  </view>

</view>