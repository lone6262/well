/* ===================================
   回访记录列表页 — 项目统一风格
   =================================== */

page {
  background: var(--bg-secondary);
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 顶部头部 ===== */
.page-header {
  background: var(--brand-primary);
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

.header-inner {
  padding: 0 24rpx 32rpx;
}

/* 导航栏 */
.nav-bar {
  padding-top: env(safe-area-inset-top);
}

.back-btn {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 12rpx 16rpx 4rpx;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.back-btn-active { opacity: 0.7; }

.back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-right: 8rpx;
}

.back-text { font-size: 28rpx; color: #fff; }

.header-content {
  padding-left: 8rpx;
}

.header-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 8rpx;
}

.header-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* ===== 状态筛选 ===== */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: transparent;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: rgba(255,255,255,0.9);
  box-shadow: 0 2rpx 8rpx rgba(102,126,234,0.08);
  transition: all 0.25s;
}

.filter-active {
  background: var(--brand-primary);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.35);
}

/* ===== 加载/空状态 ===== */
.state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  margin: 40rpx 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.06);
}

.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }

.empty-icon-img {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* ===== 卡片列表 ===== */
.list-area {
  padding: 0 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 3rpx 0 rgba(0,0,0,0.1), 0 1rpx 2rpx 0 rgba(0,0,0,0.06);
  transition: transform 0.15s;
}

.card-hover {
  transform: scale(0.98);
}

/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-pet {
  display: flex;
  align-items: center;
}

.card-pet-emoji { font-size: 36rpx; margin-right: 10rpx; }

.card-pet-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.card-pet-name { font-size: 32rpx; font-weight: bold; color: var(--text-primary); }

/* 状态徽章 */
.badge {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-pending {
  background: rgba(250,173,20,0.12);
  color: #d48806;
}

.badge-improved {
  background: rgba(82,196,26,0.12);
  color: #389e0d;
}

.badge-no_change {
  background: rgba(24,144,255,0.12);
  color: #096dd9;
}

.badge-worsened {
  background: rgba(245,34,45,0.12);
  color: #cf1322;
}

/* 症状区域 */
.card-symptoms {
  background: var(--bg-secondary);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}

.card-symptoms-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 就医标记 */
.card-vet { margin-bottom: 8rpx; }

.vet-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #389e0d;
  background: rgba(82,196,26,0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.vet-icon {
  width: 22rpx;
  height: 22rpx;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border-color);
}

.card-date { font-size: 22rpx; color: var(--text-tertiary); }

.card-action {
  display: flex;
  align-items: center;
  background: var(--brand-primary);
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
}

.action-label { font-size: 24rpx; color: #fff; font-weight: 600; }
.action-arrow { font-size: 26rpx; color: #fff; margin-left: 4rpx; }

.card-done {
  display: flex;
  align-items: center;
}

.done-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(82,196,26,0.12);
  color: #389e0d;
  font-size: 20rpx;
  font-weight: bold;
  margin-right: 6rpx;
}

.done-icon-svg {
  width: 22rpx;
  height: 22rpx;
}

.done-text { font-size: 24rpx; color: var(--color-success); }

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  gap: 12rpx;
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more-text { font-size: 24rpx; color: var(--text-tertiary); }

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  gap: 16rpx;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background: var(--border-color);
}

.no-more-text { font-size: 24rpx; color: var(--text-tertiary); flex-shrink: 0; }

/* 底部安全区 */
.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 20rpx);
}
