/* ===================================
   回访提交页面 — 项目统一风格
   配色：蓝紫渐变 #667eea → #764ba2
   背景：#f8f9ff → #f0f2f5
   =================================== */

page {
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2f5 100%);
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 顶部渐变头部 ===== */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

.header-inner {
  padding: 0 24rpx 32rpx;
}

.nav-bar {
  padding-top: env(safe-area-inset-top);
}

.back-btn {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 12rpx 16rpx 4rpx;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.back-btn-active { opacity: 0.7; }

.back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-right: 8rpx;
}

.back-text { font-size: 28rpx; color: #fff; }

.header-content { padding-left: 8rpx; }

.header-icon { font-size: 44rpx; display: block; margin-bottom: 8rpx; }

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* ===== 提交成功 ===== */
.success-section { padding: 40rpx 24rpx; }

.success-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.success-emoji { font-size: 96rpx; display: block; margin-bottom: 24rpx; }

.success-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

/* ===== 通用按钮 ===== */
.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  color: #fff !important;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(102,126,234,0.3);
}

.btn-primary::after { border: none; }

.btn-disabled {
  background: #d9d9d9 !important;
  box-shadow: none;
}

/* ===== 表单区域 ===== */
.form-area { padding: 20rpx 24rpx 0; }

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 3rpx 0 rgba(0,0,0,0.1), 0 1rpx 2rpx 0 rgba(0,0,0,0.06);
}

.card-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-label-icon { font-size: 32rpx; margin-right: 10rpx; }

.card-label-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.required {
  color: #ff4d4f;
  font-size: 28rpx;
  margin-left: 4rpx;
}

/* 症状标签 */
.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: rgba(102,126,234,0.08);
  color: #667eea;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
}

.symptom-fallback {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 状态选择 */
.status-options {
  display: flex;
  gap: 16rpx;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 22rpx;
  border-radius: 20rpx;
  border: 3rpx solid #f0f0f0;
  position: relative;
  transition: all 0.2s;
}

.status-selected {
  border-width: 3rpx;
  box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.12);
}

.status-emoji { font-size: 52rpx; margin-bottom: 10rpx; }

.status-label { font-size: 26rpx; color: #666; font-weight: 500; }

.status-check {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* 就医开关 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-info { display: flex; align-items: center; }

.switch-icon { font-size: 36rpx; margin-right: 14rpx; }

.switch-text { display: flex; flex-direction: column; }

.switch-label { font-size: 30rpx; color: #333; font-weight: 500; }

.switch-hint { font-size: 22rpx; color: #bbb; margin-top: 4rpx; }

/* 补充说明 */
.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f8f9ff;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 提交按钮区域 */
.btn-area { padding: 12rpx 0 40rpx; }

/* 底部安全区 */
.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 20rpx);
}
