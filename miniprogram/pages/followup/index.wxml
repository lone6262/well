<view class="page-container">
  <!-- 顶部渐变头部 -->
  <view class="page-header">
    <view class="header-inner">
      <view class="nav-bar">
        <view class="back-btn" bindtap="goBack" hover-class="back-btn-active">
          <view class="back-arrow"></view>
          <text class="back-text">返回</text>
        </view>
      </view>
      <view class="header-content">
        <text class="header-icon">📋</text>
        <text class="header-title">回访记录</text>
        <text class="header-subtitle">跟踪宝贝的每一次康复进展</text>
      </view>
    </view>
  </view>

  <!-- 状态筛选 -->
  <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
    <view class="filter-item {{currentTab === item.key ? 'filter-active' : ''}}" wx:for="{{tabs}}" wx:key="key" bindtap="switchTab" data-key="{{item.key}}">
      {{item.text}}
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="state-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- 列表区域 -->
  <view class="list-area" wx:if="{{!loading}}">
    <!-- 空状态 -->
    <view class="empty-card" wx:if="{{empty}}">
      <text class="empty-emoji">📝</text>
      <text class="empty-title">暂无回访记录</text>
      <text class="empty-desc">完成症状自查后，系统会在24小时后提醒您进行回访</text>
    </view>

    <!-- 卡片列表 -->
    <view class="card" wx:for="{{list}}" wx:key="_id" bindtap="onItemClick" data-id="{{item._id}}" data-status="{{item.status}}" hover-class="card-hover">
      <!-- 卡片头部 -->
      <view class="card-top">
        <view class="card-pet">
          <text class="card-pet-emoji">{{item.status === 'pending' ? '🐱' : (item.status === 'improved' ? '😊' : (item.status === 'worsened' ? '😟' : '🐾'))}}</text>
          <text class="card-pet-name">{{item.pet_name}}</text>
        </view>
        <view class="badge badge-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 症状 -->
      <view class="card-symptoms" wx:if="{{item.symptom_list}}">
        <text class="card-symptoms-text">{{item.symptom_list}}</text>
      </view>

      <!-- 就医标记 -->
      <view class="card-vet" wx:if="{{item.visited_vet}}">
        <text class="vet-tag">🏥 已就医</text>
      </view>

      <!-- 卡片底部 -->
      <view class="card-footer">
        <text class="card-date">{{item.dateText}}</text>
        <view class="card-action" wx:if="{{item.status === 'pending'}}">
          <text class="action-label">去反馈</text>
          <text class="action-arrow">›</text>
        </view>
        <view class="card-done" wx:else>
          <text class="done-icon">✓</text>
          <text class="done-text">已完成</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner-sm"></view>
      <text class="load-more-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">没有更多了</text>
      <view class="no-more-line"></view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
