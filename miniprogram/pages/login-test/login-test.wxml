<!--登录闭环测试页面-->
<view class="container">
  <view class="header">
    <text class="title">🔐 登录功能闭环测试</text>
    <text class="subtitle">验证所有登录功能是否正常工作</text>
  </view>

  <!-- 登录状态卡片 -->
  <view class="status-card">
    <view class="status-title">登录状态</view>
    <view class="status-text {{loginStatus.indexOf('成功') > -1 ? 'success' : loginStatus.indexOf('失败') > -1 ? 'error' : 'waiting'}}">
      {{loginStatus}}
    </view>
  </view>

  <!-- 关键信息卡片 -->
  <view class="info-cards">
    <view class="info-card">
      <view class="info-title">👤 用户信息</view>
      <view class="info-row">
        <text class="info-label">昵称:</text>
        <text class="info-value">{{userInfo ? userInfo.nickName : '未获取'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">状态:</text>
        <text class="info-value">{{isGuest ? '游客模式' : '已授权'}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-title">🔑 技术信息</view>
      <view class="info-row">
        <text class="info-label">OpenID:</text>
        <text class="info-value tiny">{{openid ? openid.substring(0, 20) + '...' : '未获取'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">Token:</text>
        <text class="info-value tiny">{{token ? token.substring(0, 20) + '...' : '未获取'}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-title">☁️ 云开发状态</view>
      <view class="info-row">
        <text class="info-label">状态:</text>
        <text class="info-value">{{cloudStatus}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">数据库用户:</text>
        <text class="info-value">{{databaseUserCount > 0 ? '有' + databaseUserCount + '个用户' : '检查中...'}}</text>
      </view>
    </view>
  </view>

  <!-- 测试按钮 -->
  <view class="test-buttons">
    <button class="test-btn primary" bindtap="testFullLoginFlow">🧪 完整登录流程测试</button>
    <button class="test-btn" bindtap="testUserAuthorization">👤 测试按需授权</button>
    <button class="test-btn secondary" bindtap="viewFullLoginInfo">📋 查看完整登录信息</button>
    <button class="test-btn secondary" bindtap="recheck">🔄 重新检查</button>
  </view>

  <!-- 测试结果 -->
  <view class="results-section" wx:if="{{testResults.length > 0}}">
    <view class="results-title">测试结果详情</view>
    <view class="result-list">
      <view class="result-item {{item.status === '成功' ? 'success' : item.status === '失败' ? 'error' : 'waiting'}}"
            wx:for="{{testResults}}"
            wx:key="time">
        <view class="result-header">
          <text class="result-name">{{item.name}}</text>
          <text class="result-status">{{item.status}}</text>
        </view>
        <view class="result-message">{{item.message}}</view>
        <view class="result-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="guide-section">
    <view class="guide-title">📖 登录闭环验证指南</view>
    <view class="guide-text">
      <text class="guide-step">1. 查看"登录状态"是否显示成功</text>
      <text class="guide-step">2. 检查"用户信息"是否显示你的昵称</text>
      <text class="guide-step">3. 点击"完整登录流程测试"验证所有环节</text>
      <text class="guide-step">4. 如果是游客模式，可以测试"按需授权"</text>
      <text class="guide-step">5. 所有测试通过说明登录闭环成功！</text>
    </view>
  </view>
</view>