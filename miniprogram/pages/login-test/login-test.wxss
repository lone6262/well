/* 登录闭环测试页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
}

/* 状态卡片 */
.status-card {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.status-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  padding: 16rpx;
  border-radius: 8rpx;
}

.status-text.success {
  background-color: #52c41a;
  color: white;
}

.status-text.error {
  background-color: #f5222d;
  color: white;
}

.status-text.waiting {
  background-color: #faad14;
  color: white;
}

/* 信息卡片 */
.info-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.info-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.info-label {
  color: #666;
  font-weight: bold;
}

.info-value {
  color: #333;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.info-value.tiny {
  font-size: 22rpx;
  font-family: monospace;
}

/* 测试按钮 */
.test-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.test-btn {
  background-color: #4A90E2;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
}

.test-btn.primary {
  background-color: #52c41a;
}

.test-btn.secondary {
  background-color: #f0f0f0;
  color: #333;
}

.test-btn:active {
  opacity: 0.8;
}

/* 测试结果 */
.results-section {
  margin-bottom: 20rpx;
}

.results-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-item {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #e0e0e0;
}

.result-item.success {
  border-left-color: #52c41a;
}

.result-item.error {
  border-left-color: #f5222d;
}

.result-item.waiting {
  border-left-color: #faad14;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.result-status {
  font-size: 24rpx;
  color: #666;
}

.result-message {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.result-time {
  font-size: 22rpx;
  color: #999;
}

/* 使用说明 */
.guide-section {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.guide-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.guide-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guide-step {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}