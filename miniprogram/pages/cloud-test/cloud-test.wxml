<!--云开发启动验证页面-->
<view class="container">
  <view class="header">
    <text class="title">☁️ 云开发启动验证</text>
    <text class="subtitle">环境ID: {{envId}}</text>
  </view>

  <!-- 状态卡片 -->
  <view class="status-card">
    <view class="status-title">云开发状态</view>
    <view class="status-text {{cloudStatus.indexOf('成功') > -1 ? 'success' : cloudStatus.indexOf('失败') > -1 || cloudStatus.indexOf('不可用') > -1 ? 'error' : 'waiting'}}">
      {{cloudStatus}}
    </view>
  </view>

  <!-- 测试按钮 -->
  <view class="test-buttons">
    <button class="test-btn primary" bindtap="testCloudInit" disabled="{{isTesting}}">
      {{isTesting ? '测试中...' : '🚀 测试云开发启动'}}
    </button>
    <button class="test-btn" bindtap="testDatabase">🗄️ 测试数据库连接</button>
    <button class="test-btn" bindtap="testCloudFunction">⚡ 测试云函数调用</button>
    <button class="test-btn secondary" bindtap="recheck">🔄 重新检查</button>
  </view>

  <!-- 测试结果 -->
  <view class="results-section" wx:if="{{testResults.length > 0}}">
    <view class="results-title">测试结果</view>
    <view class="result-list">
      <view class="result-item {{item.status === '成功' ? 'success' : item.status === '失败' || item.status === '异常' ? 'error' : 'waiting'}}"
            wx:for="{{testResults}}"
            wx:key="time">
        <view class="result-header">
          <text class="result-name">{{item.name}}</text>
          <text class="result-status">{{item.status}}</text>
        </view>
        <view class="result-message">{{item.message}}</view>
        <view class="result-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="info-section">
    <view class="info-title">📖 验证说明</view>
    <view class="info-text">
      1. 确认环境ID是否正确：cloud1-d8gdi44zqfec250b5
      2. 点击"测试云开发启动"按钮验证初始化
      3. 查看测试结果了解各个功能状态
      4. 如果启动失败，检查网络连接和环境配置
    </view>
  </view>
</view>
