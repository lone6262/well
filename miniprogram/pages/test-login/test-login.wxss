/* 测试登录页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  background-color: #4A90E2;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn.primary {
  background-color: #52c41a;
}

.action-btn.secondary {
  background-color: #f0f0f0;
  color: #333;
}

.action-btn:active {
  opacity: 0.8;
}

/* 结果卡片 */
.result-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

/* 用户卡片 */
.user-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.user-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-label {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.user-value {
  font-size: 24rpx;
  color: #333;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

/* 信息卡片 */
.info-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}
