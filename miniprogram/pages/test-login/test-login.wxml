<!--测试登录页面-->
<view class="container">
  <view class="header">
    <text class="title">🔐 用户登录测试</text>
  </view>

  <!-- 登录按钮 -->
  <view class="action-buttons">
    <button class="action-btn primary" bindtap="quickLogin" disabled="{{loading}}">
      {{loading ? '登录中...' : '🚀 快速登录测试'}}
    </button>
    <button class="action-btn" bindtap="checkUsers">🗄️ 检查数据库</button>
    <button class="action-btn secondary" bindtap="clearLocal">🗑️ 清除本地数据</button>
  </view>

  <!-- 登录结果 -->
  <view class="result-card" wx:if="{{loginResult}}">
    <view class="result-title">操作结果</view>
    <view class="result-text">{{loginResult}}</view>
  </view>

  <!-- 用户信息 -->
  <view class="user-card" wx:if="{{userInfo}}">
    <view class="user-title">用户信息</view>
    <view class="user-info">
      <view class="user-row">
        <text class="user-label">昵称:</text>
        <text class="user-value">{{userInfo.nickName}}</text>
      </view>
      <view class="user-row">
        <text class="user-label">用户ID:</text>
        <text class="user-value">{{userInfo._openid}}</text>
      </view>
      <view class="user-row">
        <text class="user-label">创建时间:</text>
        <text class="user-value">{{userInfo.createTime}}</text>
      </view>
    </view>
  </view>

  <!-- 说明信息 -->
  <view class="info-card">
    <view class="info-title">📖 功能说明</view>
    <view class="info-text">
      1. 点击"快速登录测试"按钮自动创建用户
      2. 云函数会自动获取openid并创建用户记录
      3. 登录成功后可以查看用户信息
      4. 然后去云开发控制台查看users集合
    </view>
  </view>
</view>
