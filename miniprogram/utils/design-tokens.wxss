/* 背景色 Background Colors */
.bg-primary { background-color: #ffffff; }
.bg-secondary { background-color: #f8f9fa; }
.bg-tertiary { background-color: #f5f5f5; }
.bg-overlay { background-color: rgba(0, 0, 0, 0.5); }

/* 文本色 Text Colors */
.text-primary { color: #212121; }
.text-secondary { color: #757575; }
.text-tertiary { color: #9e9e9e; }
.text-disabled { color: #bdbdbd; }
.text-inverse { color: #ffffff; }

/* 边框色 Border Colors */
.border-light { border-color: #e0e0e0; }
.border-medium { border-color: #bdbdbd; }
.border-dark { border-color: #757575; }

/* 品牌色 Brand Colors */
