.color-primary-100 { color: #bbdefb; }
.color-primary-200 { color: #90caf9; }
.color-primary-300 { color: #64b5f6; }
.color-primary-400 { color: #42a5f5; }
.color-primary-500 { color: #2196f3; } /* 主色 */
.color-primary-600 { color: #1e88e5; }
.color-primary-700 { color: #1976d2; }
.color-primary-800 { color: #1565c0; }
.color-primary-900 { color: #0d47a1; }

/* 主色调 - 背景颜色 */
.bg-primary-50 { background-color: #e3f2fd; }
