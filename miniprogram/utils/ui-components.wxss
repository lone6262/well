/* ===================================
   宠脉AI - UI 组件库 v2.0
   Component Library — "Warm Professionalism"
   =================================== */

@import "design-tokens.wxss";

/* === 卡片 Cards === */

/* 内容卡片 — 医院、文章、记录 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 28rpx;
  border: 1rpx solid var(--border-color);
  margin-bottom: 24rpx;
  transition: transform var(--duration-base) var(--ease-standard),
              border-color var(--duration-base) var(--ease-standard);
}

.card:active {
  transform: scale(0.97);
  border-color: var(--brand-primary);
}

.card-accent {
  border-left: 4rpx solid var(--brand-primary);
}

.card-accent-success {
  border-left-color: var(--color-success);
}

.card-accent-warning {
  border-left-color: var(--color-warning);
}

.card-accent-danger {
  border-left-color: var(--color-danger);
}

/* 功能磁贴 — 首页 6 宫格 */
.tile {
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
  transition: transform var(--duration-base) var(--ease-standard);
}

.tile::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.tile-accent-primary::before { background: var(--brand-primary); }
.tile-accent-success::before { background: var(--color-success); }
.tile-accent-warning::before { background: var(--color-warning); }
.tile-accent-info::before { background: var(--color-info); }
.tile-accent-emergency::before { background: var(--brand-emergency); }
.tile-accent-secondary::before { background: var(--brand-secondary); }

.tile:active {
  transform: scale(0.97);
}

/* 状态卡片 — 风险结果、健康状态 */
.card-status {
  border-radius: var(--radius-3xl);
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.card-status-success {
  background: var(--color-success-light);
  color: var(--text-primary);
}

.card-status-warning {
  background: var(--color-warning-light);
  color: var(--text-primary);
}

.card-status-danger {
  background: var(--color-danger-light);
  color: var(--text-primary);
}

.card-status-info {
  background: var(--color-info-light);
  color: var(--text-primary);
}

/* === 按钮 Buttons === */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-xl);
  font-size: var(--font-size-base);
  font-weight: 500;
  text-align: center;
  border: none;
  transition: transform var(--duration-fast) var(--ease-standard),
              background-color var(--duration-fast) var(--ease-standard),
              opacity var(--duration-fast) var(--ease-standard);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  height: 88rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.btn-primary:active {
  background: var(--brand-primary-dark);
  transform: scale(0.97);
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.btn-secondary:active {
  background: var(--brand-primary-light);
  transform: scale(0.97);
}

.btn-danger {
  background: var(--brand-emergency);
  color: var(--text-inverse);
}

.btn-danger:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-success {
  background: var(--color-success);
  color: var(--text-inverse);
}

.btn-success:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-ghost {
  background: transparent;
  color: var(--brand-primary);
}

.btn-ghost:active {
  opacity: 0.7;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: var(--font-size-sm);
  height: 64rpx;
}

.btn-lg {
  padding: 24rpx 48rpx;
  font-size: var(--font-size-md);
}

.btn-block {
  width: 100%;
  display: flex;
}

/* 胶囊按钮 */
.btn-pill {
  border-radius: var(--radius-full);
  padding: 8rpx 24rpx;
  height: auto;
  font-size: var(--font-size-sm);
}

/* === 输入框 Inputs === */

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.input-modern {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  font-size: var(--font-size-base);
  color: var(--text-primary);
  transition: border-color var(--duration-base) var(--ease-standard);
  box-sizing: border-box;
}

.input-modern:focus {
  border-color: var(--brand-primary);
}

.textarea-modern {
  min-height: 160rpx;
  padding: 16rpx 24rpx;
  resize: vertical;
}

/* === 标签 Tags === */

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  font-weight: 500;
  white-space: nowrap;
}

.tag-brand {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.tag-success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.tag-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.tag-info {
  background: var(--color-info-light);
  color: var(--color-info);
}

.tag-outline {
  background: transparent;
  border: 1rpx solid var(--border-color);
  color: var(--text-secondary);
}

/* === 徽章 Badges === */

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--text-inverse);
}

.badge-brand {
  background: var(--brand-primary);
}

.badge-danger {
  background: var(--brand-emergency);
}

.badge-success {
  background: var(--color-success);
}

/* VIP 徽章 */
.badge-vip {
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-size-xs);
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

/* === 头像 Avatars === */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  background: var(--border-light);
  flex-shrink: 0;
}

.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-md { width: 80rpx; height: 80rpx; }
.avatar-lg { width: 120rpx; height: 120rpx; }
.avatar-xl { width: 160rpx; height: 160rpx; }

/* === 分隔线 Dividers === */

.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.divider-text {
  display: flex;
  align-items: center;
  text-align: center;
  margin: 24rpx 0;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--border-color);
}

.divider-text text {
  padding: 0 24rpx;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* === 加载 Loading === */

.loading-spinner {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: var(--radius-full);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* === 空状态 Empty State === */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  color: var(--text-tertiary);
}

.empty-title {
  font-size: var(--font-size-lg);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-description {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  margin-bottom: 32rpx;
  line-height: var(--line-height-relaxed);
}

/* === 网格 Grid === */

.grid {
  display: grid;
  gap: var(--spacing-md);
}

.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

/* === 通知 Alerts === */

.alert {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.alert-success {
  background: var(--color-success-light);
  color: var(--color-success);
  border-left: 4rpx solid var(--color-success);
}

.alert-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
  border-left: 4rpx solid var(--color-warning);
}

.alert-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
  border-left: 4rpx solid var(--color-danger);
}

.alert-info {
  background: var(--color-info-light);
  color: var(--color-info);
  border-left: 4rpx solid var(--color-info);
}

/* === 进度条 Progress Bar === */

.progress {
  width: 100%;
  height: 8rpx;
  background: var(--border-light);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  transition: width 500ms var(--ease-standard);
}

.progress-bar-success { background: var(--color-success); }
.progress-bar-warning { background: var(--color-warning); }
.progress-bar-danger { background: var(--color-danger); }

/* === 图标容器 Icon Container === */

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.icon-circle-brand {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.icon-circle-success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.icon-circle-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.icon-circle-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.icon-circle-info {
  background: var(--color-info-light);
  color: var(--color-info);
}

.icon-circle-secondary {
  background: var(--brand-secondary-light);
  color: var(--brand-secondary);
}

/* === 动画 Animations === */

.pulse-subtle {
  animation: pulseSubtle 3s var(--ease-standard) infinite;
}

@keyframes pulseSubtle {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.06); }
}

.fade-in {
  animation: fadeIn var(--duration-base) var(--ease-standard);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.slide-up {
  animation: slideUp var(--duration-slow) var(--ease-standard);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.scale-in {
  animation: scaleIn var(--duration-base) var(--ease-standard);
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 交错入场动画（仅核心列表） */
.stagger-item {
  opacity: 0;
  transform: translateY(16rpx);
  animation: staggerIn var(--duration-slow) var(--ease-standard) forwards;
}

@keyframes staggerIn {
  to { opacity: 1; transform: translateY(0); }
}

/* === 骨架屏 Skeleton === */

.skeleton {
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}

.skeleton::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  animation: skeletonShimmer 1.5s infinite;
}

@keyframes skeletonShimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

/* === 按钮组 Button Group === */

.btn-group {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.btn-group .btn {
  flex: 1;
}

/* === 悬停效果 Hover Effects === */

.hover-lift:active {
  transform: translateY(-2rpx);
}

.hover-scale:active {
  transform: scale(0.97);
}
