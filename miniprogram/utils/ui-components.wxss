/* ===================================
   现代化UI组件库 (微信小程序兼容版本)
   Modern UI Component Library
   =================================== */

@import "design-tokens.wxss";

/* === 通用组件基础样式 === */

/* 容器 Container */
.container-modern {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* === 现代化卡片组件 Modern Cards === */

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06);
}

.card-elevated {
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

.card-interactive {
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.card-interactive::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  opacity: 0;
  transition: opacity 200ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
}

.card-interactive:active::before {
  opacity: 0.1;
}

/* === 现代化按钮组件 Modern Buttons === */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #4A90E2;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(33, 150, 243, 0.2);
}

.btn-primary:active {
  background: #1976d2;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: #f5f5f5;
  color: #212121;
}

.btn-secondary:active {
  background: #eeeeee;
}

.btn-danger {
  background: #F5222D;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(244, 67, 54, 0.2);
}

.btn-success {
  background: #4caf50;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.btn-ghost {
  background: transparent;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.btn-lg {
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

.btn-block {
  width: 100%;
  display: flex;
}

/* === 按钮组 Button Group === */

.btn-group {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.btn-group .btn {
  flex: 1;
}

/* === 现代化输入框组件 Modern Inputs === */

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #757575;
  margin-bottom: 12rpx;
}

.input-modern {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  font-size: 28rpx;
  color: #212121;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.input-modern:focus {
  border-color: #4A90E2;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.1);
}

.textarea-modern {
  min-height: 160rpx;
  padding: 16rpx 24rpx;
  resize: vertical;
}

/* === 现代化标签组件 Modern Tags === */

.tag {
  display: inline-block;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.tag-primary {
  background: #e3f2fd;
  color: #1e88e5;
}

.tag-success {
  background: #e8f5e9;
  color: #43a047;
}

.tag-warning {
  background: #fff8e1;
  color: #ffb300;
}

.tag-danger {
  background: #ffebee;
  color: #e53935;
}

.tag-outline {
  background: transparent;
  border: 2rpx solid #e0e0e0;
  color: #757575;
}

/* === 现代化徽章组件 Modern Badges === */

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.badge-primary {
  background: #4A90E2;
}

.badge-danger {
  background: #F5222D;
}

.badge-success {
  background: #4caf50;
}

/* === 现代化头像组件 Modern Avatars === */

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  background: #eeeeee;
  flex-shrink: 0;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
}

.avatar-md {
  width: 80rpx;
  height: 80rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar-xl {
  width: 160rpx;
  height: 160rpx;
}

/* === 现代化分隔线 Modern Dividers === */

.divider {
  height: 1rpx;
  background: #e0e0e0;
  margin: 24rpx 0;
}

.divider-text {
  display: flex;
  align-items: center;
  text-align: center;
  margin: 24rpx 0;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #9e9e9e;
}

/* === 现代化加载状态 Modern Loading === */

.loading {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4A90E2;
  border-radius: 9999rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* === 现代化空状态 Modern Empty States === */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #212121;
  margin-bottom: 12rpx;
}

.empty-description {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 32rpx;
}

/* === 现代化网格系统 Modern Grid System === */

.grid {
  display: grid;
  gap: 16rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* === 现代化Flexbox工具类 Modern Flex Utilities === */

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }

.items-start { align-items: flex-start; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }

.justify-start { justify-content: flex-start; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }

.flex-1 { flex: 1; }
.flex-auto { flex: auto; }
.flex-none { flex: none; }

/* === 现代化文本工具类 Modern Text Utilities === */

.text-primary { color: #212121; }
.text-secondary { color: #757575; }
.text-tertiary { color: #9e9e9e; }
.text-inverse { color: #ffffff; }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

/* === 现代化背景工具类 Modern Background Utilities === */

.bg-primary { background-color: #ffffff; }
.bg-secondary { background-color: #f8f9fa; }
.bg-tertiary { background-color: #f5f5f5; }

/* === 现代化圆角工具类 Modern Radius Utilities === */

.rounded-none { border-radius: 0; }
.rounded-sm { border-radius: 4rpx; }
.rounded-md { border-radius: 8rpx; }
.rounded-lg { border-radius: 12rpx; }
.rounded-xl { border-radius: 16rpx; }
.rounded-2xl { border-radius: 24rpx; }
.rounded-3xl { border-radius: 32rpx; }
.rounded-full { border-radius: 9999rpx; }

/* === 现代化阴影工具类 Modern Shadow Utilities === */

.shadow-sm { box-shadow: 0 1rpx 3rpx 0 rgba(0, 0, 0, 0.1), 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.06); }
.shadow-md { box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.06); }
.shadow-lg { box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05); }
.shadow-xl { box-shadow: 0 20rpx 25rpx -5rpx rgba(0, 0, 0, 0.1), 0 10rpx 10rpx -5rpx rgba(0, 0, 0, 0.04); }
.shadow-none { box-shadow: none; }

/* === 现代化动画工具类 Modern Animation Utilities === */

.transition { transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1); }
.transition-fast { transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1); }
.transition-slow { transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1); }

.hover-lift:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

.hover-scale:active {
  transform: scale(1.05);
}

/* === 现代化位置工具类 Modern Position Utilities === */

.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.sticky { position: sticky; }

/* === 现代化显示工具类 Modern Display Utilities === */

.block { display: block; }
.inline-block { display: inline-block; }
.inline { display: inline; }
.hidden { display: none; }

/* === 现代化溢出工具类 Modern Overflow Utilities === */

.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.overflow-scroll { overflow: scroll; }

/* === 现代化透明度工具类 Modern Opacity Utilities === */

.opacity-0 { opacity: 0; }
.opacity-50 { opacity: 0.5; }
.opacity-100 { opacity: 1; }

/* === 现代化渐变背景 Modern Gradient Backgrounds === */

.gradient-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.gradient-ocean {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.gradient-sunset {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.gradient-forest {
  background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
}

.gradient-danger {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

/* === 现代化玻璃态效果 Modern Glassmorphism === */

.glass {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

/* === 现代化卡片悬停效果 Modern Card Hover Effects === */

.card-hover {
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.card-hover:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

/* === 现代化脉冲动画 Modern Pulse Animation === */

.pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* === 现代化闪烁动画 Modern Bounce Animation === */

.bounce {
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(-5%);
    animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
  }
  50% {
    transform: translateY(0);
    animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
  }
}

/* === 现代化旋转动画 Modern Spin Animation === */

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* === 现代化通知组件 Modern Alert Components === */

.alert {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.alert-success {
  background: #e8f5e9;
  color: #43a047;
  border-left: 4rpx solid #4caf50;
}

.alert-warning {
  background: #fff8e1;
  color: #ffb300;
  border-left: 4rpx solid #ffc107;
}

.alert-danger {
  background: #ffebee;
  color: #e53935;
  border-left: 4rpx solid #f44336;
}

.alert-info {
  background: #e3f2fd;
  color: #1e88e5;
  border-left: 4rpx solid #2196f3;
}

/* === 现代化进度条 Modern Progress Bar === */

.progress {
  width: 100%;
  height: 8rpx;
  background: #eeeeee;
  border-radius: 9999rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #4A90E2;
  border-radius: 9999rpx;
  transition: width 500ms cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-bar-success {
  background: #4caf50;
}

.progress-bar-warning {
  background: #ffc107;
}

.progress-bar-danger {
  background: #f44336;
}

/* === 响应式工具类 Responsive Utilities === */

/* 小程序使用rpx自动适配，不需要媒体查询 */