.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-3xl, 64rpx) var(--spacing-lg, 32rpx);
  text-align: center;
  color: var(--text-secondary, #6b7280);
}

.state-view--card {
  margin: var(--spacing-sm, 16rpx) 0;
  border-radius: var(--radius-xl, 24rpx);
  background: #fff;
}

.state-view__spinner {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: var(--spacing-md, 24rpx);
  border: 6rpx solid var(--border-light, #e5e7eb);
  border-top-color: var(--primary-500, #2563eb);
  border-radius: 50%;
  animation: state-view-spin 0.9s linear infinite;
}

.state-view__icon {
  margin-bottom: var(--spacing-md, 24rpx);
  font-size: 64rpx;
  line-height: 1;
}

.state-view__title {
  color: var(--text-primary, #111827);
  font-size: var(--font-size-lg, 32rpx);
  font-weight: 600;
  line-height: 1.4;
}

.state-view__description {
  max-width: 520rpx;
  margin-top: var(--spacing-xs, 8rpx);
  color: var(--text-secondary, #6b7280);
  font-size: var(--font-size-sm, 26rpx);
  line-height: 1.5;
}

.state-view__action {
  min-width: 176rpx;
  min-height: 88rpx;
  margin-top: var(--spacing-lg, 32rpx);
  padding: 0 var(--spacing-xl, 40rpx);
  border: none;
  border-radius: var(--radius-full, 999rpx);
  background: var(--primary-500, #2563eb);
  color: #fff;
  font-size: var(--font-size-base, 28rpx);
  line-height: 88rpx;
}

.state-view--dark .state-view__title,
.state-view--dark .state-view__description,
.state-view--dark .state-view__icon {
  color: #fff;
}

.state-view--dark .state-view__spinner {
  border-color: rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
}

.state-view--error .state-view__action {
  background: var(--danger-500, #ef4444);
}

@keyframes state-view-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
