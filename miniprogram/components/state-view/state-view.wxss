.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 24rpx;
  text-align: center;
  color: var(--text-secondary);
}

.state-view--card {
  margin: 16rpx 0;
  border-radius: var(--radius-2xl);
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
}

/* Spinner — 品牌色 */
.state-view__spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: state-view-spin 1s linear infinite;
}

/* 图标区域 */
.state-view__icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.state-view__title {
  color: var(--text-primary);
  font-size: var(--font-size-lg);
  font-weight: 600;
  line-height: 1.4;
}

.state-view__description {
  max-width: 480rpx;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

/* 操作按钮 */
.state-view__action {
  min-width: 176rpx;
  min-height: 80rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: var(--font-size-base);
  font-weight: 500;
  line-height: 80rpx;
}

/* 暗色主题 */
.state-view--dark .state-view__title {
  color: var(--text-inverse);
}

.state-view--dark .state-view__description {
  color: var(--text-tertiary);
}

.state-view--dark .state-view__spinner {
  border-color: rgba(255, 255, 255, 0.2);
  border-top-color: var(--brand-accent);
}

/* 错误态按钮 */
.state-view--error .state-view__action {
  background: var(--brand-emergency);
}

@keyframes state-view-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
