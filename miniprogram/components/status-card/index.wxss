/* status-card — 状态卡片 */
/* 带色彩背景（非白底）、无 shadow、靠背景色和边框区分 */

.status-card {
  border-radius: var(--radius-3xl);
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* --- 类型变体 --- */
.status-card--success {
  background: var(--color-success-light);
  color: var(--text-primary);
}

.status-card--warning {
  background: var(--color-warning-light);
  color: var(--text-primary);
}

.status-card--danger {
  background: var(--color-danger-light);
  color: var(--text-primary);
}

.status-card--info {
  background: var(--color-info-light);
  color: var(--text-primary);
}

/* --- 头部（图标 + 标题） --- */
.status-card__header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.status-card--success .status-card__icon { /* inherits card text color */ }

.status-card__title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: inherit;
}

/* --- 描述 --- */
.status-card__desc {
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--text-secondary);
  display: block;
}
