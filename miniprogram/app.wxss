/**app.wxss**/

/* ===================================
   宠脉AI - 全局样式 v2.0
   Global Styles — "Warm Professionalism"
   =================================== */

/* 引入设计系统 */
@import "utils/design-tokens.wxss";
@import "utils/ui-components.wxss";
@import "utils/responsive.wxss";
@import "styles/iconfont.wxss";

/* === 全局基础设置 === */

page {
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  font-family: var(--font-family-base);
  font-size: var(--font-size-base);
  font-weight: 400;
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  -webkit-font-smoothing: antialiased;
}

/* === 全局容器 === */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
}

/* === 全局按钮重置 === */

button {
  background: initial;
  border: none;
  outline: none;
}

button:focus {
  outline: none;
}

button::after {
  border: none;
}

/* === 全局元素盒模型 === */

view, text, image, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

/* === 全局链接样式 === */

.navigator {
  color: var(--brand-primary);
  text-decoration: none;
}

.navigator:active {
  opacity: 0.7;
}

/* === 全局图片样式 === */

image {
  max-width: 100%;
  height: auto;
  display: block;
}

/* === 全局滚动容器 === */

scroll-view {
  width: 100%;
  height: 100%;
}

/* === 全局焦点样式 === */

input:focus, textarea:focus, picker:focus {
  outline: none;
  border-color: var(--brand-primary);
}

/* === 全局禁用状态 === */

.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* === 全局加载遮罩 === */

.loading-global {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-modal);
}

/* === 全局Toast样式 === */

.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(45, 42, 38, 0.85);
  color: var(--text-inverse);
  padding: var(--spacing-lg) var(--spacing-2xl);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  z-index: var(--z-tooltip);
  max-width: 80%;
  text-align: center;
}

/* === 全局Modal遮罩 === */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: var(--z-modal-backdrop);
  display: flex;
  align-items: flex-end;
}

/* === 全局动画效果 === */

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* === 安全区域适配 === */

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* === 全局响应式 === */

@media (max-width: 375px) {
  page {
    font-size: var(--font-size-sm);
  }
  .container {
    padding: 0 var(--spacing-md);
  }
}

@media (min-width: 414px) {
  .container {
    padding: 0 var(--spacing-xl);
  }
}

/* === 全局性能优化 === */

.smooth-scroll {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.hardware-accelerated {
  transform: translateZ(0);
}

/* === 全局无障碍 === */

.screen-reader-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  padding: 0;
  margin: -1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}
